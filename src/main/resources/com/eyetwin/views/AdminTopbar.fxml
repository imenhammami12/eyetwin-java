<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eyetwin.controller.admin.AdminTopbarController"
      alignment="CENTER_LEFT" spacing="16" prefHeight="64"
      stylesheets="@../assets/css/admin-gaming.css"
      style="-fx-background-color: #0d0618;
             -fx-border-color: rgba(255,60,100,0.25);
             -fx-border-width: 0 0 1 0;
             -fx-padding: 0 24 0 24;
             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),20,0,0,2);">

    <!-- Left red accent bar matching Symfony ::before -->
    <Region prefWidth="4" prefHeight="24"
            style="-fx-background-color: linear-gradient(to bottom, #ff3c64, #764ba2);
                   -fx-background-radius: 2;"/>

    <!-- Page Title -->
    <Label fx:id="pageTitle" text="Dashboard" HBox.hgrow="ALWAYS"
           style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20;
                  -fx-padding: 0 0 0 10;"/>

    <!-- Spacer -->
    <Region HBox.hgrow="ALWAYS"/>

    <!-- Notification bell with red badge -->
    <StackPane prefWidth="40" prefHeight="40"
               style="-fx-background-color: rgba(255,255,255,0.04);
                      -fx-border-color: rgba(255,255,255,0.08);
                      -fx-border-radius: 10; -fx-background-radius: 10;
                      -fx-cursor: hand;">
        <Label text="🔔" style="-fx-font-size: 16;"/>
        <Label fx:id="notifBadge" text="1"
               style="-fx-background-color: #ff3c64;
                      -fx-text-fill: white; -fx-font-size: 9; -fx-font-weight: bold;
                      -fx-background-radius: 8; -fx-padding: 1 5;"
               StackPane.alignment="TOP_RIGHT"
               translateX="4" translateY="-4"/>
    </StackPane>

    <!-- Profile dropdown -->
    <MenuButton style="-fx-background-color: rgba(255,255,255,0.04);
                       -fx-border-color: rgba(255,255,255,0.10);
                       -fx-border-radius: 10; -fx-background-radius: 10;
                       -fx-border-width: 1; -fx-padding: 6 12 6 8;
                       -fx-mark-color: rgba(255,255,255,0.3); -fx-cursor: hand;">
        <graphic>
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="usernameLabel" text="Admin"
                       style="-fx-text-fill: rgba(255,255,255,0.75);
                              -fx-font-size: 13; -fx-font-weight: bold;"/>
                <StackPane prefWidth="36" prefHeight="36">
                    <!-- FIX: from 0% 0% to 100% 100% — replaces invalid to bottom right syntax -->
                    <StackPane style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #ff3c64, #ff1744);
                                      -fx-background-radius: 50;
                                      -fx-min-width: 36; -fx-min-height: 36;
                                      -fx-max-width: 36; -fx-max-height: 36;">
                        <Label fx:id="userAvatarInitial" text="A"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                    </StackPane>
                    <!-- Green online dot -->
                    <Region style="-fx-background-color: #43e97b;
                                   -fx-background-radius: 5;
                                   -fx-min-width: 10; -fx-min-height: 10;
                                   -fx-max-width: 10; -fx-max-height: 10;
                                   -fx-border-color: #0d0618; -fx-border-width: 2; -fx-border-radius: 5;"
                            StackPane.alignment="BOTTOM_RIGHT"/>
                </StackPane>
            </HBox>
        </graphic>
        <items>
            <MenuItem text="👤  My Profile" onAction="#goToProfile"/>
            <SeparatorMenuItem/>
            <MenuItem text="🚪  Logout"     onAction="#handleLogout"
                      style="-fx-text-fill: #ff3c64;"/>
        </items>
    </MenuButton>

</HBox>
