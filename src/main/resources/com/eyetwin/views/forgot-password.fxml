<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.eyetwin.controller.ForgotPasswordController"
           prefWidth="1280" prefHeight="800"
           style="-fx-background-color: #080810;">

    <!-- BACKGROUND -->
    <ImageView fitWidth="1280" fitHeight="800" preserveRatio="false" smooth="true">
        <image><Image url="@../assets/img/bg6.png"/></image>
    </ImageView>
    <Region style="-fx-background-color: rgba(0,0,0,0.58);"/>

    <!-- LAYOUT -->
    <VBox alignment="TOP_CENTER" prefWidth="1280" prefHeight="800">

        <!-- NAVBAR -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              prefHeight="52" minHeight="52" maxHeight="52"
              style="-fx-background-color: rgba(6,6,14,0.97);
                     -fx-border-color: rgba(220,20,60,0.18);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 30 0 30;">
            <ImageView fitHeight="32" preserveRatio="true">
                <image><Image url="@../assets/img/eyetwin-logo.png"/></image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- CONTENT -->
        <StackPane VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER" maxWidth="860" maxHeight="680"
                  style="-fx-background-color: #111;
                         -fx-background-radius: 14;
                         -fx-border-radius: 14;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.75),44,0,0,12);">

                <!-- LEFT IMAGE -->
                <StackPane prefWidth="375" prefHeight="620"
                           style="-fx-background-color: #0a0a0a;
                                  -fx-background-radius: 14 0 0 14;">
                    <ImageView fitWidth="375" fitHeight="620"
                               preserveRatio="false" smooth="true">
                        <image><Image url="@../assets/img/gaming-characters.png"/></image>
                    </ImageView>
                    <Region style="-fx-background-color:
                        linear-gradient(to right,rgba(100,0,0,0.2),rgba(0,0,0,0.52));
                        -fx-background-radius: 14 0 0 14;"/>

                    <!-- OVERLAY TEXT -->
                    <VBox alignment="BOTTOM_LEFT" style="-fx-padding: 28;">
                        <Label text="FORGOT YOUR"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:20;
                                      -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Label text="PASSWORD?"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:20;
                                      -fx-text-fill:#dc143c; -fx-font-weight:bold;"/>
                        <Label text="No worries — we've got you covered."
                               style="-fx-text-fill:#555; -fx-font-size:11; -fx-padding:4 0 0 0;"/>
                    </VBox>
                </StackPane>

                <!-- RIGHT FORM -->
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      prefWidth="485" prefHeight="620" spacing="0"
                      style="-fx-background-color: #090909;
                             -fx-background-radius: 0 14 14 0;
                             -fx-padding: 28 36 28 36;">

                    <!-- ICON + TITLE -->
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 20 0;">
                        <Label text="🔐"
                               style="-fx-font-size: 38;"/>
                        <Label text="RESET YOUR PASSWORD"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:14;
                                      -fx-font-weight:bold; -fx-text-fill:white;
                                      -fx-effect: dropshadow(gaussian,rgba(220,20,60,0.4),10,0,0,2);"/>
                        <Label text="ENTER YOUR EMAIL AND CHOOSE A DELIVERY METHOD"
                               style="-fx-text-fill: #3a3a3a; -fx-font-size: 9; -fx-font-weight:bold;"/>
                    </VBox>

                    <!-- SUCCESS LABEL -->
                    <Label fx:id="successLabel" text="" prefWidth="413" wrapText="true"
                           style="-fx-text-fill: #3fb950; -fx-font-size: 11;
                                  -fx-background-color: rgba(63,185,80,0.07);
                                  -fx-border-color: rgba(63,185,80,0.25); -fx-border-width:1;
                                  -fx-border-radius:6; -fx-background-radius:6;
                                  -fx-padding: 8 12 8 12; -fx-wrap-text: true;"/>

                    <!-- EMAIL -->
                    <VBox spacing="5" style="-fx-padding: 0 0 14 0;">
                        <Label text="EMAIL ADDRESS"
                               style="-fx-text-fill: #555; -fx-font-size: 9; -fx-font-weight:bold;"/>
                        <TextField fx:id="emailField" promptText="your@email.com"
                                   prefHeight="40" prefWidth="413"
                                   style="-fx-background-color: rgba(255,255,255,0.03);
                                          -fx-border-color: #8b0000; -fx-border-width: 1.5;
                                          -fx-border-radius: 5; -fx-background-radius: 5;
                                          -fx-text-fill: white; -fx-prompt-text-fill: #2e2e2e;
                                          -fx-font-size: 13; -fx-padding: 7 12 7 12;"/>
                    </VBox>

                    <!-- DELIVERY METHOD -->
                    <VBox spacing="7" style="-fx-padding: 0 0 14 0;">
                        <Label text="DELIVERY METHOD"
                               style="-fx-text-fill: #555; -fx-font-size: 9; -fx-font-weight:bold;"/>

                        <!-- Email channel row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" prefHeight="44" prefWidth="413"
                              style="-fx-background-color: rgba(255,255,255,0.04);
                                     -fx-border-color: rgba(255,255,255,0.1); -fx-border-width:1.5;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-padding: 0 14 0 14; -fx-cursor: hand;">
                            <RadioButton fx:id="channelEmail">
                                <toggleGroup><ToggleGroup fx:id="channelGroup"/></toggleGroup>
                            </RadioButton>
                            <Label text="📧" style="-fx-font-size:16;"/>
                            <Label text="WITH EMAIL"
                                   style="-fx-text-fill:#c0c5d0; -fx-font-size:12;
                                          -fx-font-weight:bold; -fx-letter-spacing:0.3em;"/>
                        </HBox>

                        <!-- SMS channel row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" prefHeight="44" prefWidth="413"
                              style="-fx-background-color: rgba(255,255,255,0.04);
                                     -fx-border-color: rgba(255,255,255,0.1); -fx-border-width:1.5;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-padding: 0 14 0 14; -fx-cursor: hand;">
                            <RadioButton fx:id="channelSms" toggleGroup="$channelGroup"/>
                            <Label text="📱" style="-fx-font-size:16;"/>
                            <Label text="WITH SMS"
                                   style="-fx-text-fill:#c0c5d0; -fx-font-size:12;
                                          -fx-font-weight:bold; -fx-letter-spacing:0.3em;"/>
                        </HBox>

                        <!-- Telegram channel row -->
                        <HBox alignment="CENTER_LEFT" spacing="12" prefHeight="44" prefWidth="413"
                              style="-fx-background-color: rgba(255,255,255,0.04);
                                     -fx-border-color: rgba(255,255,255,0.1); -fx-border-width:1.5;
                                     -fx-border-radius: 10; -fx-background-radius: 10;
                                     -fx-padding: 0 14 0 14; -fx-cursor: hand;">
                            <RadioButton fx:id="channelTelegram" toggleGroup="$channelGroup"/>
                            <Label text="✈️" style="-fx-font-size:16;"/>
                            <Label text="WITH TELEGRAM"
                                   style="-fx-text-fill:#c0c5d0; -fx-font-size:12;
                                          -fx-font-weight:bold; -fx-letter-spacing:0.3em;"/>
                        </HBox>
                    </VBox>

                    <!-- ERROR -->
                    <Label fx:id="errorLabel" text="" prefWidth="413" wrapText="true"
                           style="-fx-text-fill: #f85149; -fx-font-size: 11;
                                  -fx-padding: 0 0 8 0;"/>

                    <!-- SPINNER -->
                    <ProgressIndicator fx:id="loadingSpinner" prefWidth="28" prefHeight="28"
                                       style="-fx-progress-color: #dc143c;"
                                       visible="false"/>

                    <!-- SUBMIT -->
                    <Button fx:id="submitButton" text="->  SEND VERIFICATION CODE"
                            onAction="#handleSubmit"
                            prefWidth="413" prefHeight="42"
                            style="-fx-background-color: linear-gradient(to right,#b00020,#e8112d);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-font-size: 12; -fx-background-radius: 6; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian,rgba(192,18,48,0.5),14,0,0,3);"/>

                    <!-- SEPARATOR -->
                    <HBox alignment="CENTER" spacing="10" style="-fx-padding: 10 0 8 0;">
                        <Region HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #1a1a1a; -fx-pref-height: 1;"/>
                        <Label text="OR" style="-fx-text-fill: #282828; -fx-font-size: 10;"/>
                        <Region HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #1a1a1a; -fx-pref-height: 1;"/>
                    </HBox>

                    <!-- BACK TO LOGIN -->
                    <VBox alignment="CENTER" spacing="5">
                        <Label text="REMEMBER YOUR PASSWORD?"
                               style="-fx-text-fill: #3a3a3a; -fx-font-size: 9; -fx-font-weight:bold;"/>
                        <Button text="[ BACK TO LOGIN ]" onAction="#goToLogin"
                                prefWidth="413" prefHeight="38"
                                style="-fx-background-color: transparent;
                                       -fx-text-fill: #8b0000;
                                       -fx-border-color: #3a0000; -fx-border-width: 1.5;
                                       -fx-border-radius: 5; -fx-background-radius: 5;
                                       -fx-font-weight: bold; -fx-font-size: 12; -fx-cursor: hand;"/>
                    </VBox>

                </VBox>
            </HBox>
        </StackPane>
    </VBox>
</StackPane>
