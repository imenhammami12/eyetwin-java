<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>

<!--
    FaceRegister.fxml — Miroir de admin/profile/face_register.html.twig
    Route Symfony   : /admin/profile/face-register (name: app_profile_face_register)
    Controller Java : FaceRegisterController.java

    Correspondances HTML → FXML :
      #faceRegStatus          → statusBox + statusLabel
      #faceVideoContainer     → videoContainer
      #faceVideo              → cameraPreview (ImageView)
      #captureFaceBtn         → captureBtn
      lien "Cancel"           → cancelBtn
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.FaceRegisterController"
            style="-fx-background-color: #0d0618;"
            prefWidth="1280" prefHeight="800">

    <!-- ══════════════════════════════════════════════════
         SIDEBAR — identique à AdminProfile.fxml
    ══════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #0d0618;
                     -fx-border-color: rgba(255,60,100,0.15);
                     -fx-border-width: 0 1 0 0;">

            <VBox alignment="CENTER" style="-fx-padding: 20 20 16 20;
                                            -fx-border-color: transparent transparent rgba(255,60,100,0.12) transparent;
                                            -fx-border-width: 0 0 1 0;">
                <ImageView fitWidth="160" fitHeight="45" preserveRatio="true"
                           onMouseClicked="#goToDashboard" style="-fx-cursor: hand;">
                    <image><Image url="@../../assets/img/eyetwin-logo.png"/></image>
                </ImageView>
            </VBox>

            <VBox spacing="2" style="-fx-padding: 12 10 12 10;" VBox.vgrow="ALWAYS">
                <Button text="⚡  Dashboard"          onAction="#goToDashboard"         maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="👥  Users"              onAction="#goToUsers"             maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="📅  Planning"           onAction="#goToPlanning"          maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="🏆  Tournaments"        onAction="#goToTournaments"       maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="🎬  Videos"             onAction="#goToVideos"            maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="✅  Coach Applications" onAction="#goToCoachApplications" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="💬  Channels"           onAction="#goToChannels"          maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="🎧  Complaints"         onAction="#goToComplaints"        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="📨  Messages"           onAction="#goToMessages"          maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button text="🔲  Teams"              onAction="#goToTeams"             maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
                <Button fx:id="navAuditLogs" text="📋  Audit Logs" onAction="#goToAuditLogs"
                        maxWidth="Infinity" visible="false" managed="false"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <Region style="-fx-background-color: rgba(255,255,255,0.07);
                               -fx-pref-height: 1; -fx-max-height: 1;"/>

                <!-- Face Register — actif -->
                <Button text="📷  Face Registration" onAction="#goToFaceRegister" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,60,100,0.12);
                               -fx-border-color: rgba(255,60,100,0.35);
                               -fx-border-radius: 10; -fx-background-radius: 10;
                               -fx-border-width: 1; -fx-text-fill: white;
                               -fx-font-size: 12; -fx-font-weight: bold;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand;"/>

                <Button text="🌐  View Site ↗" onAction="#goToSite" maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 9 14 9 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
            </VBox>

            <Button text="🚪  Logout" onAction="#handleLogout" maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,60,100,0.08);
                           -fx-border-color: rgba(255,60,100,0.2);
                           -fx-border-width: 1 0 0 0; -fx-text-fill: rgba(255,255,255,0.5);
                           -fx-font-size: 12; -fx-alignment: CENTER_LEFT;
                           -fx-padding: 16 20 16 20; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════
         TOPBAR
    ══════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" prefHeight="64"
              style="-fx-background-color: #0d0618;
                     -fx-border-color: rgba(255,60,100,0.25);
                     -fx-border-width: 0 0 1 0; -fx-padding: 0 24 0 24;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),20,0,0,2);">
            <Label fx:id="pageTitle" text="Facial Registration" HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17;
                          -fx-padding: 0 0 0 14;"/>
            <MenuButton style="-fx-background-color: transparent;
                               -fx-border-color: rgba(255,255,255,0.1);
                               -fx-border-radius: 10; -fx-background-radius: 10;
                               -fx-border-width: 1; -fx-padding: 6 12 6 8;
                               -fx-mark-color: rgba(255,255,255,0.3); -fx-cursor: hand;">
                <graphic>
                    <HBox alignment="CENTER" spacing="8">
                        <Label fx:id="usernameLabel" text="Admin"
                               style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12;"/>
                        <StackPane style="-fx-background-color: linear-gradient(135deg,#ff3c64,#ff1744);
                                          -fx-background-radius: 50;
                                          -fx-min-width: 34; -fx-min-height: 34;
                                          -fx-max-width: 34; -fx-max-height: 34;">
                            <Label fx:id="userAvatarInitial" text="A"
                                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                        </StackPane>
                    </HBox>
                </graphic>
                <items>
                    <MenuItem text="👤  My Profile"       onAction="#goToProfile"/>
                    <MenuItem text="📷  Face Recognition" onAction="#goToFaceRegister"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="🚪  Logout"           onAction="#handleLogout"
                              style="-fx-text-fill: #ff3c64;"/>
                </items>
            </MenuButton>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════
         MAIN — miroir de .face-reg-container
    ══════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #0d0618; -fx-background: #0d0618;
                           -fx-border-color: transparent;">
            <VBox alignment="CENTER" spacing="0"
                  style="-fx-padding: 40 80 40 80; -fx-background-color: #0d0618;">

                <!-- Carte principale — miroir de .face-reg-card -->
                <VBox spacing="20"
                      style="-fx-background-color: rgba(30,15,45,0.8);
                             -fx-border-color: rgba(255,255,255,0.1);
                             -fx-border-radius: 20; -fx-background-radius: 20;
                             -fx-border-width: 1; -fx-padding: 40;
                             -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),60,0,0,0);">

                    <!-- En-tête — miroir de .face-reg-header -->
                    <VBox alignment="CENTER" spacing="10">
                        <Label text="📷  Facial Registration"
                               style="-fx-text-fill: white; -fx-font-weight: bold;
                                      -fx-font-size: 26;"/>
                        <Label text="Position your face in the frame and click &quot;Capture&quot; to enable face login"
                               style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13;"/>
                    </VBox>

                    <!-- STATUS BAR — miroir de #faceRegStatus -->
                    <VBox fx:id="statusBox"
                          style="-fx-background-color: rgba(33,150,243,0.15);
                                 -fx-border-color: rgba(33,150,243,0.3);
                                 -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-border-width: 1; -fx-padding: 14 18 14 18;">
                        <Label fx:id="statusLabel" text="⏳  Initializing camera..."
                               style="-fx-text-fill: #64b5f6; -fx-font-size: 13;"/>
                    </VBox>

                    <!-- VIDEO CONTAINER — miroir de #faceVideoContainer -->
                    <VBox fx:id="videoContainer" visible="false"
                          style="-fx-background-color: #000;
                                 -fx-background-radius: 16; -fx-border-radius: 16;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.5),30,0,0,0);">
                        <!-- ImageView remplace <video> — alimenté par FaceAuthService -->
                        <ImageView fx:id="cameraPreview"
                                   fitWidth="560" fitHeight="400"
                                   preserveRatio="true"
                                   style="-fx-background-radius: 16;"/>
                    </VBox>

                    <!-- CONTROLS — miroir de .face-controls -->
                    <HBox alignment="CENTER" spacing="16">
                        <!-- Capture — miroir de #captureFaceBtn (disabled="true" → activé après init) -->
                        <Button fx:id="captureBtn"
                                text="📸  Capture my face"
                                onAction="#handleCapture"
                                disable="true"
                                style="-fx-background-color: linear-gradient(135deg,#ff3c64,#ff1744);
                                       -fx-text-fill: white; -fx-font-weight: bold;
                                       -fx-font-size: 14; -fx-background-radius: 10;
                                       -fx-padding: 14 28 14 28; -fx-cursor: hand;
                                       -fx-effect: dropshadow(gaussian,rgba(255,60,100,0.4),20,0,0,0);"/>

                        <!-- Cancel — miroir du lien Cancel → path('app_profile') -->
                        <Button fx:id="cancelBtn"
                                text="✕  Cancel"
                                onAction="#handleCancel"
                                style="-fx-background-color: rgba(255,255,255,0.08);
                                       -fx-border-color: rgba(255,255,255,0.2);
                                       -fx-border-radius: 10; -fx-background-radius: 10;
                                       -fx-border-width: 1; -fx-text-fill: rgba(255,255,255,0.8);
                                       -fx-font-size: 14; -fx-padding: 14 28 14 28;
                                       -fx-cursor: hand;"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
