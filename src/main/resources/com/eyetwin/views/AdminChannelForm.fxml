<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminChannelFormController"
            prefWidth="760"
            prefHeight="560"
            style="-fx-background-color: #0a0514;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: linear-gradient(to right, rgba(35,8,54,0.98), rgba(18,6,34,0.98));
                     -fx-border-color: rgba(255,60,100,0.35);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 28 30 24 30;">
            <children>
                <Label fx:id="lblTitle"
                       text="Create Channel"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" />

                <Label text="Fill in the details to create or update a community channel."
                       style="-fx-text-fill: rgba(255,255,255,0.60); -fx-font-size: 13px;" />
            </children>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    fitToHeight="false"
                    pannable="true"
                    style="-fx-background-color: transparent;
                           -fx-background: transparent;
                           -fx-border-color: transparent;">
            <content>
                <VBox spacing="18" style="-fx-padding: 24 30 24 30;">

                    <!-- Main form card -->
                    <VBox spacing="16"
                          style="-fx-background-color: rgba(255,255,255,0.02);
                                 -fx-border-color: rgba(255,255,255,0.07);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 12;
                                 -fx-background-radius: 12;
                                 -fx-padding: 20;">

                        <Label text="Channel Information"
                               style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />

                        <HBox spacing="20">
                            <children>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Name *"
                                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <TextField fx:id="tfName"
                                                   promptText="e.g. Tips &amp; Tricks"
                                                   style="-fx-background-color: rgba(30,15,45,0.95);
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.35);
                                                          -fx-border-color: rgba(255,60,100,0.30);
                                                          -fx-border-radius: 10;
                                                          -fx-background-radius: 10;
                                                          -fx-padding: 10 14;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Game *"
                                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <TextField fx:id="tfGame"
                                                   promptText="e.g. Valorant"
                                                   style="-fx-background-color: rgba(30,15,45,0.95);
                                                          -fx-text-fill: white;
                                                          -fx-prompt-text-fill: rgba(255,255,255,0.35);
                                                          -fx-border-color: rgba(255,60,100,0.30);
                                                          -fx-border-radius: 10;
                                                          -fx-background-radius: 10;
                                                          -fx-padding: 10 14;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="8">
                            <children>
                                <Label text="Description"
                                       style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                <TextArea fx:id="taDescription"
                                          prefRowCount="7"
                                          wrapText="true"
                                          promptText="Write a short channel description..."
                                          style="-fx-control-inner-background: rgba(16,24,52,0.95);
                                                 -fx-background-color: rgba(16,24,52,0.95);
                                                 -fx-text-fill: white;
                                                 -fx-prompt-text-fill: rgba(255,255,255,0.35);
                                                 -fx-border-color: rgba(255,60,100,0.20);
                                                 -fx-border-radius: 10;
                                                 -fx-background-radius: 10;
                                                 -fx-padding: 12 14;" />
                            </children>
                        </VBox>

                        <HBox spacing="20">
                            <children>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Type *"
                                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <ComboBox fx:id="cbType"
                                                  prefWidth="220"
                                                  style="-fx-background-color: rgba(30,15,45,0.95);
                                                         -fx-border-color: rgba(255,60,100,0.30);
                                                         -fx-border-radius: 10;
                                                         -fx-background-radius: 10;
                                                         -fx-text-fill: white;" />
                                    </children>
                                </VBox>

                                <VBox spacing="8" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label text="Channel Status"
                                               style="-fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;" />
                                        <CheckBox fx:id="chkActive"
                                                  text="Channel is active"
                                                  style="-fx-text-fill: white; -fx-font-size: 13px;" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <Label fx:id="lblError"
                               text=""
                               wrapText="true"
                               style="-fx-text-fill: #ff6b6b; -fx-font-size: 12px;" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_LEFT"
              style="-fx-padding: 18 30 20 30;
                     -fx-background-color: rgba(8,4,18,0.96);
                     -fx-border-color: rgba(255,255,255,0.06);
                     -fx-border-width: 1 0 0 0;">
            <children>
                <Button fx:id="btnSave"
                        text="Save Channel"
                        onAction="#handleSave"
                        style="-fx-background-color: linear-gradient(to right, #ff3c64, #c0132f);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 12 24;
                               -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(255,60,100,0.45), 14, 0, 0, 4);" />

                <Button text="Cancel"
                        onAction="#handleCancel"
                        style="-fx-background-color: rgba(255,255,255,0.04);
                               -fx-border-color: rgba(255,255,255,0.14);
                               -fx-border-radius: 10;
                               -fx-background-radius: 10;
                               -fx-text-fill: rgba(255,255,255,0.75);
                               -fx-font-weight: bold;
                               -fx-padding: 12 22;
                               -fx-cursor: hand;" />
            </children>
        </HBox>
    </bottom>
</BorderPane>
