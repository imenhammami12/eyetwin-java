<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    CoachApplication.fxml
    Mirrors: coach/application.html.twig  +  UserController#applyCoach()
    Controller: com.eyetwin.controller.CoachApplicationController

    Steps:
      01 — Certifications & Qualifications  (min 50 chars)
      02 — Coaching Experience              (min 100 chars)
      03 — CV / Portfolio upload            (optional, PDF/DOC/DOCX, max 5 MB)
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.CoachApplicationController"
            stylesheets="@../styles/gaming.css"
            style="-fx-background-color: #06050f;"
            prefWidth="1280" prefHeight="800">

    <!-- ══════════════════════════════════════════════════
         NAVBAR
    ══════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="0"
              style="-fx-background-color: rgba(8,8,16,0.97);
                     -fx-border-color: rgba(232,55,42,0.15);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 24; -fx-pref-height: 64;">

            <ImageView fitHeight="38" preserveRatio="true" pickOnBounds="true"
                       onMouseClicked="#goHome" style="-fx-cursor: hand;">
                <image><Image url="@../assets/img/eyetwin-logo.png"/></image>
            </ImageView>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="8">
                <HBox alignment="CENTER" spacing="6"
                      style="-fx-background-color: linear-gradient(90deg,#f6d860,#f6ad55);
                             -fx-background-radius: 20; -fx-padding: 5 13; -fx-cursor: hand;">
                    <Label text="🪙" style="-fx-font-size: 11;"/>
                    <Label fx:id="coinsNavLabel" text="0"
                           style="-fx-font-weight: bold; -fx-font-size: 11; -fx-text-fill: #1a1a2e;"/>
                </HBox>

                <MenuButton fx:id="navProfileMenu"
                            style="-fx-background-color: rgba(255,255,255,0.03);
                                   -fx-border-color: rgba(232,55,42,0.18);
                                   -fx-border-radius: 50; -fx-background-radius: 50;
                                   -fx-padding: 4 12 4 4;
                                   -fx-mark-color: rgba(255,255,255,0.3); -fx-cursor: hand;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="7">
                            <StackPane style="-fx-background-color: linear-gradient(to bottom right,#b02b20,#ff4d3d);
                                              -fx-background-radius: 50;
                                              -fx-min-width: 28; -fx-min-height: 28;
                                              -fx-max-width: 28; -fx-max-height: 28;">
                                <Label fx:id="navAvatarInitial" text="A"
                                       style="-fx-text-fill: white; -fx-font-weight:900; -fx-font-size:12;"/>
                            </StackPane>
                            <Label fx:id="navUsername" text="PLAYER"
                                   style="-fx-text-fill: white; -fx-font-weight:bold; -fx-font-size:10;"/>
                        </HBox>
                    </graphic>
                    <items>
                        <MenuItem text="👤  My Profile"  onAction="#goToProfile"     style="-fx-font-size:11;"/>
                        <MenuItem text="✏  Edit Profile" onAction="#goToEditProfile"  style="-fx-font-size:11;"/>
                        <SeparatorMenuItem/>
                        <MenuItem text="🚪  Logout" onAction="#handleLogout"
                                  style="-fx-font-size:11; -fx-text-fill:#ff4d3d;"/>
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <!-- ══ CONTENT ══ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox style="-fx-background-color: #06050f;">

                <!-- ── PAGE HERO ── -->
                <VBox style="-fx-padding: 36 80 28 80;
                             -fx-background-color: linear-gradient(160deg,#1a0505 0%,#0d0d0f 60%);
                             -fx-border-color: rgba(232,55,42,0.2);
                             -fx-border-width: 0 0 1 0;">
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="🎓" style="-fx-font-size: 13;"/>
                        <Label text="COACHING"
                               style="-fx-background-color: rgba(232,55,42,0.12);
                                      -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                      -fx-border-radius: 4; -fx-background-radius: 4;
                                      -fx-text-fill: #e8372a; -fx-font-size: 10;
                                      -fx-font-weight: bold; -fx-padding: 3 8;"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 8 0 6 0;">
                        <Label text="Become a "
                               style="-fx-text-fill: white; -fx-font-family: 'Arial Black';
                                      -fx-font-size: 28; -fx-font-weight: bold;"/>
                        <Label text="Coach"
                               style="-fx-text-fill: #e8372a; -fx-font-family: 'Arial Black';
                                      -fx-font-size: 28; -fx-font-weight: bold;"/>
                    </HBox>
                    <Label text="Share your passion and expertise with the gaming community."
                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12;"/>
                </VBox>

                <!-- ── FLASH MESSAGES ── -->
                <VBox fx:id="flashErrorBox" visible="false" managed="false"
                      style="-fx-padding: 12 80 0 80;">
                    <HBox spacing="10" alignment="CENTER_LEFT"
                          style="-fx-background-color: rgba(232,55,42,0.1);
                                 -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                 -fx-border-radius: 8; -fx-background-radius: 8;
                                 -fx-padding: 12 16;">
                        <Label text="⚠" style="-fx-font-size: 14; -fx-text-fill: #e8372a;"/>
                        <Label fx:id="flashErrorLabel" text=""
                               style="-fx-text-fill: rgba(255,255,255,0.8); -fx-font-size: 12;"
                               wrapText="true"/>
                    </HBox>
                </VBox>

                <!-- ── MAIN LAYOUT: SIDEBAR + FORM ── -->
                <HBox spacing="24" style="-fx-padding: 28 80 48 80;" alignment="TOP_LEFT">

                    <!-- ════ SIDEBAR ════ -->
                    <VBox spacing="16" style="-fx-min-width: 280; -fx-pref-width: 280; -fx-max-width: 280;">

                        <!-- Benefits Card -->
                        <VBox style="-fx-background-color: rgba(255,255,255,0.03);
                                     -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 20 22;">

                            <HBox spacing="12" alignment="CENTER_LEFT" style="-fx-padding: 0 0 16 0;">
                                <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                  -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                                  -fx-min-width: 36; -fx-min-height: 36;
                                                  -fx-max-width: 36; -fx-max-height: 36;">
                                    <Label text="★" style="-fx-text-fill: #e8372a; -fx-font-size: 13;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Coach Benefits"
                                           style="-fx-text-fill: rgba(255,255,255,0.9);
                                                  -fx-font-weight: bold; -fx-font-size: 13;"/>
                                    <Label text="What you'll unlock"
                                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="10">
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                      -fx-border-color: rgba(232,55,42,0.2); -fx-border-width: 1;
                                                      -fx-background-radius: 7; -fx-border-radius: 7;
                                                      -fx-min-width: 30; -fx-min-height: 30;
                                                      -fx-max-width: 30; -fx-max-height: 30;">
                                        <Label text="🏆" style="-fx-font-size: 11;"/>
                                    </StackPane>
                                    <Label text="Exclusive Coach badge"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                      -fx-border-color: rgba(232,55,42,0.2); -fx-border-width: 1;
                                                      -fx-background-radius: 7; -fx-border-radius: 7;
                                                      -fx-min-width: 30; -fx-min-height: 30;
                                                      -fx-max-width: 30; -fx-max-height: 30;">
                                        <Label text="👥" style="-fx-font-size: 11;"/>
                                    </StackPane>
                                    <Label text="Premium team access"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                      -fx-border-color: rgba(232,55,42,0.2); -fx-border-width: 1;
                                                      -fx-background-radius: 7; -fx-border-radius: 7;
                                                      -fx-min-width: 30; -fx-min-height: 30;
                                                      -fx-max-width: 30; -fx-max-height: 30;">
                                        <Label text="📈" style="-fx-font-size: 11;"/>
                                    </StackPane>
                                    <Label text="Advanced analytics tools"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                      -fx-border-color: rgba(232,55,42,0.2); -fx-border-width: 1;
                                                      -fx-background-radius: 7; -fx-border-radius: 7;
                                                      -fx-min-width: 30; -fx-min-height: 30;
                                                      -fx-max-width: 30; -fx-max-height: 30;">
                                        <Label text="💰" style="-fx-font-size: 11;"/>
                                    </StackPane>
                                    <Label text="Revenue opportunities"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                                </HBox>
                                <HBox spacing="12" alignment="CENTER_LEFT">
                                    <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                      -fx-border-color: rgba(232,55,42,0.2); -fx-border-width: 1;
                                                      -fx-background-radius: 7; -fx-border-radius: 7;
                                                      -fx-min-width: 30; -fx-min-height: 30;
                                                      -fx-max-width: 30; -fx-max-height: 30;">
                                        <Label text="🌐" style="-fx-font-size: 11;"/>
                                    </StackPane>
                                    <Label text="Coach network access"
                                           style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                    </VBox>

                    <!-- ════ FORM COLUMN ════ -->
                    <VBox HBox.hgrow="ALWAYS" spacing="16">

                        <!-- ── STEP 01 : Certifications ── -->
                        <VBox style="-fx-background-color: rgba(255,255,255,0.03);
                                     -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 22 26;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                  -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                                  -fx-min-width: 36; -fx-min-height: 36;
                                                  -fx-max-width: 36; -fx-max-height: 36;">
                                    <Label text="01" style="-fx-text-fill: #e8372a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Certifications &amp; Qualifications"
                                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold; -fx-font-size: 13;"/>
                                    <Label text="Ranks, titles, certifications, achievements"
                                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="6" style="-fx-padding: 16 0 0 0;">
                                <Label text="CERTIFICATIONS"
                                       style="-fx-text-fill: rgba(232,55,42,0.8); -fx-font-size: 10;
                                              -fx-font-weight: bold;"/>
                                <TextArea fx:id="certificationsField"
                                          promptText="..."
                                          prefRowCount="5" wrapText="true"
                                          style="-fx-control-inner-background: #0d0c1a;
                 -fx-background-color: rgba(255,255,255,0.03);
                 -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 1;
                 -fx-border-radius: 9; -fx-background-radius: 9;
                 -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12;
                 -fx-padding: 10 12;
                 -fx-prompt-text-fill: rgba(255,255,255,0.25);"/>

                                <Label fx:id="certErrorLabel" text="" visible="false" managed="false"
                                       style="-fx-text-fill: #ff6b5b; -fx-font-size: 11;" wrapText="true"/>
                                <HBox alignment="CENTER_LEFT">
                                    <HBox spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                        <Label text="💡" style="-fx-font-size: 11;"/>
                                        <Label text="Mention your ranks, certifications, tournament participations, major achievements"
                                               style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;" wrapText="true"/>
                                    </HBox>
                                    <Label fx:id="certCounter" text="0 / 50 min"
                                           style="-fx-text-fill: #f44a40; -fx-font-size: 11; -fx-font-weight: bold;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── STEP 02 : Experience ── -->
                        <VBox style="-fx-background-color: rgba(255,255,255,0.03);
                                     -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 22 26;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                  -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                                  -fx-min-width: 36; -fx-min-height: 36;
                                                  -fx-max-width: 36; -fx-max-height: 36;">
                                    <Label text="02" style="-fx-text-fill: #e8372a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <Label text="Coaching Experience"
                                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold; -fx-font-size: 13;"/>
                                    <Label text="Background, methodology, concrete results"
                                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="6" style="-fx-padding: 16 0 0 0;">
                                <Label text="EXPERIENCE"
                                       style="-fx-text-fill: rgba(232,55,42,0.8); -fx-font-size: 10; -fx-font-weight: bold;"/>
                                <TextArea fx:id="experienceField"
                                          promptText="..."
                                          prefRowCount="6" wrapText="true"
                                          style="-fx-control-inner-background: #0d0c1a;
                 -fx-background-color: rgba(255,255,255,0.03);
                 -fx-border-color: rgba(255,255,255,0.08); -fx-border-width: 1;
                 -fx-border-radius: 9; -fx-background-radius: 9;
                 -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 12;
                 -fx-padding: 10 12;
                 -fx-prompt-text-fill: rgba(255,255,255,0.25);"/>
                                <Label fx:id="expErrorLabel" text="" visible="false" managed="false"
                                       style="-fx-text-fill: #ff6b5b; -fx-font-size: 11;" wrapText="true"/>
                                <HBox alignment="CENTER_LEFT">
                                    <HBox spacing="6" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                                        <Label text="💡" style="-fx-font-size: 11;"/>
                                        <Label text="Detail your background, methodology, concrete results, gaming specialties"
                                               style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;" wrapText="true"/>
                                    </HBox>
                                    <Label fx:id="expCounter" text="0 / 100 min"
                                           style="-fx-text-fill: #f44a40; -fx-font-size: 11; -fx-font-weight: bold;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── STEP 03 : CV Upload ── -->
                        <VBox style="-fx-background-color: rgba(255,255,255,0.03);
                                     -fx-border-color: rgba(255,255,255,0.07); -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 22 26;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-color: rgba(232,55,42,0.12);
                                                  -fx-border-color: rgba(232,55,42,0.35); -fx-border-width: 1;
                                                  -fx-background-radius: 8; -fx-border-radius: 8;
                                                  -fx-min-width: 36; -fx-min-height: 36;
                                                  -fx-max-width: 36; -fx-max-height: 36;">
                                    <Label text="03" style="-fx-text-fill: #e8372a; -fx-font-size: 10; -fx-font-weight: bold;"/>
                                </StackPane>
                                <VBox spacing="2">
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label text="CV / Portfolio"
                                               style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-weight: bold; -fx-font-size: 13;"/>
                                        <Label text="Optional"
                                               style="-fx-background-color: rgba(255,255,255,0.06);
                                                      -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;
                                                      -fx-border-radius: 20; -fx-background-radius: 20;
                                                      -fx-text-fill: rgba(255,255,255,0.4);
                                                      -fx-font-size: 9; -fx-font-weight: bold; -fx-padding: 2 8;"/>
                                    </HBox>
                                    <Label text="PDF or Word — max 5 MB"
                                           style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8" style="-fx-padding: 16 0 0 0;">
                                <!-- Drop zone -->
                                <VBox fx:id="dropZone" alignment="CENTER" spacing="6"
                                      onMouseClicked="#handlePickCv"
                                      style="-fx-background-color: rgba(255,255,255,0.02);
                                             -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;
                                             -fx-border-style: dashed;
                                             -fx-border-radius: 10; -fx-background-radius: 10;
                                             -fx-padding: 28 20; -fx-cursor: hand;">
                                    <Label text="⬆" style="-fx-font-size: 28; -fx-text-fill: rgba(255,255,255,0.2);"/>
                                    <Label text="Drop file here or browse"
                                           style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12;"/>
                                    <Label text="PDF · DOC · DOCX"
                                           style="-fx-text-fill: rgba(255,255,255,0.28); -fx-font-size: 11;"/>
                                </VBox>

                                <!-- File preview (hidden until file selected) -->
                                <HBox fx:id="filePreview" visible="false" managed="false"
                                      spacing="10" alignment="CENTER_LEFT"
                                      style="-fx-background-color: rgba(232,55,42,0.08);
                                             -fx-border-color: rgba(232,55,42,0.25); -fx-border-width: 1;
                                             -fx-border-radius: 8; -fx-background-radius: 8;
                                             -fx-padding: 10 14;">
                                    <Label text="📄" style="-fx-font-size: 16; -fx-text-fill: #e8372a;"/>
                                    <Label fx:id="cvFileName" text=""
                                           style="-fx-text-fill: rgba(255,255,255,0.75); -fx-font-size: 12;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="✕" onAction="#handleRemoveCv"
                                            style="-fx-background-color: transparent; -fx-border-width: 0;
                                                   -fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 14;
                                                   -fx-cursor: hand; -fx-padding: 0 4;"/>
                                </HBox>

                                <Label fx:id="cvErrorLabel" text="" visible="false" managed="false"
                                       style="-fx-text-fill: #ff6b5b; -fx-font-size: 11;" wrapText="true"/>

                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label text="ℹ" style="-fx-font-size: 11; -fx-text-fill: rgba(232,55,42,0.6);"/>
                                    <Label text="Increase your chances by adding your CV with your gaming and coaching experience"
                                           style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;" wrapText="true"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- ── Warning ── -->
                        <HBox spacing="14" alignment="TOP_LEFT"
                              style="-fx-background-color: rgba(255,193,7,0.07);
                                     -fx-border-color: rgba(255,193,7,0.2); -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 16 20;">
                            <Label text="⚠" style="-fx-font-size: 18; -fx-text-fill: #ffc107;"/>
                            <VBox spacing="4">
                                <Label text="Heads up"
                                       style="-fx-text-fill: #ffc107; -fx-font-weight: bold; -fx-font-size: 12;"/>
                                <Label text="Once submitted, you will not be able to modify your application. Please verify all information before submitting."
                                       style="-fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 11;" wrapText="true"/>
                            </VBox>
                        </HBox>

                        <!-- ── Actions ── -->
                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <Button text="←  Cancel" onAction="#goToProfile"
                                    style="-fx-background-color: rgba(255,255,255,0.04);
                                           -fx-border-color: rgba(255,255,255,0.1); -fx-border-width: 1;
                                           -fx-border-radius: 9; -fx-background-radius: 9;
                                           -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                                           -fx-padding: 10 20; -fx-cursor: hand;"/>
                            <Button fx:id="submitBtn" text="✈  Submit Application"
                                    onAction="#handleSubmit"
                                    style="-fx-background-color: #e8372a;
               -fx-border-width: 0;
               -fx-border-radius: 9;
               -fx-background-radius: 9;
               -fx-text-fill: white;
               -fx-font-size: 13;
               -fx-font-weight: bold;
               -fx-font-family: 'Arial Black';
               -fx-padding: 11 28;
               -fx-cursor: hand;
               -fx-effect: dropshadow(gaussian,rgba(232,55,42,0.45),18,0,0,4);"/>

                        </HBox>

                    </VBox>
                </HBox>

                <!-- ── FOOTER ── -->
                <HBox alignment="CENTER_LEFT"
                      style="-fx-background-color: #0d0c1a;
                             -fx-border-color: rgba(232,55,42,0.12); -fx-border-width: 1 0 0 0;
                             -fx-padding: 16 40;">
                    <Label text="EYETWIN"
                           style="-fx-text-fill: #ff4d3d; -fx-font-weight:bold;
                                  -fx-font-size:12; -fx-font-family:'Arial Black';"/>
                    <Label text="  ·  Copyright © 2025 — All Rights Reserved"
