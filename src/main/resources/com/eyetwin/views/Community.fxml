                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-background-color: rgba(232,55,42,0.09);
                                             -fx-border-color: rgba(232,55,42,0.28);
                                             -fx-border-width:1;
                                             -fx-border-radius:3;
                                             -fx-background-radius:3;
                                             -fx-padding: 4 12 4 12;
                                             -fx-max-width:230;">
                                    <children>
                                        <Label text="●"
                                               style="-fx-text-fill: #3dff8a; -fx-font-size:8;" />
                                        <Label text="💬 Community Channels"
                                               style="-fx-text-fill: #ff4d3d; -fx-font-size:10; -fx-font-weight:bold;" />
                                    </children>
                                </HBox>

                                <HBox alignment="TOP_LEFT">
                                    <children>
                                        <VBox spacing="10" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label fx:id="lblPageTitle"
                                                       text="Channels"
                                                       style="-fx-font-family: 'Arial Black';
                                                              -fx-font-size: 38;
                                                              -fx-font-weight: bold;
                                                              -fx-text-fill: #e8372a;
                                                              -fx-effect: dropshadow(gaussian, rgba(232,55,42,0.50), 28, 0, 0, 0);" />

                                                <Label text="Join the community, create your own channel, and connect with other players."
                                                       style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size:13;" />
                                            </children>
                                        </VBox>

                                        <Pane HBox.hgrow="ALWAYS" />

                                        <Button fx:id="btnNewChannel"
                                                text="⚡  New Channel"
                                                onAction="#handleShowCreateForm"
                                                style="-fx-background-color: linear-gradient(to right, #ff416c, #ff5a36);
                                                       -fx-text-fill: white;
                                                       -fx-font-weight: bold;
                                                       -fx-background-radius: 10;
                                                       -fx-padding: 12 22 12 22;
                                                       -fx-cursor: hand;" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </StackPane>

