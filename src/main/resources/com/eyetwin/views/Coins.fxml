<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<!--
  Coins.fxml — Vue d'achat de coins EyeTwin
  Miroir de templates/coins/index.html.twig (Symfony)
  Contrôleur : com.eyetwin.controller.CoinsController
-->
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eyetwin.controller.CoinsController"
      style="-fx-background-color: #08080f;"
      spacing="0">

    <!-- ══ NAVBAR ══ -->
    <fx:include source="navbar.fxml"/>

    <!-- ══ CONTENU PRINCIPAL ══ -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;"
                VBox.vgrow="ALWAYS">
        <VBox spacing="30" style="-fx-padding: 40 60 60 60; -fx-background-color: #08080f;">

            <!-- ── Flash Message ── -->
            <VBox fx:id="flashBox" visible="false" managed="false"
                  style="-fx-background-color: rgba(72,187,120,0.15);
                         -fx-border-color: #48bb78; -fx-border-width: 0 0 0 4;
                         -fx-background-radius: 8; -fx-padding: 12 16 12 16;">
                <Label fx:id="flashLabel" text=""
                       style="-fx-text-fill: white; -fx-font-size: 13;"/>
            </VBox>

            <!-- ── Titre ── -->
            <VBox alignment="CENTER" spacing="12">
                <Label text="💰 BUY EYETWIN COINS"
                       style="-fx-font-size: 28; -fx-font-weight: 900; -fx-text-fill: white;
                              -fx-effect: dropshadow(gaussian, rgba(232,55,42,0.4), 20, 0, 0, 0);"/>
                <Label text="Use coins to access exclusive coaching live streams"
                       style="-fx-font-size: 14; -fx-text-fill: #a0a0b0;"/>

                <!-- Balance pill -->
                <VBox alignment="CENTER"
                      style="-fx-background-color: linear-gradient(135deg,#1a1a2e,#16213e);
                             -fx-border-color: #4a4a6a; -fx-border-radius: 12;
                             -fx-background-radius: 12; -fx-padding: 12 30 12 30;">
                    <Label text="YOUR BALANCE"
                           style="-fx-font-size: 11; -fx-text-fill: #888;
                                  -fx-letter-spacing: 1; -fx-text-transform: uppercase;"/>
                    <Label fx:id="balanceLabel" text="🪙 0 coins"
                           style="-fx-font-size: 26; -fx-font-weight: bold; -fx-text-fill: #f6d860;"/>
                </VBox>
            </VBox>

            <!-- ── Cartes de packages (générées par le contrôleur) ── -->
            <HBox fx:id="packagesContainer" alignment="CENTER" spacing="20"/>

            <!-- ── Sécurité Stripe ── -->
            <HBox spacing="20" alignment="CENTER_LEFT"
                  style="-fx-background-color: rgba(102,126,234,0.08);
                         -fx-border-color: #3a3a5a; -fx-border-width: 1;
                         -fx-border-radius: 12; -fx-background-radius: 12;
                         -fx-padding: 20;">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label text="🛡  Secure Payments powered by Stripe"
                           style="-fx-font-size: 14; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="All transactions are encrypted and processed securely. We never store your card details. Coins are credited instantly after payment."
                           style="-fx-font-size: 12; -fx-text-fill: #a0a0b0;" wrapText="true"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Accepted payments"
                           style="-fx-font-size: 11; -fx-text-fill: #888;"/>
                    <Label text="💳 VISA  •  MC  •  AMEX"
                           style="-fx-font-size: 13; -fx-text-fill: #a0a0b0;"/>
                </VBox>
            </HBox>

            <!-- ── Historique des achats ── -->
            <VBox spacing="12">
                <Label text="📋 Purchase History"
                       style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <VBox fx:id="historyContainer" spacing="8"/>
            </VBox>

            <!-- ── Retour profil ── -->
            <HBox alignment="CENTER">
                <Button text="← Back to Profile" onAction="#goToProfile"
                        style="-fx-background-color: transparent; -fx-text-fill: #667eea;
                               -fx-font-size: 13; -fx-cursor: hand;
                               -fx-border-color: transparent;"/>
            </HBox>

        </VBox>
    </ScrollPane>
</VBox>
