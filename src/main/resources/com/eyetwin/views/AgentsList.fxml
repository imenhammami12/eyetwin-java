<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.AgentsListController"
            stylesheets="@../styles/gaming.css"
            style="-fx-background-color: #0a0e27;"
            prefWidth="1280" prefHeight="800">

    <top>
        <fx:include source="navbar.fxml" fx:id="navbar"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color:#0a0e27; -fx-background:#0a0e27; -fx-border-color:transparent;">
            <VBox spacing="0" style="-fx-background-color: #0a0e27;">

                <!-- HEADER -->
                <VBox style="-fx-background-color: linear-gradient(135deg,rgba(255,0,0,0.05),rgba(76,211,227,0.05));
                             -fx-border-color: rgba(255,0,0,0.3) transparent transparent transparent;
                             -fx-border-width: 2 0 0 6; -fx-border-radius: 14; -fx-background-radius: 14;
                             -fx-padding: 40 40 40 40;">
                    <VBox.margin><Insets top="30" right="30" bottom="0" left="30"/></VBox.margin>
                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Label text="▶" style="-fx-text-fill:#ff0000; -fx-font-size:44;"/>
                        <Label fx:id="gameTitleLabel" text="Game"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:48; -fx-font-weight:bold;
                                      -fx-text-fill: white;"/>
                    </HBox>
                    <Label text="Sélectionne un agent pour découvrir les meilleures techniques et stratégies au combat."
                           style="-fx-text-fill: #aeb8c9; -fx-font-size:15; -fx-padding:8 0 0 0;"/>
                </VBox>

                <!-- STATS -->
                <HBox spacing="16" style="-fx-padding:24 30 8 30;">
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,0,0,0.08); -fx-border-color:rgba(255,0,0,0.2);
                                 -fx-border-width:1; -fx-border-radius:16; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Agents" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:11; -fx-font-weight:bold;"/>
                        <Label fx:id="agentsTotalLabel" text="0"
                               style="-fx-text-fill:#ff0000; -fx-font-size:28; -fx-font-weight:bold;"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="5" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(76,211,227,0.08); -fx-border-color:rgba(76,211,227,0.2);
                                 -fx-border-width:1; -fx-border-radius:16; -fx-background-radius:16; -fx-padding:20;">
                        <Label text="Visible" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:11; -fx-font-weight:bold;"/>
                        <Label fx:id="agentsVisibleLabel" text="0"
                               style="-fx-text-fill:#4cd3e3; -fx-font-size:28; -fx-font-weight:bold;"/>
                    </VBox>
                </HBox>

                <!-- SEARCH + BACK -->
                <HBox spacing="14" alignment="CENTER_LEFT" style="-fx-padding:10 30 6 30;">
                    <TextField fx:id="searchField" promptText="Rechercher un agent..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:rgba(255,255,255,0.03);
                                      -fx-border-color:rgba(76,211,227,0.3); -fx-border-width:1;
                                      -fx-border-radius:12; -fx-background-radius:12;
                                      -fx-padding:14 20 14 20; -fx-text-fill:white; -fx-font-size:14;
                                      -fx-prompt-text-fill:rgba(255,255,255,0.3);"/>
                    <Button text="← Retour aux Jeux" onAction="#goBack"
                            style="-fx-background-color:rgba(76,211,227,0.1); -fx-border-color:rgba(76,211,227,0.3);
                                   -fx-border-width:2; -fx-border-radius:10; -fx-background-radius:10;
                                   -fx-text-fill:#4cd3e3; -fx-font-weight:bold; -fx-padding:12 20 12 20; -fx-cursor:hand;"/>
                </HBox>
                <Label fx:id="resultsNote" text="0 agent(s)"
                       style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:13; -fx-padding:2 30 10 30;"/>

                <!-- AGENTS LIST -->
                <VBox fx:id="agentsList" spacing="12" style="-fx-padding:0 30 50 30;"/>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
