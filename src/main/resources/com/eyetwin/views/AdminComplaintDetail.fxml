<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminComplaintController"
            style="-fx-background-color: #0a0514;">

    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #0a0514;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:transparent;-fx-background:transparent;">
                <VBox spacing="16" style="-fx-padding:24;">

                    <!-- Back button -->
                    <Button text="← Back to Complaints" onAction="#goBackToList"
                            style="-fx-background-color:rgba(255,255,255,0.05);
                                   -fx-border-color:rgba(255,255,255,0.15);-fx-border-radius:8;
                                   -fx-background-radius:8;-fx-text-fill:rgba(255,255,255,0.7);
                                   -fx-padding:8 16;-fx-cursor:hand;"/>

                    <HBox spacing="16" alignment="TOP_LEFT">

                        <!-- ════ LEFT COLUMN ════ -->
                        <VBox spacing="16" HBox.hgrow="ALWAYS">

                            <!-- Header card -->
                            <VBox spacing="12"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:14;-fx-background-radius:14;
                                         -fx-padding:24;">
                                <Label fx:id="detailSubjectLabel" text="—"
                                       wrapText="true"
                                       style="-fx-font-size:20;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <HBox spacing="8">
                                    <Label fx:id="detailStatusBadge"   text="PENDING"/>
                                    <Label fx:id="detailPriorityBadge" text="MEDIUM"/>
                                    <Label fx:id="detailCategoryBadge" text="OTHER"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="detailIdLabel" text="Complaint #—"
                                           style="-fx-text-fill:rgba(255,255,255,0.35);-fx-font-size:12;"/>
                                </HBox>
                            </VBox>

                            <!-- Description -->
                            <VBox spacing="8"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:20;">
                                <Label text="📄 Description"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Separator style="-fx-background-color:rgba(255,255,255,0.08);"/>
                                <Label fx:id="detailDescriptionLabel" text="—"
                                       wrapText="true"
                                       style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:13;"/>
                            </VBox>

                            <!-- Admin Response (shown if exists) -->
                            <VBox fx:id="adminResponseBox" spacing="8" visible="false" managed="false"
                                  style="-fx-background-color:rgba(79,172,254,0.06);
                                         -fx-border-color:rgba(79,172,254,0.25);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:20;">
                                <Label text="↩ Admin Response"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#4facfe;"/>
                                <Label fx:id="detailAdminResponseLabel" text="—"
                                       wrapText="true"
                                       style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;"/>
                            </VBox>

                            <!-- Resolution Notes (shown if resolved) -->
                            <VBox fx:id="resolutionNotesBox" spacing="8" visible="false" managed="false"
                                  style="-fx-background-color:rgba(67,233,123,0.06);
                                         -fx-border-color:rgba(67,233,123,0.25);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:20;">
                                <Label text="✓ Resolution Notes"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                                <Label fx:id="detailResolutionNotesLabel" text="—"
                                       wrapText="true"
                                       style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;"/>
                            </VBox>

                            <!-- Attachment badge -->
                            <VBox fx:id="attachmentBox" spacing="8" visible="false" managed="false"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:16;">
                                <Label text="📎 Attachment"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="File attached to this complaint"
                                       style="-fx-text-fill:#4facfe;-fx-font-size:12;"/>
                            </VBox>

                            <!-- ── Respond Form (hidden when resolved) ── -->
                            <VBox fx:id="responseFormBox" spacing="10"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:20;">
                                <Label text="↩ Add Response"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <TextArea fx:id="responseTextArea"
                                          promptText="Type your response to the user..."
                                          prefRowCount="4" wrapText="true"
                                          style="-fx-background-color:rgba(30,15,45,0.95);
                                                 -fx-text-fill:white;
                                                 -fx-prompt-text-fill:rgba(255,255,255,0.35);
                                                 -fx-border-color:rgba(102,126,234,0.3);
                                                 -fx-border-radius:10;-fx-background-radius:10;
                                                 -fx-padding:12;"/>
                                <Button text="📤  Send Response" onAction="#handleRespond"
                                        style="-fx-background-color:linear-gradient(to right,#667eea,#764ba2);
                                               -fx-text-fill:white;-fx-font-weight:bold;
                                               -fx-background-radius:8;-fx-border-color:transparent;
                                               -fx-padding:10 20;-fx-cursor:hand;"/>
                            </VBox>

                            <!-- ── Resolve Form (hidden when resolved) ── -->
                            <VBox fx:id="resolveFormBox" spacing="10"
                                  style="-fx-background-color:rgba(67,233,123,0.04);
                                         -fx-border-color:rgba(67,233,123,0.20);
                                         -fx-border-radius:12;-fx-background-radius:12;
                                         -fx-padding:20;">
                                <Label text="✓ Resolve Complaint"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                                <TextArea fx:id="resolutionTextArea"
                                          promptText="Describe how this complaint was resolved..."
                                          prefRowCount="3" wrapText="true"
                                          style="-fx-background-color:rgba(30,15,45,0.95);
                                                 -fx-text-fill:white;
                                                 -fx-prompt-text-fill:rgba(255,255,255,0.35);
                                                 -fx-border-color:rgba(67,233,123,0.3);
                                                 -fx-border-radius:10;-fx-background-radius:10;
                                                 -fx-padding:12;"/>
                                <Button text="✓  Mark as Resolved" onAction="#handleResolve"
                                        style="-fx-background-color:rgba(67,233,123,0.12);
                                               -fx-border-color:rgba(67,233,123,0.4);
                                               -fx-border-radius:8;-fx-background-radius:8;
                                               -fx-text-fill:#43e97b;-fx-font-weight:bold;
                                               -fx-padding:10 20;-fx-cursor:hand;"/>
                            </VBox>

                        </VBox>

                        <!-- ════ RIGHT SIDEBAR ════ -->
                        <VBox spacing="14" prefWidth="300">

                            <!-- Info Card -->
                            <VBox spacing="0"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:14;-fx-background-radius:14;
                                         -fx-padding:20;">
                                <Label text="ℹ Information"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;-fx-padding:0 0 12 0;"/>

                                <!-- Submitted By -->
                                <VBox spacing="2" style="-fx-padding:8 0;-fx-border-color:transparent transparent rgba(255,255,255,0.05) transparent;-fx-border-width:0 0 1 0;">
                                    <Label text="Submitted By"
                                           style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:11;"/>
                                    <Label fx:id="infoSubmittedBy" text="—"
                                           style="-fx-text-fill:#43e97b;-fx-font-weight:bold;-fx-font-size:13;"/>
                                </VBox>
                                <!-- Assigned To -->
                                <VBox spacing="2" style="-fx-padding:8 0;-fx-border-color:transparent transparent rgba(255,255,255,0.05) transparent;-fx-border-width:0 0 1 0;">
                                    <Label text="Assigned To"
                                           style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:11;"/>
                                    <Label fx:id="infoAssignedTo" text="Not assigned"
                                           style="-fx-text-fill:#4facfe;-fx-font-weight:bold;-fx-font-size:13;"/>
                                </VBox>
                                <!-- Created -->
                                <VBox spacing="2" style="-fx-padding:8 0;-fx-border-color:transparent transparent rgba(255,255,255,0.05) transparent;-fx-border-width:0 0 1 0;">
                                    <Label text="Created"
                                           style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:11;"/>
                                    <Label fx:id="infoCreatedAt" text="—"
                                           style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:12;"/>
                                </VBox>
                                <!-- Updated -->
                                <VBox spacing="2" style="-fx-padding:8 0;-fx-border-color:transparent transparent rgba(255,255,255,0.05) transparent;-fx-border-width:0 0 1 0;">
                                    <Label text="Last Updated"
                                           style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:11;"/>
                                    <Label fx:id="infoUpdatedAt" text="—"
                                           style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:12;"/>
                                </VBox>
                                <!-- Resolved -->
                                <VBox spacing="2" style="-fx-padding:8 0;">
                                    <Label text="Resolved At"
                                           style="-fx-text-fill:rgba(255,255,255,0.45);-fx-font-size:11;"/>
                                    <Label fx:id="infoResolvedAt" text="—"
                                           style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:12;"/>
                                </VBox>
                            </VBox>

                            <!-- ── Sentiment Analysis Card ── -->
                            <VBox spacing="10"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:14;-fx-background-radius:14;
                                         -fx-padding:20;">
                                <Label text="😐 Sentiment Analysis"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>

                                <!-- No sentiment placeholder -->
                                <Label fx:id="noSentimentLabel" text="No sentiment data available."
                                       style="-fx-text-fill:rgba(255,255,255,0.35);-fx-font-size:12;"/>

                                <!-- Sentiment data (hidden if no analysis) -->
                                <VBox fx:id="sentimentBox" spacing="8" visible="false" managed="false">
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label fx:id="sentimentEmoji" text="😐"
                                               style="-fx-font-size:28;"/>
                                        <VBox spacing="4">
                                            <Label fx:id="sentimentBadge" text="Neutral"/>
                                            <Label fx:id="sentimentSourceLabel" text=""
                                                   style="-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>

                                    <!-- Confidence bar -->
                                    <VBox spacing="4">
                                        <HBox alignment="CENTER_LEFT">
                                            <Label text="Confidence"
                                                   style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:11;"/>
                                            <Region HBox.hgrow="ALWAYS"/>
                                            <Label fx:id="sentimentConfidencePct" text="0%"
                                                   style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:11;-fx-font-weight:bold;"/>
                                        </HBox>
                                        <ProgressBar fx:id="sentimentConfidenceBar" progress="0"
                                                     maxWidth="Infinity" prefHeight="6"
                                                     styleClass="progress-green"/>
                                    </VBox>

                                    <!-- Priority suggestion alert -->
                                    <VBox fx:id="sentimentSuggestionBox" spacing="4"
                                          visible="false" managed="false"
                                          style="-fx-background-color:rgba(255,193,7,0.10);
                                                 -fx-border-color:rgba(255,193,7,0.30);
                                                 -fx-border-radius:8;-fx-background-radius:8;
                                                 -fx-padding:10;">
                                        <Label text="⚡ Sentiment suggested priority:"
                                               style="-fx-text-fill:#ffd54f;-fx-font-size:11;"/>
                                        <Label fx:id="sentimentSuggestionLabel" text=""
                                               style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <!-- ── Admin Actions Card ── -->
                            <VBox spacing="12"
                                  style="-fx-background-color:rgba(255,255,255,0.02);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:14;-fx-background-radius:14;
                                         -fx-padding:20;">
                                <Label text="⚙ Actions"
                                       style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>

                                <!-- Assign -->
                                <VBox spacing="6">
                                    <Label text="Assign to Admin:"
                                           style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <HBox spacing="8">
                                        <ComboBox fx:id="assignAdminCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                  style="-fx-background-color:rgba(30,15,45,0.95);
                                                         -fx-border-color:rgba(102,126,234,0.3);
                                                         -fx-border-radius:8;-fx-background-radius:8;"/>
                                        <Button text="Assign" onAction="#handleAssign"
                                                style="-fx-background-color:rgba(102,126,234,0.15);
                                                       -fx-border-color:rgba(102,126,234,0.4);
                                                       -fx-border-radius:8;-fx-background-radius:8;
                                                       -fx-text-fill:#667eea;-fx-font-weight:bold;
                                                       -fx-padding:8 14;-fx-cursor:hand;"/>
                                    </HBox>
                                </VBox>

                                <!-- Change Status -->
                                <VBox spacing="6">
                                    <Label text="Change Status:"
                                           style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <HBox spacing="8">
                                        <ComboBox fx:id="changeStatusCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                  style="-fx-background-color:rgba(30,15,45,0.95);
                                                         -fx-border-color:rgba(102,126,234,0.3);
                                                         -fx-border-radius:8;-fx-background-radius:8;"/>
                                        <Button text="Update" onAction="#handleUpdateStatus"
                                                style="-fx-background-color:rgba(102,126,234,0.15);
                                                       -fx-border-color:rgba(102,126,234,0.4);
                                                       -fx-border-radius:8;-fx-background-radius:8;
                                                       -fx-text-fill:#667eea;-fx-font-weight:bold;
                                                       -fx-padding:8 14;-fx-cursor:hand;"/>
                                    </HBox>
                                </VBox>

                                <!-- Change Priority -->
                                <VBox spacing="6">
                                    <Label text="Change Priority:"
                                           style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <HBox spacing="8">
                                        <ComboBox fx:id="changePriorityCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                                  style="-fx-background-color:rgba(30,15,45,0.95);
                                                         -fx-border-color:rgba(102,126,234,0.3);
                                                         -fx-border-radius:8;-fx-background-radius:8;"/>
                                        <Button text="Update" onAction="#handleUpdatePriority"
                                                style="-fx-background-color:rgba(102,126,234,0.15);
                                                       -fx-border-color:rgba(102,126,234,0.4);
                                                       -fx-border-radius:8;-fx-background-radius:8;
                                                       -fx-text-fill:#667eea;-fx-font-weight:bold;
                                                       -fx-padding:8 14;-fx-cursor:hand;"/>
                                    </HBox>
                                </VBox>

                                <Separator style="-fx-background-color:rgba(255,255,255,0.08);"/>

                                <!-- Delete -->
                                <Button text="🗑  Delete Complaint" onAction="#handleDelete"
                                        maxWidth="Infinity"
                                        style="-fx-background-color:rgba(140,20,40,0.08);
                                               -fx-border-color:rgba(180,40,60,0.3);
                                               -fx-border-radius:8;-fx-background-radius:8;
                                               -fx-text-fill:rgba(255,107,122,0.75);
                                               -fx-font-weight:bold;-fx-padding:10;-fx-cursor:hand;"/>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
