<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminUserController"
            style="-fx-background-color: #0a0514;">

    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #0a0514;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 24;">

                    <!-- Back button -->
                    <Button text="← Back to List" onAction="#goBackToList"
                            style="-fx-background-color: rgba(255,255,255,0.05);
                                   -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 8;
                                   -fx-background-radius: 8; -fx-text-fill: rgba(255,255,255,0.7);
                                   -fx-padding: 8 16; -fx-cursor: hand;"/>

                    <!-- Permission banners -->
                    <VBox fx:id="limitedPermBanner" spacing="4" visible="false" managed="false"
                          style="-fx-background-color: rgba(255,193,7,0.1);
                                 -fx-border-color: rgba(255,193,7,0.3); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-padding: 12 16;">
                        <Label text="⚠  Limited Permissions: Only Super Admins can modify other Admins."
                               style="-fx-text-fill: #ffd54f; -fx-font-size: 12;" wrapText="true"/>
                    </VBox>
                    <VBox fx:id="selfViewBanner" spacing="4" visible="false" managed="false"
                          style="-fx-background-color: rgba(79,172,254,0.1);
                                 -fx-border-color: rgba(79,172,254,0.3); -fx-border-radius: 10;
                                 -fx-background-radius: 10; -fx-padding: 12 16;">
                        <Label text="ℹ  You are viewing your own profile. Self-modification is disabled."
                               style="-fx-text-fill: #4facfe; -fx-font-size: 12;" wrapText="true"/>
                    </VBox>

                    <!-- Main body -->
                    <HBox spacing="16" alignment="TOP_LEFT">

                        <!-- LEFT — Profile card -->
                        <VBox spacing="14" prefWidth="300"
                              style="-fx-background-color: rgba(255,255,255,0.02);
                                     -fx-border-color: rgba(255,255,255,0.07);
                                     -fx-border-radius: 14; -fx-background-radius: 14;
                                     -fx-padding: 24; -fx-alignment: CENTER;">

                            <!-- Avatar -->
                            <StackPane prefWidth="110" prefHeight="110" alignment="CENTER">
                                <Circle radius="55"
                                        fill="linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2)"/>
                                <Label fx:id="avatarInitialLabel" text="??"
                                       style="-fx-font-size: 36; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            </StackPane>

                            <!-- Name + You badge -->
                            <HBox alignment="CENTER" spacing="8">
                                <Label fx:id="fullNameHeaderLabel" text="—"
                                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                <Label fx:id="youBadgeLabel" text="You" visible="false" managed="false"
                                       style="-fx-background-color: #4facfe; -fx-text-fill: white;
                                              -fx-background-radius: 6; -fx-font-size: 10; -fx-padding: 3 8;"/>
                            </HBox>
                            <Label fx:id="usernameHeaderLabel" text="@—"
                                   style="-fx-font-size: 13; -fx-text-fill: rgba(255,255,255,0.5);"/>

                            <!-- Role + status chips -->
                            <HBox alignment="CENTER" spacing="8">
                                <Label fx:id="roleChipLabel" text="User"
                                       style="-fx-background-color: rgba(79,172,254,0.15);
                                              -fx-border-color: rgba(79,172,254,0.3);
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-text-fill: #4facfe; -fx-font-size: 11; -fx-padding: 5 12;"/>
                                <Label fx:id="statusChipLabel" text="ACTIVE"
                                       style="-fx-background-color: rgba(67,233,123,0.15);
                                              -fx-border-color: rgba(67,233,123,0.3);
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-text-fill: #43e97b; -fx-font-size: 11; -fx-padding: 5 12;"/>
                            </HBox>

                            <!-- Bio -->
                            <VBox fx:id="bioBox" spacing="6" visible="false" managed="false"
                                  style="-fx-background-color: rgba(255,255,255,0.03);
                                         -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                                <Label text="BIO"
                                       style="-fx-text-fill: rgba(255,255,255,0.35);
                                              -fx-font-size: 9; -fx-font-family: monospace;"/>
                                <Label fx:id="bioLabel" text="" wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                            </VBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                            <!-- Role form -->
                            <VBox spacing="8" fillWidth="true">
                                <Label text="CHANGE ROLE"
                                       style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);
                                              -fx-font-family: monospace;"/>
                                <ComboBox fx:id="roleComboBox" maxWidth="Infinity"
                                          style="-fx-background-color: rgba(255,255,255,0.06);"/>
                                <Button fx:id="updateRoleBtn" text="💾  Update Role"
                                        onAction="#handleUpdateRole" maxWidth="Infinity"
                                        style="-fx-background-color: linear-gradient(to right,#667eea,#764ba2);
                                               -fx-text-fill: white; -fx-background-radius: 8;
                                               -fx-padding: 10; -fx-cursor: hand; -fx-font-weight: bold;"/>
                                <Label fx:id="rolePermNote" text="" visible="false" managed="false"
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                            </VBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                            <!-- Status alert -->
                            <VBox fx:id="statusAlertBox" spacing="4" visible="false" managed="false"
                                  style="-fx-background-color: rgba(255,107,107,0.1);
                                         -fx-border-color: rgba(255,107,107,0.3);
                                         -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 12;">
                                <Label fx:id="statusAlertLabel" text="" wrapText="true"
                                       style="-fx-text-fill: #ff6b7a; -fx-font-size: 12;"/>
                            </VBox>

                            <!-- Action buttons -->
                            <VBox spacing="8" fillWidth="true">
                                <Button fx:id="suspendBtn" text="⚠  Suspend User"
                                        onAction="#handleSuspend" maxWidth="Infinity"
                                        style="-fx-background-color: rgba(255,171,0,0.08);
                                               -fx-border-color: rgba(255,171,0,0.35); -fx-border-radius: 8;
                                               -fx-background-radius: 8; -fx-text-fill: #ffb700;
                                               -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
                                <Button fx:id="banBtn" text="✕  Ban User"
                                        onAction="#handleBan" maxWidth="Infinity"
                                        style="-fx-background-color: rgba(255,60,100,0.08);
                                               -fx-border-color: rgba(255,60,100,0.35); -fx-border-radius: 8;
                                               -fx-background-radius: 8; -fx-text-fill: #ff6b7a;
                                               -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
                                <Button fx:id="reactivateBtn" text="✓  Reactivate User"
                                        onAction="#handleReactivate" maxWidth="Infinity"
                                        visible="false" managed="false"
                                        style="-fx-background-color: rgba(67,233,123,0.08);
                                               -fx-border-color: rgba(67,233,123,0.35); -fx-border-radius: 8;
                                               -fx-background-radius: 8; -fx-text-fill: #43e97b;
                                               -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
                                <Button fx:id="deleteBtn" text="🗑  Delete User"
                                        onAction="#handleDeleteUser" maxWidth="Infinity"
                                        style="-fx-background-color: rgba(140,20,40,0.08);
                                               -fx-border-color: rgba(180,40,60,0.3); -fx-border-radius: 8;
                                               -fx-background-radius: 8;
                                               -fx-text-fill: rgba(255,107,122,0.65);
                                               -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
                                <Label fx:id="actionPermNote" text="" visible="false" managed="false"
                                       wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;"/>
                            </VBox>

                        </VBox>

                        <!-- RIGHT — Details -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS">

                            <!-- Personal Information -->
                            <VBox spacing="0"
                                  style="-fx-background-color: rgba(255,255,255,0.02);
                                         -fx-border-color: rgba(255,255,255,0.07);
                                         -fx-border-radius: 14; -fx-background-radius: 14;">
                                <Label text="ℹ  Personal Information"
                                       style="-fx-font-size: 13; -fx-font-weight: bold;
                                              -fx-text-fill: white; -fx-padding: 14 16;"/>
                                <Separator style="-fx-background-color: rgba(255,255,255,0.07);"/>
                                <GridPane hgap="24" vgap="16" style="-fx-padding: 20;">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    </columnConstraints>
                                    <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="EMAIL" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <Label fx:id="emailInfoLabel" text="—" style="-fx-text-fill: #4facfe; -fx-font-size: 13;"/>
                                    </VBox>
                                    <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="USERNAME" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <Label fx:id="usernameInfoLabel" text="—" style="-fx-text-fill: #43e97b; -fx-font-size: 13;"/>
                                    </VBox>
                                    <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                        <Label text="FULL NAME" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <Label fx:id="fullNameInfoLabel" text="—" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                                    </VBox>
                                    <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                        <Label text="REGISTERED" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <HBox spacing="8" alignment="CENTER_LEFT">
                                            <Label fx:id="registeredLabel" text="—" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                                            <Label fx:id="registeredAgoLabel" text="" style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 11;"/>
                                        </HBox>
                                    </VBox>
                                    <VBox spacing="3" GridPane.columnIndex="0" GridPane.rowIndex="2">
                                        <Label text="LAST LOGIN" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <Label fx:id="lastLoginLabel" text="—" style="-fx-text-fill: white; -fx-font-size: 13;"/>
                                    </VBox>
                                    <VBox spacing="3" GridPane.columnIndex="1" GridPane.rowIndex="2">
                                        <Label text="ACCOUNT STATUS" style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                                        <Label fx:id="statusInfoLabel" text="ACTIVE"
                                               style="-fx-background-color: rgba(67,233,123,0.15);
                                                      -fx-border-color: rgba(67,233,123,0.35);
                                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                                      -fx-text-fill: #43e97b; -fx-font-size: 11;
                                                      -fx-font-weight: bold; -fx-padding: 5 10;"/>
                                    </VBox>
                                </GridPane>
                            </VBox>

                            <!-- Teams -->
                            <VBox spacing="0"
                                  style="-fx-background-color: rgba(255,255,255,0.02);
                                         -fx-border-color: rgba(255,255,255,0.07);
                                         -fx-border-radius: 14; -fx-background-radius: 14;">
                                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 14 16;">
                                    <Label text="⬛  Teams"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label fx:id="teamsBadge" text="0"
                                           style="-fx-background-color: #667eea; -fx-text-fill: white;
                                                  -fx-background-radius: 10; -fx-font-size: 10; -fx-padding: 2 8;"/>
                                </HBox>
                                <Separator style="-fx-background-color: rgba(255,255,255,0.07);"/>
                                <VBox fx:id="teamsEmptyState" alignment="CENTER" spacing="8"
                                      style="-fx-padding: 36;">
                                    <Label text="⬛" style="-fx-font-size: 40; -fx-opacity: 0.12;"/>
                                    <Label text="No teams yet"
                                           style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 14;"/>
                                    <Label text="This user hasn't joined any team yet."
                                           style="-fx-text-fill: rgba(255,255,255,0.3); -fx-font-size: 12;"/>
                                </VBox>
                                <TableView fx:id="teamsTable" visible="false" managed="false"
                                           style="-fx-background-color: transparent; -fx-border-color: transparent;">
                                    <columns>
                                        <TableColumn text="Team"   prefWidth="200"/>
                                        <TableColumn text="Role"   prefWidth="120"/>
                                        <TableColumn text="Status" prefWidth="110"/>
                                        <TableColumn text="Joined" prefWidth="130"/>
                                    </columns>
                                </TableView>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
