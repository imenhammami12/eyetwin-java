<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.CommunityChatController"
            style="-fx-background-color: #080810;">

    <top>
        <VBox spacing="0" style="-fx-background-color: #080810;">
            <children>
                <fx:include source="navbar.fxml" />

                <StackPane prefHeight="170" style="-fx-background-color: #080810;">
                    <Region style="-fx-background-color: rgba(8,8,16,0.96);" />

                    <VBox alignment="CENTER_LEFT"
                          spacing="10"
                          style="-fx-padding: 26 36 0 36;">
                        <children>
                            <HBox alignment="CENTER_LEFT"
                                  spacing="8"
                                  style="-fx-background-color: rgba(232,55,42,0.09);
                                         -fx-border-color: rgba(232,55,42,0.28);
                                         -fx-border-width: 1;
                                         -fx-border-radius: 3;
                                         -fx-background-radius: 3;
                                         -fx-padding: 4 12 4 12;
                                         -fx-max-width: 220;">
                                <children>
                                    <Label text="●"
                                           style="-fx-text-fill: #3dff8a; -fx-font-size: 8;" />
                                    <Label text="💬 Channel Chat"
                                           style="-fx-text-fill: #ff4d3d; -fx-font-size: 10; -fx-font-weight: bold;" />
                                </children>
                            </HBox>

                            <HBox alignment="CENTER_LEFT">
                                <children>
                                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                                        <children>
                                            <Label fx:id="lblChannelName"
                                                   text="Channel Name"
                                                   style="-fx-font-family: 'Arial Black';
                                                          -fx-font-size: 30;
                                                          -fx-font-weight: bold;
                                                          -fx-text-fill: #e8372a;
                                                          -fx-effect: dropshadow(gaussian, rgba(232,55,42,0.50), 24, 0, 0, 0);" />

                                            <Label fx:id="lblChannelDescription"
                                                   text="Channel description"
                                                   wrapText="true"
                                                   style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 13;" />
                                        </children>
                                    </VBox>

                                    <Pane HBox.hgrow="ALWAYS" />

                                    <VBox alignment="CENTER_RIGHT" spacing="10">
                                        <children>
                                            <Label fx:id="lblChannelStatus" text="APPROVED" />
                                            <Button text="← Back to Channels"
                                                    onAction="#handleBack"
                                                    style="-fx-background-color: rgba(255,255,255,0.06);
                                                           -fx-border-color: rgba(255,255,255,0.12);
                                                           -fx-border-radius: 9;
                                                           -fx-background-radius: 9;
                                                           -fx-text-fill: white;
                                                           -fx-font-weight: bold;
                                                           -fx-padding: 10 18 10 18;
                                                           -fx-cursor: hand;" />
                                        </children>
                                    </VBox>
                                </children>
                            </HBox>
                        </children>
                    </VBox>
                </StackPane>

                <Region style="-fx-background-color: rgba(232,55,42,0.16);
                               -fx-pref-height: 1;
                               -fx-max-height: 1;" />
            </children>
        </VBox>
    </top>

    <center>
        <VBox spacing="16"
              style="-fx-background-color: #080810; -fx-padding: 24 36 24 36;">
            <children>
                <VBox fx:id="summaryBannerBox"
                      spacing="8"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(232,55,42,0.10);
             -fx-border-color: rgba(232,55,42,0.28);
             -fx-border-radius: 14;
             -fx-background-radius: 14;
             -fx-padding: 14;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <children>
                                <Label fx:id="lblMissedMessages"
                                       text="You missed 0 messages"
                                       style="-fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" />

                                <Pane HBox.hgrow="ALWAYS" />

                                <Button fx:id="btnSummarizeMissed"
                                        text="Summarize"
                                        onAction="#handleSummarizeMissedMessages"
                                        style="-fx-background-color: linear-gradient(to right, #ff416c, #ff5a36);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 10;
                               -fx-padding: 8 18 8 18;
                               -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Label fx:id="lblSummaryLoading"
                               text="Generating summary..."
                               visible="false"
                               managed="false"
                               style="-fx-text-fill: rgba(255,255,255,0.70); -fx-font-size: 12px;" />
                    </children>
                </VBox>

                <VBox fx:id="summaryCardBox"
                      spacing="10"
                      visible="false"
                      managed="false"
                      style="-fx-background-color: rgba(255,255,255,0.03);
             -fx-border-color: rgba(255,255,255,0.08);
             -fx-border-radius: 14;
             -fx-background-radius: 14;
             -fx-padding: 16;">
                    <children>
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Label fx:id="lblSummaryTitle"
                                       text="Summary"
                                       style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" />

                                <Pane HBox.hgrow="ALWAYS" />

                                <Button text="Hide"
                                        onAction="#handleHideSummary"
                                        style="-fx-background-color: rgba(255,255,255,0.08);
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;
                               -fx-padding: 6 14 6 14;
                               -fx-cursor: hand;" />
                            </children>
                        </HBox>

                        <Label fx:id="lblSummaryOverview"
                               wrapText="true"
                               style="-fx-text-fill: rgba(255,255,255,0.86); -fx-font-size: 13px;" />

                        <VBox fx:id="summaryKeyPointsBox" spacing="4" />
                        <VBox fx:id="summaryActionItemsBox" spacing="4" />
                        <VBox fx:id="summaryOpenQuestionsBox" spacing="4" />
                    </children>
                </VBox>
                <ScrollPane fx:id="messagesScrollPane"
                            fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent;
                   -fx-background: transparent;
                   -fx-border-color: transparent;">
                    <content>
                        <VBox fx:id="messagesContainer"
                              spacing="10"
                              style="-fx-background-color: transparent;">
                            <padding>
                                <Insets top="4" right="0" bottom="8" left="0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>

                <Label fx:id="lblComposerInfo"
                       text=""
                       wrapText="true"
                       visible="false"
                       managed="false"
                       style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12px;" />

                <VBox fx:id="composerBox"
                      spacing="10"
                      style="-fx-background-color: rgba(6,5,16,0.88);
                             -fx-border-color: rgba(255,255,255,0.065);
                             -fx-border-radius: 14;
                             -fx-background-radius: 14;
                             -fx-padding: 16;">
                    <children>
                        <TextArea fx:id="taNewMessage"
                                  promptText="Type your message here..."
                                  prefRowCount="3"
                                  wrapText="true"
                                  style="-fx-control-inner-background: #14192b;
                                         -fx-background-color: #14192b;
                                         -fx-text-fill: white;
                                         -fx-prompt-text-fill: #9CA3AF;
                                         -fx-highlight-fill: rgba(232,55,42,0.35);
                                         -fx-highlight-text-fill: white;
                                         -fx-background-radius: 12;
                                         -fx-border-radius: 12;
                                         -fx-border-color: rgba(255,255,255,0.08);" />
                        <Label fx:id="lblSpeechInfo"
                               text=""
                               wrapText="true"
                               visible="false"
                               managed="false"
                               style="-fx-text-fill: #9ecbff; -fx-font-size: 12px;" />

<!--                        <HBox alignment="CENTER_LEFT" spacing="8">-->
