<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminAuditLogController"
            style="-fx-background-color: #0a0514;">

    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #0a0514;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 24;">

                    <!-- ═══ KPI CARDS ═══ -->
                    <HBox spacing="14">

                        <!-- Total Logs -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,5,20,0.92);
                                     -fx-border-color: rgba(102,126,234,0.30);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian,rgba(102,126,234,0.15),20,0,0,4);">
                            <Label text="📋 TOTAL LOGS"
                                   style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.35); -fx-font-family: monospace;"/>
                            <Label fx:id="statTotalLabel" text="0"
                                   style="-fx-font-size: 44; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="All Time"
                                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 600; -fx-padding: 0 0 4 0;"/>
                            <ProgressBar progress="1.0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-purple"/>
                        </VBox>

                        <!-- Today -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,5,20,0.92);
                                     -fx-border-color: rgba(240,147,251,0.30);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian,rgba(240,147,251,0.15),20,0,0,4);">
                            <Label text="📅 TODAY"
                                   style="-fx-font-size: 9; -fx-text-fill: rgba(240,147,251,0.75); -fx-font-family: monospace;"/>
                            <Label fx:id="statTodayLabel" text="0"
                                   style="-fx-font-size: 44; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="Today's Events"
                                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 600; -fx-padding: 0 0 4 0;"/>
                            <ProgressBar fx:id="progressToday" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-pink"/>
                        </VBox>

                        <!-- Last 7 Days -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,5,20,0.92);
                                     -fx-border-color: rgba(79,172,254,0.30);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian,rgba(79,172,254,0.15),20,0,0,4);">
                            <Label text="🗓 LAST 7 DAYS"
                                   style="-fx-font-size: 9; -fx-text-fill: rgba(79,172,254,0.75); -fx-font-family: monospace;"/>
                            <Label fx:id="statWeekLabel" text="0"
                                   style="-fx-font-size: 44; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="This Week"
                                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 600; -fx-padding: 0 0 4 0;"/>
                            <ProgressBar fx:id="progressWeek" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-blue"/>
                        </VBox>

                        <!-- Last 30 Days -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color: rgba(10,5,20,0.92);
                                     -fx-border-color: rgba(67,233,123,0.30);
                                     -fx-border-width: 1;
                                     -fx-border-radius: 12; -fx-background-radius: 12;
                                     -fx-padding: 20;
                                     -fx-effect: dropshadow(gaussian,rgba(67,233,123,0.15),20,0,0,4);">
                            <Label text="📆 LAST 30 DAYS"
                                   style="-fx-font-size: 9; -fx-text-fill: rgba(67,233,123,0.75); -fx-font-family: monospace;"/>
                            <Label fx:id="statMonthLabel" text="0"
                                   style="-fx-font-size: 44; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            <Label text="This Month"
                                   style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.5); -fx-font-weight: 600; -fx-padding: 0 0 4 0;"/>
                            <ProgressBar fx:id="progressMonth" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-green"/>
                        </VBox>
                    </HBox>

                    <!-- ═══ FILTERS ═══ -->
                    <VBox spacing="12"
                          style="-fx-background-color: rgba(255,255,255,0.02);
                                 -fx-border-color: rgba(255,255,255,0.07);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 12; -fx-background-radius: 12;
                                 -fx-padding: 16;">
                        <Label text="🔍  Filters"
                               style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <!-- Action -->
                            <ComboBox fx:id="actionFilterCombo" prefWidth="170"
                                      style="-fx-background-color: rgba(30,15,45,0.95);
                                             -fx-border-color: rgba(255,60,100,0.30);
                                             -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            <!-- Entity Type -->
                            <ComboBox fx:id="entityTypeFilterCombo" prefWidth="170"
                                      style="-fx-background-color: rgba(30,15,45,0.95);
                                             -fx-border-color: rgba(255,60,100,0.30);
                                             -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            <!-- Date From -->
                            <DatePicker fx:id="dateFromPicker" prefWidth="145"
                                        promptText="Date from"
                                        style="-fx-background-color: rgba(30,15,45,0.95);
                                               -fx-border-color: rgba(255,60,100,0.30);
                                               -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            <!-- Date To -->
                            <DatePicker fx:id="dateToPicker" prefWidth="145"
                                        promptText="Date to"
                                        style="-fx-background-color: rgba(30,15,45,0.95);
                                               -fx-border-color: rgba(255,60,100,0.30);
                                               -fx-border-radius: 10; -fx-background-radius: 10;"/>
                            <!-- Sort -->
                            <ComboBox fx:id="sortCombo" prefWidth="160"
                                      style="-fx-background-color: rgba(30,15,45,0.95);
                                             -fx-border-color: rgba(255,60,100,0.30);
                                             -fx-border-radius: 10; -fx-background-radius: 10;"/>

                            <Button text="🔍  Apply" onAction="#handleFilter"
                                    style="-fx-background-color: linear-gradient(to right,#ff3c64,#c0132f);
                                           -fx-text-fill: white; -fx-background-radius: 8;
                                           -fx-border-color: transparent; -fx-padding: 9 18;
                                           -fx-cursor: hand; -fx-font-weight: bold;
                                           -fx-effect: dropshadow(gaussian,rgba(255,60,100,0.45),14,0,0,4);"/>
                            <Button text="✕  Clear" onAction="#handleClearFilters"
                                    style="-fx-background-color: rgba(255,255,255,0.05);
                                           -fx-border-color: rgba(255,255,255,0.15);
                                           -fx-border-radius: 8; -fx-background-radius: 8;
                                           -fx-text-fill: rgba(255,255,255,0.65);
                                           -fx-padding: 9 12; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>

                    <!-- ═══ RESULT COUNT ═══ -->
                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="resultCountLabel" text="—"
                               style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- ═══ TABLE ═══ -->
                    <VBox style="-fx-background-color: rgba(255,255,255,0.02);
                                 -fx-border-color: rgba(255,255,255,0.07);
                                 -fx-border-width: 1;
                                 -fx-border-radius: 12; -fx-background-radius: 12;">
                        <Label text="📋  Audit Logs"
                               style="-fx-font-size: 13; -fx-font-weight: bold;
                                      -fx-text-fill: white; -fx-padding: 14 16;"/>

                        <TableView fx:id="logsTable" VBox.vgrow="ALWAYS" prefHeight="500"
                                   style="-fx-background-color: transparent;
                                          -fx-border-color: transparent;
                                          -fx-table-cell-border-color: transparent;">
                            <columns>
                                <TableColumn fx:id="colUser"       text="User"        prefWidth="150"/>
                                <TableColumn fx:id="colAction"     text="Action"      prefWidth="160"/>
                                <TableColumn fx:id="colEntity"     text="Entity"      prefWidth="150"/>
                                <TableColumn fx:id="colDate"       text="Date &amp; Time" prefWidth="140"/>
                                <TableColumn fx:id="colDetails"    text="Details"     prefWidth="280"/>
                                <TableColumn fx:id="colIp"         text="IP Address"  prefWidth="130"/>
                                <TableColumn fx:id="colActions"    text="Actions"     prefWidth="90"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- ═══ PAGINATION ═══ -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="paginationInfoLabel" text=""
                               style="-fx-text-fill: rgba(255,255,255,0.4); -fx-font-size: 12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="prevPageBtn" text="← Prev" onAction="#handlePrevPage"
                                style="-fx-background-color: rgba(255,255,255,0.05);
                                       -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 8;
                                       -fx-background-radius: 8; -fx-text-fill: rgba(255,255,255,0.65);
                                       -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13;"/>
                        <Label fx:id="pageNumberLabel" text="Page 1 / 1"
                               style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
                        <Button fx:id="nextPageBtn" text="Next →" onAction="#handleNextPage"
                                style="-fx-background-color: rgba(255,255,255,0.05);
                                       -fx-border-color: rgba(255,255,255,0.12); -fx-border-radius: 8;
                                       -fx-background-radius: 8; -fx-text-fill: rgba(255,255,255,0.65);
                                       -fx-padding: 8 16; -fx-cursor: hand; -fx-font-size: 13;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
