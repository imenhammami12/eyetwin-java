<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminComplaintController"
            style="-fx-background-color: #0a0514;">

    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #0a0514;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 24;">

                    <!-- ═══ KPI CARDS (mirrors xp-grid stat cards) ═══ -->
                    <HBox spacing="14">

                        <!-- Total Complaints -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.92);
                                     -fx-border-color:rgba(102,126,234,0.30);
                                     -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;
                                     -fx-padding:20;
                                     -fx-effect:dropshadow(gaussian,rgba(102,126,234,0.15),20,0,0,4);">
                            <Label text="COMMAND CENTER"
                                   style="-fx-font-size:9;-fx-text-fill:rgba(255,255,255,0.35);-fx-font-family:monospace;"/>
                            <Label fx:id="totalLabel" text="0"
                                   style="-fx-font-size:44;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <Label text="Total Complaints"
                                   style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.5);-fx-font-weight:600;-fx-padding:0 0 4 0;"/>
                            <ProgressBar fx:id="progressTotal" progress="1.0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-purple"/>
                        </VBox>

                        <!-- Pending -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.92);
                                     -fx-border-color:rgba(255,60,100,0.30);
                                     -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;
                                     -fx-padding:20;
                                     -fx-effect:dropshadow(gaussian,rgba(255,60,100,0.15),20,0,0,4);">
                            <Label text="⚠ NEEDS ACTION"
                                   style="-fx-font-size:9;-fx-text-fill:rgba(255,80,100,0.75);-fx-font-family:monospace;"/>
                            <Label fx:id="pendingLabel" text="0"
                                   style="-fx-font-size:44;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <Label text="Pending"
                                   style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.5);-fx-font-weight:600;-fx-padding:0 0 4 0;"/>
                            <ProgressBar fx:id="progressPending" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-red"/>
                        </VBox>

                        <!-- In Progress -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.92);
                                     -fx-border-color:rgba(79,172,254,0.30);
                                     -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;
                                     -fx-padding:20;
                                     -fx-effect:dropshadow(gaussian,rgba(79,172,254,0.15),20,0,0,4);">
                            <Label text="◈ LIVE PROCESSING"
                                   style="-fx-font-size:9;-fx-text-fill:rgba(255,255,255,0.35);-fx-font-family:monospace;"/>
                            <Label fx:id="inProgressLabel" text="0"
                                   style="-fx-font-size:44;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <Label text="In Progress"
                                   style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.5);-fx-font-weight:600;-fx-padding:0 0 4 0;"/>
                            <ProgressBar fx:id="progressInProgress" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-blue"/>
                        </VBox>

                        <!-- Resolved -->
                        <VBox spacing="6" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.92);
                                     -fx-border-color:rgba(67,233,123,0.30);
                                     -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;
                                     -fx-padding:20;
                                     -fx-effect:dropshadow(gaussian,rgba(67,233,123,0.15),20,0,0,4);">
                            <Label text="✓ MISSION COMPLETE"
                                   style="-fx-font-size:9;-fx-text-fill:rgba(67,233,123,0.75);-fx-font-family:monospace;"/>
                            <Label fx:id="resolvedLabel" text="0"
                                   style="-fx-font-size:44;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <Label text="Resolved"
                                   style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.5);-fx-font-weight:600;-fx-padding:0 0 4 0;"/>
                            <ProgressBar fx:id="progressResolved" progress="0" maxWidth="Infinity"
                                         prefHeight="3" styleClass="progress-green"/>
                        </VBox>
                    </HBox>

                    <!-- ═══ MINI STATS (mirrors mini-stat-row) ═══ -->
                    <HBox spacing="12">
                        <!-- Unassigned -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.85);
                                     -fx-border-color:rgba(255,167,81,0.20);
                                     -fx-border-width:1;-fx-border-radius:10;-fx-background-radius:10;
                                     -fx-padding:14;">
                            <Label text="Unassigned"
                                   style="-fx-font-size:10;-fx-text-fill:rgba(255,255,255,0.4);-fx-font-weight:600;"/>
                            <Label fx:id="unassignedLabel" text="0"
                                   style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ffa751;"/>
                        </VBox>
                        <!-- Rejected -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.85);
                                     -fx-border-color:rgba(255,107,107,0.20);
                                     -fx-border-width:1;-fx-border-radius:10;-fx-background-radius:10;
                                     -fx-padding:14;">
                            <Label text="Rejected"
                                   style="-fx-font-size:10;-fx-text-fill:rgba(255,255,255,0.4);-fx-font-weight:600;"/>
                            <Label fx:id="rejectedLabel" text="0"
                                   style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff6b6b;"/>
                        </VBox>
                        <!-- Avg Resolution -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.85);
                                     -fx-border-color:rgba(56,249,215,0.20);
                                     -fx-border-width:1;-fx-border-radius:10;-fx-background-radius:10;
                                     -fx-padding:14;">
                            <Label text="Avg Resolution"
                                   style="-fx-font-size:10;-fx-text-fill:rgba(255,255,255,0.4);-fx-font-weight:600;"/>
                            <Label fx:id="avgResolutionLabel" text="N/A"
                                   style="-fx-font-size:22;-fx-font-weight:bold;-fx-text-fill:#38f9d7;"/>
                        </VBox>
                        <!-- Resolution Rate -->
                        <VBox spacing="4" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(10,5,20,0.85);
                                     -fx-border-color:rgba(67,233,123,0.20);
                                     -fx-border-width:1;-fx-border-radius:10;-fx-background-radius:10;
                                     -fx-padding:14;">
                            <Label text="Resolution Rate"
                                   style="-fx-font-size:10;-fx-text-fill:rgba(255,255,255,0.4);-fx-font-weight:600;"/>
                            <Label fx:id="resolutionRateLabel" text="0%"
                                   style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                        </VBox>
                    </HBox>

                    <!-- ═══ FILTERS ═══ -->
                    <VBox spacing="12"
                          style="-fx-background-color:rgba(255,255,255,0.02);
                                 -fx-border-color:rgba(255,255,255,0.07);
                                 -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;
                                 -fx-padding:16;">
                        <Label text="🔍  Filters &amp; Search"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="searchField"
                                       promptText="Search complaints..."
                                       prefWidth="240"
                                       style="-fx-background-color:rgba(30,15,45,0.95);
                                              -fx-text-fill:white;
                                              -fx-prompt-text-fill:rgba(255,255,255,0.35);
                                              -fx-border-color:rgba(102,126,234,0.30);
                                              -fx-border-radius:10;-fx-background-radius:10;
                                              -fx-padding:10 14;"/>
                            <ComboBox fx:id="statusFilterCombo"   prefWidth="140"
                                      style="-fx-background-color:rgba(30,15,45,0.95);
                                             -fx-border-color:rgba(102,126,234,0.30);
                                             -fx-border-radius:10;-fx-background-radius:10;"/>
                            <ComboBox fx:id="priorityFilterCombo" prefWidth="140"
                                      style="-fx-background-color:rgba(30,15,45,0.95);
                                             -fx-border-color:rgba(102,126,234,0.30);
                                             -fx-border-radius:10;-fx-background-radius:10;"/>
                            <ComboBox fx:id="categoryFilterCombo" prefWidth="155"
                                      style="-fx-background-color:rgba(30,15,45,0.95);
                                             -fx-border-color:rgba(102,126,234,0.30);
                                             -fx-border-radius:10;-fx-background-radius:10;"/>
                            <ComboBox fx:id="sentimentFilterCombo" prefWidth="140"
                                      style="-fx-background-color:rgba(30,15,45,0.95);
                                             -fx-border-color:rgba(102,126,234,0.30);
                                             -fx-border-radius:10;-fx-background-radius:10;"/>


                            <Button text="🔍  Filter" onAction="#handleFilter"
                                    style="-fx-background-color:linear-gradient(to right,#ff3c64,#c0132f);
               -fx-text-fill:white;-fx-background-radius:8;
               -fx-border-color:transparent;-fx-padding:9 18;
               -fx-cursor:hand;-fx-font-weight:bold;
               -fx-effect:dropshadow(gaussian,rgba(255,60,100,0.45),14,0,0,4);"/>
                            <Button text="✕ Clear" onAction="#handleClearFilters"
                                    style="-fx-background-color:rgba(255,255,255,0.05);
               -fx-border-color:rgba(255,255,255,0.15);
               -fx-border-radius:8;-fx-background-radius:8;
               -fx-text-fill:rgba(255,255,255,0.65);
               -fx-padding:9 12;-fx-cursor:hand;"/>
                        </HBox>
                    </VBox>

                    <!-- Result count -->
                    <Label fx:id="resultCountLabel" text="—"
                           style="-fx-text-fill:rgba(255,255,255,0.5);-fx-font-size:12;"/>

                    <!-- ═══ TABLE ═══ -->
                    <VBox style="-fx-background-color:rgba(255,255,255,0.02);
                                 -fx-border-color:rgba(255,255,255,0.07);
                                 -fx-border-width:1;-fx-border-radius:12;-fx-background-radius:12;">
                        <Label text="📋  Complaints List"
                               style="-fx-font-size:13;-fx-font-weight:bold;-fx-text-fill:white;-fx-padding:14 16;"/>

                        <TableView fx:id="complaintsTable" VBox.vgrow="ALWAYS" prefHeight="520"
                                   style="-fx-background-color:transparent;-fx-border-color:transparent;
                                          -fx-table-cell-border-color:transparent;">
                            <columns>
                                <TableColumn fx:id="colAvatar"    text="Photo"      prefWidth="65"/>
                                <TableColumn fx:id="colUser"      text="User"       prefWidth="110"/>
                                <TableColumn fx:id="colSubject"   text="Subject"    prefWidth="200"/>
                                <TableColumn fx:id="colCategory"  text="Category"   prefWidth="120"/>
                                <TableColumn fx:id="colPriority"  text="Priority"   prefWidth="100"/>
                                <TableColumn fx:id="colStatus"    text="Status"     prefWidth="110"/>
                                <TableColumn fx:id="colSentiment" text="Sentiment"  prefWidth="110"/>
                                <TableColumn fx:id="colAssigned"  text="Assigned"   prefWidth="120"/>
                                <TableColumn fx:id="colCreated"   text="Created"    prefWidth="110"/>
                                <TableColumn fx:id="colActions"   text="Actions"    prefWidth="80"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <!-- ═══ PAGINATION ═══ -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label fx:id="paginationInfoLabel" text=""
                               style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:12;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="prevPageBtn" text="← Prev" onAction="#handlePrevPage"
                                style="-fx-background-color:rgba(255,255,255,0.05);
                                       -fx-border-color:rgba(255,255,255,0.12);-fx-border-radius:8;
                                       -fx-background-radius:8;-fx-text-fill:rgba(255,255,255,0.65);
                                       -fx-padding:8 16;-fx-cursor:hand;"/>
                        <Label fx:id="pageNumberLabel" text="Page 1 / 1"
                               style="-fx-text-fill:white;-fx-font-size:12;-fx-font-weight:bold;"/>
                        <Button fx:id="nextPageBtn" text="Next →" onAction="#handleNextPage"
                                style="-fx-background-color:rgba(255,255,255,0.05);
                                       -fx-border-color:rgba(255,255,255,0.12);-fx-border-radius:8;
                                       -fx-background-radius:8;-fx-text-fill:rgba(255,255,255,0.65);
                                       -fx-padding:8 16;-fx-cursor:hand;"/>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
