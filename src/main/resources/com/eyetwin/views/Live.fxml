<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.LiveController"
            stylesheets="@../styles/gaming.css,@../styles/live.css"
            styleClass="live-root"
            prefWidth="1280" prefHeight="800">
    <top>
        <fx:include source="navbar.fxml" fx:id="navbar"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="scroll-pane">
            <VBox spacing="0" style="-fx-background-color: #080810;">

                <!-- ═══════════════════════════════════════════
                     HERO SECTION
                     StackPane = image bg + overlay + contenu hero
                     La statbar est EN DEHORS du StackPane (sous lui)
                ════════════════════════════════════════════ -->
                <StackPane styleClass="live-hero" prefHeight="360">

                    <!-- Image de fond -->
                    <ImageView styleClass="live-hero-bg"
                               fitWidth="1280" fitHeight="360"
                               preserveRatio="false" smooth="true">
                        <image><Image url="@../assets/img/live_stareams_bg.png"/></image>
                    </ImageView>

                    <!-- Overlay sombre -->
                    <Region styleClass="live-hero-overlay"/>

                    <!-- Fondu bas -->
                    <Region styleClass="live-hero-bottomfade"
                            StackPane.alignment="BOTTOM_CENTER"
                            prefHeight="120" prefWidth="1280"/>

                    <!-- Contenu hero : aligné en bas à gauche -->
                    <VBox spacing="10"
                          StackPane.alignment="BOTTOM_LEFT"
                          style="-fx-padding: 0 80 40 80;">

                        <!-- Tag BROADCAST CENTER -->
                        <HBox alignment="CENTER_LEFT" spacing="8"
                              styleClass="live-hero-tag">
                            <Label text="●"
                                   style="-fx-text-fill:#00e676; -fx-font-size:8;"/>
                            <Label text="BROADCAST CENTER"
                                   styleClass="live-hero-tag-text"/>
                        </HBox>

                        <!-- Titres Live / Streams -->
                        <VBox spacing="-8">
                            <Label text="Live"    styleClass="live-hero-title"/>
                            <Label text="Streams" styleClass="live-hero-title-accent"/>
                        </VBox>

                        <!-- Sous-titre -->
                        <Label text="Watch coaches live, learn in real time and level up your game."
                               styleClass="live-hero-sub"/>

                        <!-- Boutons Go Live / My Streams (coach uniquement) -->
                        <HBox fx:id="coachActions" spacing="10"
                              visible="false" managed="false">
                            <Button text="Go Live"
                                    onAction="#goToCreate"
                                    styleClass="btn-fire"/>
                            <Button text="My Streams"
                                    onAction="#goToMyStreams"
                                    styleClass="btn-ghost"/>
                        </HBox>

                    </VBox>
                </StackPane>

                <!-- ═══════════════════════════════════════════
                     STAT BAR — séparée du StackPane hero
                ════════════════════════════════════════════ -->
                <HBox styleClass="live-statbar"
                      style="-fx-background-color: rgba(255,255,255,0.03);
                             -fx-border-color: rgba(255,255,255,0.08);
                             -fx-border-width: 1 0 0 0;
                             -fx-padding: 20 80 20 80;">

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="totalStreamsLabel" text="0"
                               styleClass="live-stat-val"/>
                        <Label text="TOTAL STREAMS" styleClass="live-stat-lbl"/>
                    </VBox>

                    <Region prefWidth="1" prefHeight="32"
                            styleClass="live-stat-divider"/>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="liveNowLabel" text="0"
                               styleClass="live-stat-val"/>
                        <Label text="LIVE NOW" styleClass="live-stat-lbl"/>
                    </VBox>

                    <Region prefWidth="1" prefHeight="32"
                            styleClass="live-stat-divider"/>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="comingSoonLabel" text="0"
                               styleClass="live-stat-val"/>
                        <Label text="COMING SOON" styleClass="live-stat-lbl"/>
                    </VBox>

                    <Region prefWidth="1" prefHeight="32"
                            styleClass="live-stat-divider"/>

                    <VBox alignment="CENTER" spacing="4" HBox.hgrow="ALWAYS">
                        <Label fx:id="freeStreamsLabel" text="0"
                               styleClass="live-stat-val live-stat-val-free"/>
                        <Label text="FREE STREAMS" styleClass="live-stat-lbl"/>
                    </VBox>

                </HBox>

                <!-- ═══════════════════════════════════════════
                     CONTENU PRINCIPAL
                ════════════════════════════════════════════ -->
                <VBox spacing="16"
                      style="-fx-padding: 26 64 40 64;
                             -fx-background-color: #080810;">

                    <!-- Flash message -->
                    <VBox fx:id="flashBox" visible="false" managed="false"
                          styleClass="gcard">
                        <Label fx:id="flashLabel"/>
                    </VBox>

                    <!-- État vide -->
                    <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="10"
                          styleClass="gcard">
                        <Label text="No Live Streams Right Now"
                               style="-fx-text-fill: white;
                                      -fx-font-size: 22;
                                      -fx-font-weight: 900;"/>
                        <Label text="Check back later or follow coaches to get notified when they go live."
                               style="-fx-text-fill: rgba(255,255,255,0.45);
                                      -fx-font-size: 13;"/>
                    </VBox>

                    <!-- Grille des streams -->
                    <FlowPane fx:id="liveGrid"
                              prefWrapLength="1040"
                              styleClass="live-grid"/>

                </VBox>

            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
