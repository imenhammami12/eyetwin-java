<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.ComplaintController"
            stylesheets="@../styles/gaming.css"
            style="-fx-background-color: #080810;">

    <top>
        <fx:include source="navbar.fxml" fx:id="navbar"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background-color: #080810; -fx-background: #080810; -fx-border-color: transparent;">
            <content>
                <StackPane fx:id="mainStack" style="-fx-background-color: #080810;">

                    <!-- ═══════════════════════════════════════
                         VIEW 1 : LIST
                    ═══════════════════════════════════════ -->
                    <VBox fx:id="viewList" visible="true" managed="true"
                          style="-fx-background-color: #080810;">

                        <!-- HERO BANNER -->
                        <StackPane prefHeight="240"
                                   style="-fx-background-color: linear-gradient(165deg,#1a0308,#0c0b18,#080810);">
                            <VBox alignment="CENTER_LEFT" spacing="12"
                                  style="-fx-padding: 36 48 0 48;">

                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-background-color: rgba(232,55,42,0.09);
                                             -fx-border-color: rgba(232,55,42,0.28);
                                             -fx-border-width:1; -fx-border-radius:3; -fx-background-radius:3;
                                             -fx-padding: 4 12; -fx-max-width:260;">
                                    <Label text="●" style="-fx-text-fill:#3dff8a;-fx-font-size:8;"/>
                                    <Label text="🎫  Support Terminal"
                                           style="-fx-text-fill:#ff4d3d;-fx-font-size:10;-fx-font-weight:bold;"/>
                                </HBox>

                                <Label text="My Complaints"
                                       style="-fx-font-size:36;-fx-font-weight:bold;-fx-text-fill:#e8372a;
                                              -fx-effect:dropshadow(gaussian,rgba(232,55,42,0.4),28,0,0,0);"/>
                                <Label text="Track and manage all your support tickets in one place."
                                       style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:13;"/>

                                <!-- HUD STATS -->
                                <HBox spacing="0"
                                      style="-fx-background-color:rgba(8,8,16,0.7);
                                             -fx-border-color:rgba(232,55,42,0.18);
                                             -fx-border-radius:10;-fx-background-radius:10;
                                             -fx-padding:0;-fx-max-width:420;">
                                    <VBox alignment="CENTER" spacing="3" style="-fx-padding:12 22;">
                                        <Label fx:id="statTotal" text="0"
                                               style="-fx-text-fill:#ff4d3d;-fx-font-size:22;-fx-font-weight:bold;"/>
                                        <Label text="Total" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:10;"/>
                                    </VBox>
                                    <Region style="-fx-background-color:rgba(232,55,42,0.15);-fx-pref-width:1;"/>
                                    <VBox alignment="CENTER" spacing="3" style="-fx-padding:12 22;">
                                        <Label fx:id="statPending" text="0"
                                               style="-fx-text-fill:#ffc107;-fx-font-size:22;-fx-font-weight:bold;"/>
                                        <Label text="Pending" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:10;"/>
                                    </VBox>
                                    <Region style="-fx-background-color:rgba(232,55,42,0.15);-fx-pref-width:1;"/>
                                    <VBox alignment="CENTER" spacing="3" style="-fx-padding:12 22;">
                                        <Label fx:id="statResolved" text="0"
                                               style="-fx-text-fill:#3dff8a;-fx-font-size:22;-fx-font-weight:bold;"/>
                                        <Label text="Resolved" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:10;"/>
                                    </VBox>
                                    <Region style="-fx-background-color:rgba(232,55,42,0.15);-fx-pref-width:1;"/>
                                    <VBox alignment="CENTER" spacing="3" style="-fx-padding:12 22;">
                                        <Label fx:id="statCritical" text="0"
                                               style="-fx-text-fill:#ff2060;-fx-font-size:22;-fx-font-weight:bold;"/>
                                        <Label text="Critical" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:10;"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </StackPane>

                        <!-- SECTION CONTENT -->
                        <VBox spacing="16" style="-fx-padding:28 48 60 48;-fx-background-color:#080810;">

                            <HBox alignment="CENTER_LEFT">
                                <Label text="Tickets"
                                       style="-fx-text-fill:rgba(255,255,255,0.5);-fx-font-size:13;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="＋  New Complaint" onAction="#goToNewView"
                                        style="-fx-background-color:linear-gradient(135deg,#b02b20,#e8372a,#ff5533);
                                               -fx-text-fill:white;-fx-background-radius:8;
                                               -fx-border-color:transparent;-fx-padding:10 20;
                                               -fx-cursor:hand;-fx-font-weight:bold;-fx-font-size:12;
                                               -fx-effect:dropshadow(gaussian,rgba(232,55,42,0.45),14,0,0,4);"/>
                            </HBox>

                            <VBox fx:id="emptyStateBox" alignment="CENTER" spacing="12"
                                  visible="false" managed="false"
                                  style="-fx-background-color:rgba(255,255,255,0.025);
                                         -fx-border-color:rgba(255,255,255,0.07);
                                         -fx-border-radius:10;-fx-background-radius:10;
                                         -fx-padding:64 32;-fx-border-width:1;">
                                <Label text="📭" style="-fx-font-size:48;-fx-opacity:0.15;"/>
                                <Label text="No Tickets Yet"
                                       style="-fx-text-fill:white;-fx-font-size:18;-fx-font-weight:bold;"/>
                                <Label text="You haven't submitted any complaints yet."
                                       style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:13;"/>
                                <Button text="＋  Submit Your First Complaint" onAction="#goToNewView"
                                        style="-fx-background-color:linear-gradient(135deg,#b02b20,#e8372a);
                                               -fx-text-fill:white;-fx-background-radius:8;
                                               -fx-border-color:transparent;-fx-padding:10 20;
                                               -fx-cursor:hand;-fx-font-weight:bold;"/>
                            </VBox>

                            <VBox fx:id="complaintsListBox" spacing="10"/>

                        </VBox>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         VIEW 2 : NEW COMPLAINT
                    ═══════════════════════════════════════ -->
                    <VBox fx:id="viewNew" visible="false" managed="false"
                          style="-fx-background-color: #080810;">

                        <StackPane prefHeight="200"
                                   style="-fx-background-color:linear-gradient(165deg,#1a0308,#0c0b18,#080810);">
                            <VBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:30 48 0 48;">
                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-background-color:rgba(232,55,42,0.09);
                                             -fx-border-color:rgba(232,55,42,0.28);-fx-border-width:1;
                                             -fx-border-radius:3;-fx-background-radius:3;
                                             -fx-padding:4 12;-fx-max-width:200;">
                                    <Label text="●" style="-fx-text-fill:#3dff8a;-fx-font-size:8;"/>
                                    <Label text="🛡  Support Terminal"
                                           style="-fx-text-fill:#ff4d3d;-fx-font-size:10;-fx-font-weight:bold;"/>
                                </HBox>
                                <Label text="Submit Complaint"
                                       style="-fx-font-size:30;-fx-font-weight:bold;-fx-text-fill:#e8372a;"/>
                                <Label text="Our team is standing by — describe your issue and we'll handle it fast."
                                       style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:13;"/>
                            </VBox>
                        </StackPane>

                        <VBox alignment="CENTER" style="-fx-padding:36 0 60 0;-fx-background-color:#080810;">
                            <HBox style="-fx-padding:0 0 16 0;-fx-max-width:600;">
                                <Button text="← Back" onAction="#handleCancelNew"
                                        style="-fx-background-color:transparent;-fx-text-fill:rgba(255,255,255,0.45);
                                               -fx-font-size:12;-fx-cursor:hand;-fx-padding:0;-fx-border-color:transparent;"/>
                            </HBox>

                            <VBox spacing="20" maxWidth="600"
                                  style="-fx-background-color:rgba(6,5,16,0.88);
                                         -fx-border-color:rgba(232,55,42,0.22);
                                         -fx-border-radius:14;-fx-background-radius:14;
                                         -fx-padding:36 36 36 36;
                                         -fx-effect:dropshadow(gaussian,rgba(232,55,42,0.12),40,0,0,10);">

                                <Label fx:id="errGeneral" text="" visible="false" managed="false"
                                       wrapText="true"
                                       style="-fx-text-fill:#ff6b7a;-fx-font-size:12;
                                              -fx-background-color:rgba(232,55,42,0.08);
                                              -fx-border-color:rgba(232,55,42,0.2);
                                              -fx-border-radius:6;-fx-background-radius:6;
                                              -fx-padding:10 14;"/>

                                <!-- STEP 01 — Category -->
                                <VBox spacing="10">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="01"
                                               style="-fx-background-color:rgba(232,55,42,0.12);
                                                      -fx-border-color:rgba(232,55,42,0.35);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-text-fill:#e8372a;-fx-font-size:11;
                                                      -fx-font-weight:bold;-fx-padding:6 10;"/>
                                        <VBox spacing="2">
                                            <Label text="Choose a Category"
                                                   style="-fx-text-fill:white;-fx-font-size:13;-fx-font-weight:bold;"/>
                                            <Label text="Select the type that best describes your issue"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <VBox fx:id="categoryBox" spacing="8"/>
                                    <Label fx:id="errCategory" text="" visible="false" managed="false"
                                           style="-fx-text-fill:#ff6b7a;-fx-font-size:11;"/>
                                </VBox>

                                <!-- STEP 02 — Subject -->
                                <VBox spacing="8">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="02"
                                               style="-fx-background-color:rgba(232,55,42,0.12);
                                                      -fx-border-color:rgba(232,55,42,0.35);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-text-fill:#e8372a;-fx-font-size:11;
                                                      -fx-font-weight:bold;-fx-padding:6 10;"/>
                                        <VBox spacing="2">
                                            <Label text="Subject"
                                                   style="-fx-text-fill:white;-fx-font-size:13;-fx-font-weight:bold;"/>
                                            <Label text="Brief summary — 5 to 200 characters"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <TextField fx:id="subjectField"
                                               promptText="e.g. Cannot access my tournament page…"
                                               style="-fx-background-color:rgba(255,255,255,0.03);
                                                      -fx-border-color:rgba(255,255,255,0.09);
                                                      -fx-border-width:1.5;-fx-border-radius:9;
                                                      -fx-background-radius:9;
                                                      -fx-text-fill:rgba(255,255,255,0.93);
                                                      -fx-prompt-text-fill:rgba(255,255,255,0.35);
                                                      -fx-font-size:13;-fx-padding:12 14;"/>
                                    <Label fx:id="errSubject" text="" visible="false" managed="false"
                                           style="-fx-text-fill:#ff6b7a;-fx-font-size:11;"/>
                                </VBox>

                                <!-- STEP 03 — Description -->
                                <VBox spacing="8">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="03"
                                               style="-fx-background-color:rgba(232,55,42,0.12);
                                                      -fx-border-color:rgba(232,55,42,0.35);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-text-fill:#e8372a;-fx-font-size:11;
                                                      -fx-font-weight:bold;-fx-padding:6 10;"/>
                                        <VBox spacing="2">
                                            <Label text="Description"
                                                   style="-fx-text-fill:white;-fx-font-size:13;-fx-font-weight:bold;"/>
                                            <Label text="Be as detailed as possible — helps us resolve faster"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <TextArea fx:id="descriptionArea" prefRowCount="5" wrapText="true"
                                              promptText="Describe exactly what happened, when, and any steps you already tried…"
                                              style="-fx-control-inner-background:rgba(255,255,255,0.03);
                                                     -fx-background-color:rgba(255,255,255,0.03);
                                                     -fx-border-color:rgba(255,255,255,0.09);
                                                     -fx-border-width:1.5;-fx-border-radius:9;
                                                     -fx-background-radius:9;
                                                     -fx-text-fill:rgba(255,255,255,0.93);
                                                     -fx-prompt-text-fill:rgba(255,255,255,0.35);
                                                     -fx-font-size:13;-fx-padding:12 14;"/>
                                    <Label fx:id="errDescription" text="" visible="false" managed="false"
                                           style="-fx-text-fill:#ff6b7a;-fx-font-size:11;"/>
                                </VBox>

                                <!-- STEP 04 — Attachment -->
                                <VBox spacing="8">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="04"
                                               style="-fx-background-color:rgba(232,55,42,0.12);
                                                      -fx-border-color:rgba(232,55,42,0.35);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-text-fill:#e8372a;-fx-font-size:11;
                                                      -fx-font-weight:bold;-fx-padding:6 10;"/>
                                        <VBox spacing="2">
                                            <HBox alignment="CENTER_LEFT" spacing="8">
                                                <Label text="Attachment"
                                                       style="-fx-text-fill:white;-fx-font-size:13;-fx-font-weight:bold;"/>
                                                <Label text="Optional"
                                                       style="-fx-background-color:rgba(255,255,255,0.06);
                                                              -fx-border-color:rgba(255,255,255,0.10);
                                                              -fx-border-radius:20;-fx-background-radius:20;
                                                              -fx-text-fill:rgba(255,255,255,0.38);
                                                              -fx-font-size:10;-fx-padding:2 8;"/>
                                            </HBox>
                                            <Label text="Image, PDF or Word — max 5 MB"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Button fx:id="attachmentBtn" text="📁  Choose File"
                                                onAction="#handleChooseAttachment"
                                                style="-fx-background-color:rgba(232,55,42,0.08);
                                                       -fx-border-color:rgba(232,55,42,0.25);
                                                       -fx-border-radius:7;-fx-background-radius:7;
                                                       -fx-text-fill:#ff4d3d;-fx-font-size:11;
                                                       -fx-font-weight:bold;
                                                       -fx-padding:9 16;-fx-cursor:hand;"/>
                                        <Label fx:id="attachmentLabel" text="No file chosen"
                                               style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:11;"/>
                                    </HBox>
                                </VBox>

                                <Region style="-fx-background-color:rgba(255,255,255,0.06);-fx-pref-height:1;"/>

                                <HBox spacing="12" alignment="CENTER_RIGHT">
                                    <Button text="← Back" onAction="#handleCancelNew"
                                            style="-fx-background-color:rgba(255,255,255,0.04);
                                                   -fx-border-color:rgba(255,255,255,0.10);
                                                   -fx-border-radius:9;-fx-background-radius:9;
                                                   -fx-text-fill:rgba(255,255,255,0.55);
                                                   -fx-font-size:12;-fx-font-weight:bold;
                                                   -fx-padding:12 22;-fx-cursor:hand;"/>
                                    <Button fx:id="submitBtn" text="🚀  Submit Complaint"
                                            onAction="#handleSubmit"
                                            style="-fx-background-color:linear-gradient(135deg,#b02b20,#e8372a,#ff5533);
                                                   -fx-text-fill:white;-fx-background-radius:9;
                                                   -fx-border-color:transparent;-fx-padding:12 24;
                                                   -fx-cursor:hand;-fx-font-weight:bold;-fx-font-size:13;
                                                   -fx-effect:dropshadow(gaussian,rgba(232,55,42,0.45),14,0,0,4);"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </VBox>

                    <!-- ═══════════════════════════════════════
                         VIEW 3 : SHOW
                    ═══════════════════════════════════════ -->
                    <VBox fx:id="viewShow" visible="false" managed="false"
                          style="-fx-background-color: #080810;">

                        <StackPane prefHeight="180"
                                   style="-fx-background-color:linear-gradient(165deg,#1a0308,#0c0b18,#080810);">
                            <VBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding:28 48 0 48;">
                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-background-color:rgba(232,55,42,0.09);
                                             -fx-border-color:rgba(232,55,42,0.28);-fx-border-width:1;
                                             -fx-border-radius:3;-fx-background-radius:3;
                                             -fx-padding:4 12;-fx-max-width:200;">
                                    <Label text="●" style="-fx-text-fill:#3dff8a;-fx-font-size:8;"/>
                                    <Label text="🎫  Ticket Detail"
                                           style="-fx-text-fill:#ff4d3d;-fx-font-size:10;-fx-font-weight:bold;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label text="Ticket"
                                           style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label fx:id="showIdLabel" text="#0"
                                           style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#e8372a;"/>
                                </HBox>
                                <Label fx:id="showSubjectLabel" text=""
                                       style="-fx-text-fill:rgba(255,255,255,0.55);-fx-font-size:13;"/>
                            </VBox>
                        </StackPane>

                        <!-- CONTENT -->
                        <HBox spacing="20" alignment="TOP_LEFT"
                              style="-fx-padding:24 48 60 48;-fx-background-color:#080810;">

                            <!-- LEFT COLUMN -->
                            <VBox spacing="14" HBox.hgrow="ALWAYS">

                                <Button text="← Back to My Complaints" onAction="#goBackToList"
                                        style="-fx-background-color:rgba(255,255,255,0.04);
                                               -fx-border-color:rgba(255,255,255,0.10);
                                               -fx-border-radius:9;-fx-background-radius:9;
                                               -fx-text-fill:rgba(255,255,255,0.55);
                                               -fx-font-size:11;-fx-cursor:hand;-fx-padding:8 14;"/>

                                <!-- Main card -->
                                <VBox spacing="14"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(255,255,255,0.065);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:20 22;">

                                    <!-- Header badges (fx:id = showStatusBadge / showPriorityBadge / showCategoryBadge) -->
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Label fx:id="showStatusBadge" text="PENDING"/>
                                        <Label fx:id="showPriorityBadge" text="MEDIUM"/>
                                        <Label fx:id="showCategoryBadge" text="OTHER"/>
                                    </HBox>

                                    <Region style="-fx-background-color:rgba(255,255,255,0.055);-fx-pref-height:1;"/>

                                    <Label text="DESCRIPTION"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                    <Label fx:id="showDescriptionLabel" text="" wrapText="true"
                                           style="-fx-text-fill:rgba(255,255,255,0.8);-fx-font-size:13;-fx-line-spacing:4;"/>

                                    <VBox fx:id="adminResponseBox" spacing="8" visible="false" managed="false">
                                        <Region style="-fx-background-color:rgba(255,255,255,0.055);-fx-pref-height:1;"/>
                                        <Label text="SUPPORT RESPONSE"
                                               style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                        <HBox spacing="12" alignment="TOP_LEFT"
                                              style="-fx-background-color:rgba(13,202,240,0.07);
                                                     -fx-border-color:rgba(13,202,240,0.18);
                                                     -fx-border-radius:9;-fx-background-radius:9;
                                                     -fx-padding:14 16;">
                                            <Label text="🎧" style="-fx-font-size:16;"/>
                                            <Label fx:id="adminResponseLabel" text="" wrapText="true"
                                                   style="-fx-text-fill:#cde8f0;-fx-font-size:12;" HBox.hgrow="ALWAYS"/>
                                        </HBox>
                                    </VBox>

                                    <VBox fx:id="resolutionBox" spacing="8" visible="false" managed="false">
                                        <Region style="-fx-background-color:rgba(255,255,255,0.055);-fx-pref-height:1;"/>
                                        <Label text="RESOLUTION"
                                               style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                        <HBox spacing="12" alignment="TOP_LEFT"
                                              style="-fx-background-color:rgba(25,135,84,0.08);
                                                     -fx-border-color:rgba(25,135,84,0.22);
                                                     -fx-border-radius:9;-fx-background-radius:9;
                                                     -fx-padding:14 16;">
                                            <Label text="✅" style="-fx-font-size:16;"/>
                                            <Label fx:id="resolutionLabel" text="" wrapText="true"
                                                   style="-fx-text-fill:#c3f0d3;-fx-font-size:12;" HBox.hgrow="ALWAYS"/>
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <!-- Timeline -->
                                <VBox spacing="12"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(255,255,255,0.065);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:20 22;">
                                    <Label text="TIMELINE"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>

                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="📅"
                                               style="-fx-background-color:rgba(13,110,253,0.14);
                                                      -fx-border-color:rgba(13,110,253,0.28);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-padding:8 10;-fx-font-size:14;"/>
                                        <VBox spacing="2">
                                            <Label text="Submitted"
                                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                            <Label fx:id="showCreatedLabel" text="—"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="🔄"
                                               style="-fx-background-color:rgba(13,202,240,0.10);
                                                      -fx-border-color:rgba(13,202,240,0.25);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-padding:8 10;-fx-font-size:14;"/>
                                        <VBox spacing="2">
                                            <Label text="Last Updated"
                                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                            <Label fx:id="showUpdatedLabel" text="—"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <HBox spacing="12" alignment="CENTER_LEFT">
                                        <Label text="✅"
                                               style="-fx-background-color:rgba(61,214,140,0.10);
                                                      -fx-border-color:rgba(61,214,140,0.25);
                                                      -fx-border-radius:8;-fx-background-radius:8;
                                                      -fx-padding:8 10;-fx-font-size:14;"/>
                                        <VBox spacing="2">
                                            <Label text="Resolved"
                                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                            <Label fx:id="showResolvedLabel" text="—"
                                                   style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </VBox>

                            <!-- RIGHT COLUMN -->
                            <VBox spacing="14" prefWidth="280">

                                <!-- Sentiment Card -->
                                <VBox fx:id="noSentimentBox" spacing="6"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(255,255,255,0.065);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:16 18;">
                                    <Label text="SENTIMENT"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                    <Label text="Not analyzed yet"
                                           style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:12;"/>
                                </VBox>

                                <VBox fx:id="sentimentBox" spacing="10" visible="false" managed="false"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(255,255,255,0.065);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:16 18;">
                                    <Label text="SENTIMENT"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="sentimentEmoji" text="😐"
                                               style="-fx-font-size:28;"/>
                                        <VBox spacing="3">
                                            <Label fx:id="sentimentTextLabel" text=""
                                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14;"/>
                                            <Label fx:id="sentimentScoreLabel" text=""
                                                   style="-fx-text-fill:rgba(255,255,255,0.4);-fx-font-size:11;"/>
                                        </VBox>
                                    </HBox>
                                    <ProgressBar fx:id="sentimentBar" progress="0" maxWidth="Infinity"
                                                 prefHeight="6" style="-fx-accent:#ffd54f;"/>
                                    <Label fx:id="sentimentSourceLabel" text=""
                                           style="-fx-font-size:11;"/>
                                    <VBox fx:id="sentimentSuggestionBox" spacing="4"
                                          visible="false" managed="false"
                                          style="-fx-background-color:rgba(255,193,7,0.08);
                                                 -fx-border-color:rgba(255,193,7,0.25);
                                                 -fx-border-radius:8;-fx-background-radius:8;
                                                 -fx-padding:10 12;">
                                        <Label fx:id="sentimentSuggestionLabel" text=""
                                               wrapText="true"
                                               style="-fx-text-fill:#ffd54f;-fx-font-size:11;"/>
                                    </VBox>
                                </VBox>

                                <!-- Info card — NOTE: renamed fx:id to infoStatusBadge / infoPriorityBadge / infoCategoryLabel -->
                                <VBox spacing="0"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(255,255,255,0.065);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:16 18;">
                                    <Label text="INFORMATION"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;-fx-padding:0 0 10 0;"/>

                                    <HBox style="-fx-padding:8 0;">
                                        <Label text="Status" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <!-- ↓ RENAMED: was showStatusBadge (duplicate), now infoStatusBadge -->
                                        <Label fx:id="infoStatusBadge" text=""/>
                                    </HBox>
                                    <Region style="-fx-background-color:rgba(255,255,255,0.05);-fx-pref-height:1;"/>
                                    <HBox style="-fx-padding:8 0;">
                                        <Label text="Priority" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <!-- ↓ RENAMED: was showPriorityBadge (duplicate), now infoPriorityBadge -->
                                        <Label fx:id="infoPriorityBadge" text=""/>
                                    </HBox>
                                    <Region style="-fx-background-color:rgba(255,255,255,0.05);-fx-pref-height:1;"/>
                                    <HBox style="-fx-padding:8 0;">
                                        <Label text="Category" style="-fx-text-fill:rgba(255,255,255,0.38);-fx-font-size:11;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <!-- ↓ RENAMED: was showCategoryBadge (duplicate), now infoCategoryLabel -->
                                        <Label fx:id="infoCategoryLabel" text=""
                                               style="-fx-text-fill:rgba(255,255,255,0.55);-fx-font-size:11;"/>
                                    </HBox>
                                </VBox>

                                <!-- Actions card (delete — pending only) -->
                                <VBox fx:id="actionsBox" spacing="8" visible="false" managed="false"
                                      style="-fx-background-color:rgba(6,5,16,0.88);
                                             -fx-border-color:rgba(232,55,42,0.18);
                                             -fx-border-radius:12;-fx-background-radius:12;
                                             -fx-padding:16 18;">
                                    <Label text="ACTIONS"
                                           style="-fx-text-fill:rgba(232,55,42,0.8);-fx-font-size:10;-fx-font-weight:bold;"/>
                                    <Button fx:id="deleteBtn" text="🗑  Delete Complaint"
                                            onAction="#handleDelete" maxWidth="Infinity"
                                            style="-fx-background-color:rgba(232,55,42,0.10);
                                                   -fx-border-color:rgba(232,55,42,0.30);
                                                   -fx-border-radius:9;-fx-background-radius:9;
                                                   -fx-text-fill:#ff7055;-fx-font-weight:bold;
                                                   -fx-font-size:12;-fx-padding:10;-fx-cursor:hand;"/>
                                    <Label text="ℹ You can only delete pending complaints"
                                           style="-fx-text-fill:rgba(255,255,255,0.3);-fx-font-size:10;-fx-text-alignment:center;"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </VBox>

                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
