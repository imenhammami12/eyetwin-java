<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminTeamController"
            style="-fx-background-color: #0a0514;">

    <left>
        <fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <center>
        <VBox style="-fx-background-color: #0a0514;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="16" style="-fx-padding: 24;">

                    <!-- Back button -->
                    <Button text="← Back to Teams" onAction="#goBackToList"
                            style="-fx-background-color: rgba(255,255,255,0.05);
                                   -fx-border-color: rgba(255,255,255,0.15); -fx-border-radius: 8;
                                   -fx-background-radius: 8; -fx-text-fill: rgba(255,255,255,0.7);
                                   -fx-padding: 8 16; -fx-cursor: hand;"/>

                    <!-- Main body -->
                    <HBox spacing="16" alignment="TOP_LEFT">

                        <!-- LEFT — Team Info Card -->
                        <VBox spacing="14" prefWidth="300"
                              style="-fx-background-color: rgba(255,255,255,0.02);
                                     -fx-border-color: rgba(255,255,255,0.07);
                                     -fx-border-radius: 14; -fx-background-radius: 14;
                                     -fx-padding: 24; -fx-alignment: CENTER;">

                            <!-- Team Logo / Avatar -->
                            <StackPane prefWidth="110" prefHeight="110" alignment="CENTER">
                                <Circle radius="55"
                                        fill="linear-gradient(from 0% 0% to 100% 100%, #667eea, #764ba2)"/>
                                <Label fx:id="teamAvatarLabel" text="??"
                                       style="-fx-font-size: 32; -fx-font-weight: bold; -fx-text-fill: white;"/>
                            </StackPane>

                            <!-- Team Name -->
                            <Label fx:id="teamNameLabel" text="—"
                                   style="-fx-font-size: 18; -fx-font-weight: bold;
                                          -fx-text-fill: white; -fx-wrap-text: true;
                                          -fx-text-alignment: center;"/>

                            <!-- Status chip -->
                            <HBox alignment="CENTER" spacing="8">
                                <Label fx:id="teamStatusChip" text="ACTIVE"
                                       style="-fx-background-color: rgba(67,233,123,0.15);
                                              -fx-border-color: rgba(67,233,123,0.3);
                                              -fx-border-radius: 8; -fx-background-radius: 8;
                                              -fx-text-fill: #43e97b; -fx-font-size: 11;
                                              -fx-font-weight: bold; -fx-padding: 5 12;"/>
                            </HBox>

                            <!-- Description -->
                            <VBox fx:id="descBox" spacing="6" visible="false" managed="false"
                                  style="-fx-background-color: rgba(255,255,255,0.03);
                                         -fx-border-radius: 10; -fx-background-radius: 10;
                                         -fx-padding: 12;">
                                <Label text="DESCRIPTION"
                                       style="-fx-text-fill: rgba(255,255,255,0.35);
                                              -fx-font-size: 9; -fx-font-family: monospace;"/>
                                <Label fx:id="descLabel" text="" wrapText="true"
                                       style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-size: 12;"/>
                            </VBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                            <!-- Capacity progress -->
                            <VBox spacing="8" fillWidth="true">
                                <Label text="TEAM CAPACITY"
                                       style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);
                                              -fx-font-family: monospace;"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="capacityLabel" text="0 / 10"
                                           style="-fx-text-fill: white; -fx-font-size: 16;
                                                  -fx-font-weight: bold;"/>
                                    <Label fx:id="capacityPctLabel" text="0%"
                                           style="-fx-text-fill: rgba(255,255,255,0.40);
                                                  -fx-font-size: 12;"/>
                                </HBox>
                                <ProgressBar fx:id="capacityBar" progress="0" maxWidth="Infinity"
                                             prefHeight="8" styleClass="progress-purple"/>
                            </VBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                            <!-- Stats -->
                            <VBox spacing="10" fillWidth="true">
                                <Label text="STATISTICS"
                                       style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);
                                              -fx-font-family: monospace;"/>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Created :"
                                           style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12;"/>
                                    <Label fx:id="createdLabel" text="—"
                                           style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Owner :"
                                           style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12;"/>
                                    <Label fx:id="ownerLabel" text="—"
                                           style="-fx-text-fill: #4facfe; -fx-font-size: 12; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Max Members :"
                                           style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12;"/>
                                    <Label fx:id="maxMembersLabel" text="—"
                                           style="-fx-text-fill: white; -fx-font-size: 12; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Active Members :"
                                           style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12;"/>
                                    <Label fx:id="activeMembersLabel" text="—"
                                           style="-fx-text-fill: #43e97b; -fx-font-size: 12; -fx-font-weight: bold;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label text="Pending :"
                                           style="-fx-text-fill: rgba(255,255,255,0.40); -fx-font-size: 12;"/>
                                    <Label fx:id="pendingLabel" text="—"
                                           style="-fx-text-fill: #ffd54f; -fx-font-size: 12; -fx-font-weight: bold;"/>
                                </HBox>
                            </VBox>

                            <Separator style="-fx-background-color: rgba(255,255,255,0.08);"/>

                            <!-- Actions -->
                            <VBox spacing="8" fillWidth="true">
                                <Label text="ACTIONS"
                                       style="-fx-font-size: 9; -fx-text-fill: rgba(255,255,255,0.4);
                                              -fx-font-family: monospace;"/>
                                <Button fx:id="toggleStatusBtn"
                                        text="⏸  Deactivate Team"
                                        onAction="#handleToggleStatus"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: rgba(255,171,0,0.08);
                                               -fx-border-color: rgba(255,171,0,0.35);
                                               -fx-border-radius: 8; -fx-background-radius: 8;
                                               -fx-text-fill: #ffb700; -fx-font-weight: bold;
                                               -fx-padding: 10; -fx-cursor: hand;"/>
                                <Button fx:id="deleteTeamBtn"
                                        text="🗑  Delete Team"
                                        onAction="#handleDeleteTeam"
                                        maxWidth="Infinity"
                                        style="-fx-background-color: rgba(140,20,40,0.08);
                                               -fx-border-color: rgba(180,40,60,0.3);
                                               -fx-border-radius: 8; -fx-background-radius: 8;
                                               -fx-text-fill: rgba(255,107,122,0.65);
                                               -fx-font-weight: bold; -fx-padding: 10; -fx-cursor: hand;"/>
                            </VBox>

                        </VBox>

                        <!-- RIGHT — Members Table -->
                        <VBox spacing="14" HBox.hgrow="ALWAYS">

                            <!-- Active Members -->
                            <VBox spacing="0"
                                  style="-fx-background-color: rgba(255,255,255,0.02);
             -fx-border-color: rgba(255,255,255,0.07);
             -fx-border-radius: 14; -fx-background-radius: 14;">

                                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 14 16;">
                                    <Label text="👥  Active Members"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label fx:id="activeMembersBadge" text="0"
                                           style="-fx-background-color: rgba(67,233,123,0.25);
                      -fx-border-color: rgba(67,233,123,0.50);
                      -fx-border-radius: 10; -fx-background-radius: 10;
                      -fx-text-fill: #43e97b; -fx-font-size: 10;
                      -fx-font-weight: bold; -fx-padding: 2 8;"/>
                                </HBox>

                                <Separator style="-fx-background-color: rgba(255,255,255,0.07);"/>

                                <VBox fx:id="membersEmptyState" alignment="CENTER" spacing="8"
                                      style="-fx-padding: 36;">
                                    <Label text="👥" style="-fx-font-size: 36; -fx-opacity: 0.15;"/>
                                    <Label text="No active members"
                                           style="-fx-text-fill: rgba(255,255,255,0.50); -fx-font-size: 14; -fx-font-weight: bold;"/>
                                </VBox>

                                <!-- Remplace TableView par VBox dynamique -->
                                <VBox fx:id="membersListBox" spacing="0" style="-fx-padding: 8;"/>
                            </VBox>

                            <!-- Pending Requests -->
                            <VBox spacing="0"
                                  style="-fx-background-color: rgba(255,255,255,0.02);
                                         -fx-border-color: rgba(255,255,255,0.07);
                                         -fx-border-radius: 14; -fx-background-radius: 14;">

                                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 14 16;">
                                    <Label text="⏳  Pending Requests"
                                           style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: white;"/>
                                    <Label fx:id="pendingBadge" text="0"
                                           style="-fx-background-color: rgba(255,193,7,0.25);
                                                  -fx-border-color: rgba(255,193,7,0.50);
                                                  -fx-border-radius: 10; -fx-background-radius: 10;
                                                  -fx-text-fill: #ffd54f; -fx-font-size: 10;
                                                  -fx-font-weight: bold; -fx-padding: 2 8;"/>
                                </HBox>

                                <Separator style="-fx-background-color: rgba(255,255,255,0.07);"/>

                                <VBox fx:id="pendingEmptyState" alignment="CENTER" spacing="6"
                                      style="-fx-padding: 24;">
                                    <Label text="No pending requests"
                                           style="-fx-text-fill: rgba(255,255,255,0.30); -fx-font-size: 13;"/>
                                </VBox>

                                <TableView fx:id="pendingTable" visible="false" managed="false"
                                           prefHeight="180"
                                           style="-fx-background-color: transparent;
                                                  -fx-border-color: transparent;
                                                  -fx-table-cell-border-color: transparent;
                                                  -fx-control-inner-background: rgba(20,10,35,0.80);
                                                  -fx-control-inner-background-alt: rgba(30,15,45,0.60);">
                                    <columns>
                                        <TableColumn fx:id="colPendingUsername" text="Username"  prefWidth="180"/>
                                        <TableColumn fx:id="colPendingEmail"    text="Email"     prefWidth="220"/>
                                        <TableColumn fx:id="colPendingDate"     text="Requested" prefWidth="140"/>
                                        <TableColumn fx:id="colPendingActions"  text="Actions"   prefWidth="150"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="No pending requests"
                                               style="-fx-text-fill: rgba(255,255,255,0.30); -fx-font-size: 13;"/>
                                    </placeholder>
                                </TableView>
                            </VBox>

                        </VBox>
                    </HBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
