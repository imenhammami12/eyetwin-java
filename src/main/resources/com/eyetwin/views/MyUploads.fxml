<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.MyUploadsController"
            stylesheets="@../styles/gaming.css"
            style="-fx-background-color: #0a0e27;"
            prefWidth="1280" prefHeight="800">

    <!-- NAVBAR -->
    <top>
        <fx:include source="navbar.fxml" fx:id="navbar"/>
    </top>

    <!-- CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color:#0a0e27; -fx-background:#0a0e27; -fx-border-color:transparent;">
            <VBox spacing="0" style="-fx-background-color:#0a0e27; -fx-padding:40 40 60 40;">

                <!-- HERO HEADER -->
                <VBox spacing="16" style="-fx-padding:0 0 32 0;">
                    <HBox alignment="CENTER_LEFT" spacing="16">
                        <Label text="📤"
                               style="-fx-font-size:42; -fx-text-fill:#4cd3e3;"/>
                        <VBox spacing="4">
                            <Label text="My Uploads"
                                   style="-fx-font-family:'Arial Black'; -fx-font-size:36; -fx-font-weight:bold; -fx-text-fill:white;"/>
                            <Label text="Manage and track all your guide and video uploads"
                                   style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:12;"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="⬆  Upload New" onAction="#goToUploadVideo"
                                style="-fx-background-color:linear-gradient(135deg,#b02b20,#e8372a,#ff4d3d);
                                       -fx-border-color:transparent; -fx-border-radius:10; -fx-background-radius:10;
                                       -fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:14;
                                       -fx-padding:14 28 14 28; -fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(232,55,42,0.45),20,0,0,6);"/>
                    </HBox>
                    
                    <!-- QUICK STATS -->
                    <HBox spacing="12" style="-fx-padding:0;">
                        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(76,211,227,0.08); -fx-border-color:rgba(76,211,227,0.2);
                                     -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12 16 12 16;">
                            <Label text="Total Uploads" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                            <Label fx:id="headerTotalUploads" text="0"
                                   style="-fx-font-family:'Arial Black'; -fx-font-size:20; -fx-text-fill:#4cd3e3; -fx-font-weight:bold;"/>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(0,230,118,0.08); -fx-border-color:rgba(0,230,118,0.2);
                                     -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12 16 12 16;">
                            <Label text="Approved" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                            <Label fx:id="headerApproved" text="0"
                                   style="-fx-font-family:'Arial Black'; -fx-font-size:20; -fx-text-fill:#00e676; -fx-font-weight:bold;"/>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,193,7,0.08); -fx-border-color:rgba(255,193,7,0.2);
                                     -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12 16 12 16;">
                            <Label text="Pending" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                            <Label fx:id="headerPending" text="0"
                                   style="-fx-font-family:'Arial Black'; -fx-font-size:20; -fx-text-fill:#ffc107; -fx-font-weight:bold;"/>
                        </VBox>
                        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,165,0,0.08); -fx-border-color:rgba(255,165,0,0.2);
                                     -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:12 16 12 16;">
                            <Label text="Total Views" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                            <Label fx:id="headerViews" text="0"
                                   style="-fx-font-family:'Arial Black'; -fx-font-size:20; -fx-text-fill:#ffa500; -fx-font-weight:bold;"/>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- TABS with styling -->
                <TabPane fx:id="uploadTabs" tabClosingPolicy="UNAVAILABLE"
                         style="-fx-padding:20 0 0 0; -fx-background-color:transparent;"
                         tabMinWidth="140">

                    <!-- ALL UPLOADS TAB -->
                    <Tab text="📋  All Uploads" closable="false"
                         style="-fx-font-size:12; -fx-font-weight:bold; -fx-text-fill:white;">
                        <VBox spacing="16" style="-fx-padding:24; -fx-background-color:rgba(20,25,45,0.6); -fx-border-color:rgba(76,211,227,0.15); -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">

                            <!-- FILTERS -->
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <TextField fx:id="searchFieldAll" promptText="🔍  Search uploads..."
                                           style="-fx-background-color: rgba(255,255,255,0.06);
                                                  -fx-text-fill: white;
                                                  -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                                  -fx-border-color: rgba(76,211,227,0.3);
                                                  -fx-border-radius: 8;
                                                  -fx-background-radius: 8;
                                                  -fx-padding: 11 14 11 14;
                                                  -fx-font-size: 13;"
                                           HBox.hgrow="ALWAYS"/>
                                <ComboBox fx:id="typeFilterAll" prefWidth="160"
                                          style="-fx-background-color: rgba(255,255,255,0.06);
                                                 -fx-text-fill: white;
                                                 -fx-border-color: rgba(76,211,227,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-background-radius: 8;
                                                 -fx-font-size: 12;
                                                 -fx-padding: 8;"/>
                                <ComboBox fx:id="statusFilterAll" prefWidth="160"
                                          style="-fx-background-color: rgba(255,255,255,0.06);
                                                 -fx-text-fill: white;
                                                 -fx-border-color: rgba(76,211,227,0.3);
                                                 -fx-border-radius: 8;
                                                 -fx-background-radius: 8;
                                                 -fx-font-size: 12;
                                                 -fx-padding: 8;"/>
                            </HBox>

                            <!-- TABLE VIEW with styling -->
                            <TableView fx:id="allUploadsTable" 
                                       style="-fx-background-color: transparent;
                                              -fx-control-inner-background: transparent;
                                              -fx-table-cell-border-color: rgba(76,211,227,0.1);
                                              -fx-table-header-border-color: rgba(76,211,227,0.2);"
                                       prefHeight="350">
                                <columns>
                                    <TableColumn fx:id="titleColAll" text="📋  Title" prefWidth="250" sortable="false"/>
                                    <TableColumn fx:id="typeColAll" text="🏷  Type" prefWidth="100" sortable="false"/>
                                    <TableColumn fx:id="statusColAll" text="📊  Status" prefWidth="120" sortable="false"/>
                                    <TableColumn fx:id="dateColAll" text="📅  Uploaded" prefWidth="150" sortable="false"/>
                                    <TableColumn fx:id="viewsColAll" text="👁  Views" prefWidth="80" sortable="false"/>
                                    <TableColumn fx:id="actionsColAll" text="⚙  Actions" prefWidth="220" sortable="false"/>
                                </columns>
                            </TableView>

                            <!-- EMPTY STATE -->
                            <VBox fx:id="emptyStateAll" alignment="CENTER" spacing="20"
                                  style="-fx-padding:80 0 80 0;" visible="false" managed="false">
                                <Label text="📤" style="-fx-font-size:64; -fx-text-fill:rgba(76,211,227,0.2);"/>
                                <Label text="No uploads found" style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;"/>
                                <Label text="Start sharing your gaming content with the community"
                                       style="-fx-text-fill:#aeb8c9; -fx-font-size:14;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- GUIDES TAB -->
                    <Tab text="📖  Guides" closable="false"
                         style="-fx-font-size:12; -fx-font-weight:bold; -fx-text-fill:white;">
                        <VBox spacing="16" style="-fx-padding:24; -fx-background-color:rgba(20,25,45,0.6); -fx-border-color:rgba(76,211,227,0.15); -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                            <TextField fx:id="searchFieldGuides" promptText="🔍  Search guides..."
                                       style="-fx-background-color: rgba(255,255,255,0.06);
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                              -fx-border-color: rgba(76,211,227,0.3);
                                              -fx-border-radius: 8;
                                              -fx-background-radius: 8;
                                              -fx-padding: 11 14 11 14;
                                              -fx-font-size: 13;"/>
                            <FlowPane fx:id="guidesGrid" hgap="16" vgap="16" style="-fx-padding:10;"/>
                            <VBox fx:id="emptyStateGuides" alignment="CENTER" spacing="20"
                                  style="-fx-padding:80 0 80 0;" visible="false" managed="false">
                                <Label text="📖" style="-fx-font-size:64; -fx-text-fill:rgba(76,211,227,0.2);"/>
                                <Label text="No guides uploaded" style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- VIDEOS/CLIPS TAB -->
                    <Tab text="🎬  Videos &amp; Clips" closable="false"
                         style="-fx-font-size:12; -fx-font-weight:bold; -fx-text-fill:white;">
                        <VBox spacing="16" style="-fx-padding:24; -fx-background-color:rgba(20,25,45,0.6); -fx-border-color:rgba(76,211,227,0.15); -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                            <TextField fx:id="searchFieldVideos" promptText="🔍  Search videos..."
                                       style="-fx-background-color: rgba(255,255,255,0.06);
                                              -fx-text-fill: white;
                                              -fx-prompt-text-fill: rgba(255,255,255,0.3);
                                              -fx-border-color: rgba(76,211,227,0.3);
                                              -fx-border-radius: 8;
                                              -fx-background-radius: 8;
                                              -fx-padding: 11 14 11 14;
                                              -fx-font-size: 13;"/>
                            <FlowPane fx:id="videosGrid" hgap="16" vgap="16" style="-fx-padding:10;"/>
                            <VBox fx:id="emptyStateVideos" alignment="CENTER" spacing="20"
                                  style="-fx-padding:80 0 80 0;" visible="false" managed="false">
                                <Label text="🎬" style="-fx-font-size:64; -fx-text-fill:rgba(76,211,227,0.2);"/>
                                <Label text="No videos uploaded" style="-fx-text-fill:white; -fx-font-size:24; -fx-font-weight:bold;"/>
                            </VBox>
                        </VBox>
                    </Tab>

                    <!-- STATS TAB -->
                    <Tab text="📊  Statistics" closable="false"
                         style="-fx-font-size:12; -fx-font-weight:bold; -fx-text-fill:white;">
                           <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                                 style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-color:transparent;">
                            <VBox spacing="28" style="-fx-padding:32; -fx-background-color:rgba(20,25,45,0.6); -fx-border-color:rgba(76,211,227,0.15); -fx-border-width:1; -fx-border-radius:12; -fx-background-radius:12;">
                                <VBox spacing="6">
                                 <Label text="Upload Analytics"
                                     style="-fx-font-family:'Arial Black'; -fx-font-size:30; -fx-font-weight:bold; -fx-text-fill:white;"/>
                                 <Label text="Performance insights across your guides and clips"
                                     style="-fx-text-fill:rgba(255,255,255,0.55); -fx-font-size:12;"/>
                                </VBox>

                                <GridPane hgap="20" vgap="20" style="-fx-padding:0;">
                                 <columnConstraints>
                                     <ColumnConstraints hgrow="ALWAYS"/>
                                     <ColumnConstraints hgrow="ALWAYS"/>
                                 </columnConstraints>

                                 <VBox alignment="TOP_LEFT" spacing="10"
                                    style="-fx-background-color:linear-gradient(135deg,rgba(76,211,227,0.2),rgba(76,211,227,0.06));
                                        -fx-border-color:rgba(76,211,227,0.45); -fx-border-width:1.5; -fx-border-radius:16;
                                        -fx-background-radius:16; -fx-padding:30;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0">
                                     <Label text="📤  Total Uploads" style="-fx-text-fill:rgba(255,255,255,0.72); -fx-font-size:13; -fx-font-weight:bold;"/>
                                     <Label fx:id="statTotalUploads" text="0"
                                         style="-fx-font-family:'Arial Black'; -fx-font-size:56; -fx-text-fill:#4cd3e3; -fx-font-weight:bold;"/>
                                     <Label text="All submitted guides and clips" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                                 </VBox>

                                 <VBox alignment="TOP_LEFT" spacing="10"
                                    style="-fx-background-color:linear-gradient(135deg,rgba(255,165,0,0.2),rgba(255,165,0,0.06));
                                        -fx-border-color:rgba(255,165,0,0.45); -fx-border-width:1.5; -fx-border-radius:16;
                                        -fx-background-radius:16; -fx-padding:30;"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0">
                                     <Label text="👁  Total Views" style="-fx-text-fill:rgba(255,255,255,0.72); -fx-font-size:13; -fx-font-weight:bold;"/>
                                     <Label fx:id="statTotalViews" text="0"
                                         style="-fx-font-family:'Arial Black'; -fx-font-size:56; -fx-text-fill:#ffa500; -fx-font-weight:bold;"/>
                                     <Label text="Audience reach across all content" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                                 </VBox>
                                </GridPane>

                                <GridPane hgap="16" vgap="16" style="-fx-padding:0;">
                                 <columnConstraints>
                                     <ColumnConstraints hgrow="ALWAYS"/>
                                     <ColumnConstraints hgrow="ALWAYS"/>
                                     <ColumnConstraints hgrow="ALWAYS"/>
                                 </columnConstraints>

                                 <VBox alignment="CENTER" spacing="8"
                                    style="-fx-background-color:linear-gradient(135deg,rgba(0,230,118,0.14),rgba(0,230,118,0.05));
                                        -fx-border-color:rgba(0,230,118,0.35); -fx-border-width:1; -fx-border-radius:12;
                                        -fx-background-radius:12; -fx-padding:22;"
                                    GridPane.columnIndex="0" GridPane.rowIndex="0">
                                     <Label text="✅  Approved" style="-fx-text-fill:rgba(255,255,255,0.68); -fx-font-size:11; -fx-font-weight:bold;"/>
                                     <Label fx:id="statApproved" text="0"
                                         style="-fx-font-family:'Arial Black'; -fx-font-size:34; -fx-text-fill:#00e676; -fx-font-weight:bold;"/>
                                     <Label text="Published" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                                 </VBox>

                                 <VBox alignment="CENTER" spacing="8"
                                    style="-fx-background-color:linear-gradient(135deg,rgba(255,193,7,0.14),rgba(255,193,7,0.05));
                                        -fx-border-color:rgba(255,193,7,0.35); -fx-border-width:1; -fx-border-radius:12;
                                        -fx-background-radius:12; -fx-padding:22;"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0">
                                     <Label text="⏳  Pending" style="-fx-text-fill:rgba(255,255,255,0.68); -fx-font-size:11; -fx-font-weight:bold;"/>
                                     <Label fx:id="statPending" text="0"
                                         style="-fx-font-family:'Arial Black'; -fx-font-size:34; -fx-text-fill:#ffc107; -fx-font-weight:bold;"/>
                                     <Label text="In review" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                                 </VBox>

                                 <VBox alignment="CENTER" spacing="8"
                                    style="-fx-background-color:linear-gradient(135deg,rgba(232,55,42,0.14),rgba(232,55,42,0.05));
                                        -fx-border-color:rgba(232,55,42,0.35); -fx-border-width:1; -fx-border-radius:12;
                                        -fx-background-radius:12; -fx-padding:22;"
                                    GridPane.columnIndex="2" GridPane.rowIndex="0">
                                     <Label text="❌  Rejected" style="-fx-text-fill:rgba(255,255,255,0.68); -fx-font-size:11; -fx-font-weight:bold;"/>
                                     <Label fx:id="statRejected" text="0"
                                         style="-fx-font-family:'Arial Black'; -fx-font-size:34; -fx-text-fill:#e8372a; -fx-font-weight:bold;"/>
                                     <Label text="Needs update" style="-fx-text-fill:rgba(255,255,255,0.4); -fx-font-size:10;"/>
                                 </VBox>
                                </GridPane>

                                <HBox spacing="18" style="-fx-padding:6 0 0 0;">
                                    <VBox HBox.hgrow="ALWAYS" spacing="8"
                                          style="-fx-background-color:rgba(12,18,40,0.75); -fx-border-color:rgba(76,211,227,0.22);
                                                 -fx-border-width:1; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:18;">
                                        <Label text="Status Distribution" style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                                        <PieChart fx:id="statusPieChart" labelsVisible="false" legendVisible="true"
                                                  style="-fx-background-color:transparent; -fx-clockwise:true; -fx-pie-label-visible:false;"
                                                  prefHeight="260"/>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" spacing="8"
                                          style="-fx-background-color:rgba(12,18,40,0.75); -fx-border-color:rgba(255,165,0,0.22);
                                                 -fx-border-width:1; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:18;">
                                        <Label text="Volume &amp; Reach" style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                                        <BarChart fx:id="performanceBarChart" legendVisible="false" categoryGap="18" barGap="6"
                                                  style="-fx-background-color:transparent;" prefHeight="260">
                                            <xAxis>
                                                <CategoryAxis side="BOTTOM"/>
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis side="LEFT" autoRanging="true" forceZeroInRange="true"/>
                                            </yAxis>
                                        </BarChart>
                                    </VBox>
                                </HBox>

                                <HBox alignment="CENTER_LEFT" spacing="14"
                                      style="-fx-background-color:rgba(76,211,227,0.08); -fx-border-color:rgba(76,211,227,0.20);
                                             -fx-border-width:1; -fx-border-radius:14; -fx-background-radius:14; -fx-padding:16 18 16 18;">
                                    <Label text="🪙" style="-fx-font-size:26;"/>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Views to Coins" style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                                        <Label text="Every 50 views on one of your guides or clips earns you +10 coins automatically."
                                               style="-fx-text-fill:rgba(255,255,255,0.72); -fx-font-size:11;"/>
                                        <Label text="Rewards are counted per upload, so each content piece can generate its own coin bonus."
                                               style="-fx-text-fill:rgba(255,255,255,0.45); -fx-font-size:10;"/>
                                    </VBox>
                                    <VBox alignment="CENTER_RIGHT" spacing="2">
                                        <Label text="50 views" style="-fx-text-fill:#4cd3e3; -fx-font-size:18; -fx-font-weight:bold;"/>
                                        <Label text="= +10 coins" style="-fx-text-fill:#00e676; -fx-font-size:18; -fx-font-weight:bold;"/>
                                    </VBox>
                                </HBox>

                                <GridPane hgap="14" vgap="14" style="-fx-padding:2 0 0 0;">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                        <ColumnConstraints hgrow="ALWAYS"/>
                                    </columnConstraints>

                                    <VBox spacing="6" style="-fx-background-color:rgba(76,211,227,0.08); -fx-border-color:rgba(76,211,227,0.25); -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:14;" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="Approval Rate" style="-fx-text-fill:rgba(255,255,255,0.55); -fx-font-size:10;"/>
                                        <Label fx:id="kpiApprovalRate" text="0%" style="-fx-font-family:'Arial Black'; -fx-font-size:24; -fx-text-fill:#4cd3e3;"/>
                                        <Label text="Approved / total uploads" style="-fx-text-fill:rgba(255,255,255,0.38); -fx-font-size:9;"/>
                                    </VBox>

                                    <VBox spacing="6" style="-fx-background-color:rgba(0,230,118,0.08); -fx-border-color:rgba(0,230,118,0.25); -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:14;" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="Avg Views / Upload" style="-fx-text-fill:rgba(255,255,255,0.55); -fx-font-size:10;"/>
                                        <Label fx:id="kpiAvgViews" text="0.0" style="-fx-font-family:'Arial Black'; -fx-font-size:24; -fx-text-fill:#00e676;"/>
                                        <Label text="Total views / total uploads" style="-fx-text-fill:rgba(255,255,255,0.38); -fx-font-size:9;"/>
                                    </VBox>

                                    <VBox spacing="6" style="-fx-background-color:rgba(255,193,7,0.08); -fx-border-color:rgba(255,193,7,0.25); -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:14;" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                        <Label text="Published Impact" style="-fx-text-fill:rgba(255,255,255,0.55); -fx-font-size:10;"/>
                                        <Label fx:id="kpiPublishedImpact" text="0.0" style="-fx-font-family:'Arial Black'; -fx-font-size:24; -fx-text-fill:#ffc107;"/>
                                        <Label text="Views / approved guides" style="-fx-text-fill:rgba(255,255,255,0.38); -fx-font-size:9;"/>
                                    </VBox>

                                    <VBox spacing="6" style="-fx-background-color:rgba(232,55,42,0.08); -fx-border-color:rgba(232,55,42,0.25); -fx-border-width:1; -fx-border-radius:10; -fx-background-radius:10; -fx-padding:14;" GridPane.columnIndex="3" GridPane.rowIndex="0">
                                        <Label text="Quality Score" style="-fx-text-fill:rgba(255,255,255,0.55); -fx-font-size:10;"/>
                                        <Label fx:id="kpiQualityScore" text="0" style="-fx-font-family:'Arial Black'; -fx-font-size:24; -fx-text-fill:#ff6b6b;"/>
                                        <Label text="Business score / 100" style="-fx-text-fill:rgba(255,255,255,0.38); -fx-font-size:9;"/>
                                    </VBox>
                                </GridPane>
                            </VBox>
                           </ScrollPane>
                    </Tab>
                </TabPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
