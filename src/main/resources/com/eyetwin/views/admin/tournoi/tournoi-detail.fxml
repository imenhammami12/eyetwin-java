<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="modal-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eyetwin.controller.admin.TournoiDetailController" minWidth="600">
    <stylesheets><URL value="@../../../styles/gaming-theme.css"/></stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="🏆" style="-fx-font-size:18px;"/>
        <VBox spacing="2">
            <Label text="Tournament Details" styleClass="modal-title"/>
            <Label text="Full tournament information" styleClass="modal-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="idLabel" style="-fx-text-fill:#333344;-fx-font-size:12px;"/>
    </HBox>

    <!-- Body -->
    <VBox styleClass="modal-body" spacing="15" VBox.vgrow="ALWAYS">

        <!-- Image Area -->
        <StackPane fx:id="imgContainer" styleClass="detail-img-area" prefHeight="200">
            <Label fx:id="imgPlaceholder" text="🏆" style="-fx-font-size:52px;-fx-text-fill:#333344;"/>
            <ImageView fx:id="tournoiImage" fitWidth="598" fitHeight="200" preserveRatio="false" smooth="true" visible="false"/>
        </StackPane>

        <!-- Name + Badge -->
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label fx:id="lblNom" styleClass="detail-name" text="Tournament Name" HBox.hgrow="ALWAYS" maxWidth="1.7976931348623157E308"/>
            <Label fx:id="lblType" styleClass="detail-badge" text="TYPE"/>
        </HBox>

        <!-- Info grid -->
        <HBox spacing="15">
            <!-- Left column -->
            <VBox styleClass="detail-section" spacing="12" HBox.hgrow="ALWAYS">
                <HBox spacing="8">
                    <Label text="📅" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="START DATE" styleClass="detail-key"/>
                        <Label fx:id="lblDateDebut" styleClass="detail-value" text="—"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Label text="🏁" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="END DATE" styleClass="detail-key"/>
                        <Label fx:id="lblDateFin" styleClass="detail-value" text="—"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Label text="📝" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="DESCRIPTION" styleClass="detail-key"/>
                        <Label fx:id="lblDescription" styleClass="detail-value" text="—" wrapText="true"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Right column -->
            <VBox styleClass="detail-section" spacing="12" prefWidth="180">
                <VBox spacing="2" alignment="CENTER">
                    <Label text="PRIZE POOL" styleClass="detail-key"/>
                    <Label fx:id="lblPrix" styleClass="detail-big" text="0 DT"/>
                </VBox>
            </VBox>
        </HBox>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT">
        <Button text="✕  Close" onAction="#onClose" styleClass="btn-close"/>
    </HBox>
</VBox>
