<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.eyetwin.controller.ResetPasswordController"
           prefWidth="1280" prefHeight="800"
           style="-fx-background-color: #080810;">

    <!-- BACKGROUND -->
    <ImageView fitWidth="1280" fitHeight="800" preserveRatio="false" smooth="true">
        <image><Image url="@../assets/img/bg6.png"/></image>
    </ImageView>
    <Region style="-fx-background-color: rgba(0,0,0,0.58);"/>

    <!-- LAYOUT -->
    <VBox alignment="TOP_CENTER" prefWidth="1280" prefHeight="800">

        <!-- NAVBAR -->
        <HBox alignment="CENTER_LEFT" spacing="20"
              prefHeight="52" minHeight="52" maxHeight="52"
              style="-fx-background-color: rgba(6,6,14,0.97);
                     -fx-border-color: rgba(220,20,60,0.18);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 30 0 30;">
            <ImageView fitHeight="32" preserveRatio="true">
                <image><Image url="@../assets/img/eyetwin-logo.png"/></image>
            </ImageView>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- CONTENT -->
        <StackPane VBox.vgrow="ALWAYS">
            <HBox alignment="CENTER" maxWidth="860" maxHeight="720"
                  style="-fx-background-color: #111;
                         -fx-background-radius: 14;
                         -fx-border-radius: 14;
                         -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.75),44,0,0,12);">

                <!-- LEFT IMAGE -->
                <StackPane prefWidth="375" prefHeight="660"
                           style="-fx-background-color: #0a0a0a;
                                  -fx-background-radius: 14 0 0 14;">
                    <ImageView fitWidth="375" fitHeight="660"
                               preserveRatio="false" smooth="true">
                        <image><Image url="@../assets/img/gaming-characters.png"/></image>
                    </ImageView>
                    <Region style="-fx-background-color:
                        linear-gradient(to right,rgba(100,0,0,0.2),rgba(0,0,0,0.52));
                        -fx-background-radius: 14 0 0 14;"/>
                    <VBox alignment="BOTTOM_LEFT" style="-fx-padding: 28;">
                        <Label text="SET YOUR NEW"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:20;
                                      -fx-text-fill:white; -fx-font-weight:bold;"/>
                        <Label text="PASSWORD"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:20;
                                      -fx-text-fill:#dc143c; -fx-font-weight:bold;"/>
                        <Label text="Choose something strong and unique."
                               style="-fx-text-fill:#555; -fx-font-size:11; -fx-padding:4 0 0 0;"/>
                    </VBox>
                </StackPane>

                <!-- RIGHT FORM -->
                <VBox alignment="CENTER" HBox.hgrow="ALWAYS"
                      prefWidth="485" prefHeight="660" spacing="0"
                      style="-fx-background-color: #090909;
                             -fx-background-radius: 0 14 14 0;
                             -fx-padding: 24 36 24 36;">

                    <!-- ICON + TITLE -->
                    <VBox alignment="CENTER" spacing="5" style="-fx-padding: 0 0 16 0;">
                        <Label text="🔒"
                               style="-fx-font-size: 36;"/>
                        <Label text="SET NEW PASSWORD"
                               style="-fx-font-family:'Arial Black'; -fx-font-size:14;
                                      -fx-font-weight:bold; -fx-text-fill:white;
                                      -fx-effect: dropshadow(gaussian,rgba(220,20,60,0.4),10,0,0,2);"/>
                        <Label text="CHOOSE A STRONG AND SECURE PASSWORD"
                               style="-fx-text-fill: #3a3a3a; -fx-font-size: 9; -fx-font-weight:bold;"/>
                    </VBox>

                    <!-- PASSWORD FIELD -->
                    <VBox spacing="5" style="-fx-padding: 0 0 6 0;">
                        <Label text="NEW PASSWORD  *"
                               style="-fx-text-fill: #555; -fx-font-size: 9; -fx-font-weight:bold;"/>
                        <PasswordField fx:id="passwordField" promptText="Enter your new password"
                                       prefHeight="42" prefWidth="413"
                                       style="-fx-background-color: rgba(255,255,255,0.06);
                                              -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 2;
                                              -fx-border-radius: 10; -fx-background-radius: 10;
                                              -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.35);
                                              -fx-font-size: 14; -fx-padding: 10 44 10 14;"/>

                        <!-- STRENGTH BAR TRACK -->
                        <StackPane prefHeight="6" prefWidth="413"
                                   style="-fx-background-color: rgba(255,255,255,0.08);
                                          -fx-background-radius:3;">
                            <StackPane alignment="CENTER_LEFT">
                                <Rectangle fx:id="strengthBar" height="6" width="0"
                                           arcWidth="3" arcHeight="3"
                                           style="-fx-fill: #f85149;"/>
                            </StackPane>
                        </StackPane>

                        <HBox alignment="CENTER_RIGHT">
                            <Label fx:id="strengthLabel" text=""
                                   style="-fx-text-fill: #f85149; -fx-font-size: 9; -fx-font-weight:bold;"/>
                        </HBox>
                    </VBox>

                    <!-- CONFIRM FIELD -->
                    <VBox spacing="5" style="-fx-padding: 0 0 12 0;">
                        <Label text="CONFIRM PASSWORD  *"
                               style="-fx-text-fill: #555; -fx-font-size: 9; -fx-font-weight:bold;"/>
                        <PasswordField fx:id="confirmField" promptText="Confirm your new password"
                                       prefHeight="42" prefWidth="413"
                                       style="-fx-background-color: rgba(255,255,255,0.06);
                                              -fx-border-color: rgba(255,255,255,0.15); -fx-border-width: 2;
                                              -fx-border-radius: 10; -fx-background-radius: 10;
                                              -fx-text-fill: white; -fx-prompt-text-fill: rgba(255,255,255,0.35);
                                              -fx-font-size: 14; -fx-padding: 10 44 10 14;"/>
                        <Label fx:id="matchLabel" text=""
                               style="-fx-font-size: 11;"/>
                    </VBox>

                    <!-- REQUIREMENTS BOX -->
                    <VBox spacing="0"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08); -fx-border-width:1;
                                 -fx-border-radius:10; -fx-background-radius:10;
                                 -fx-padding: 12 16 12 16; -fx-margin: 0 0 12 0;">
                        <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 0 0 9 0;">
                            <Label text="ℹ" style="-fx-text-fill: #5a67d8; -fx-font-size:14;"/>
                            <Label text="PASSWORD REQUIREMENTS"
                                   style="-fx-text-fill:white; -fx-font-size:11;
                                          -fx-font-weight:bold; -fx-letter-spacing:0.5em;"/>
                        </HBox>
                        <Label fx:id="ruleLength" text="○ At least 8 characters"
                               style="-fx-text-fill:#484f58; -fx-font-size:12; -fx-padding:3 0 3 18;"/>
                        <Label fx:id="ruleUpper"  text="○ One uppercase letter (A-Z)"
                               style="-fx-text-fill:#484f58; -fx-font-size:12; -fx-padding:3 0 3 18;"/>
                        <Label fx:id="ruleLower"  text="○ One lowercase letter (a-z)"
                               style="-fx-text-fill:#484f58; -fx-font-size:12; -fx-padding:3 0 3 18;"/>
                        <Label fx:id="ruleDigit"  text="○ One number (0-9)"
                               style="-fx-text-fill:#484f58; -fx-font-size:12; -fx-padding:3 0 3 18;"/>
                    </VBox>

                    <!-- ERROR / SUCCESS -->
                    <Label fx:id="errorLabel" text="" prefWidth="413" wrapText="true"
                           style="-fx-text-fill: #f85149; -fx-font-size: 11;
                                  -fx-padding: 0 0 8 0;"/>

                    <!-- SPINNER -->
                    <ProgressIndicator fx:id="loadingSpinner" prefWidth="28" prefHeight="28"
                                       style="-fx-progress-color: #dc143c;"
                                       visible="false"/>

                    <!-- SUBMIT -->
                    <Button fx:id="submitButton" text="✓  RESET PASSWORD"
                            onAction="#handleReset"
                            prefWidth="413" prefHeight="42"
                            disable="true"
                            style="-fx-background-color: linear-gradient(to right,#b00020,#e8112d);
                                   -fx-text-fill: white; -fx-font-weight: bold;
                                   -fx-font-size: 13; -fx-background-radius: 6; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian,rgba(192,18,48,0.5),14,0,0,3);"/>

                    <!-- BACK TO LOGIN -->
                    <HBox alignment="CENTER" style="-fx-padding: 12 0 0 0;">
                        <Label text="Remember your password? "
                               style="-fx-text-fill: #484f58; -fx-font-size: 11;"/>
                        <Label text="Back to Login" onMouseClicked="#goToLogin"
                               style="-fx-text-fill: #c01230; -fx-font-size: 11; -fx-cursor: hand;"/>
                    </HBox>

                </VBox>
            </HBox>
        </StackPane>
    </VBox>
</StackPane>
