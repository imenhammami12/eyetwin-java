<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminDashboardController"
            style="-fx-background-color: #0d0618;"
            prefWidth="1280" prefHeight="800">

    <left>
        <fx:include source="admin-sidebar.fxml" fx:id="adminSidebar"/>
    </left>
    <top>
        <fx:include source="admin-topbar.fxml" fx:id="adminTopbar"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #0d0618; -fx-background: #0d0618; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-padding: 28 32 28 32; -fx-background-color: #0d0618;">

                <!-- ══ KPI ROW 1 — Total Users / Total Teams / Pending Apps / Avg/Day ══ -->
                <HBox spacing="16">
                    <!-- Total Users -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane style="-fx-background-color:linear-gradient(135deg,#667eea,#764ba2);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                <Label text="👥" style="-fx-font-size:32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="totalUsersLabel" text="—"
                                       style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="Total Users"
                                       style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label fx:id="userGrowthBadge" text="— %"
                                           style="-fx-background-color:rgba(67,233,123,0.2);-fx-text-fill:#43e97b;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    <Label text="this month"
                                           style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Total Teams -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane style="-fx-background-color:linear-gradient(135deg,#f093fb,#f5576c);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                <Label text="🔲" style="-fx-font-size:32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="totalTeamsLabel" text="—"
                                       style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="Total Teams"
                                       style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label fx:id="teamGrowthBadge" text="— %"
                                           style="-fx-background-color:rgba(240,147,251,0.2);-fx-text-fill:#f093fb;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    <Label text="this month"
                                           style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Pending Applications -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane style="-fx-background-color:linear-gradient(135deg,#4facfe,#00f2fe);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                <Label text="✅" style="-fx-font-size:32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="pendingApplicationsLabel" text="—"
                                       style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="Pending Applications"
                                       style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label fx:id="appsTodayBadge" text="— today"
                                           style="-fx-background-color:rgba(255,193,7,0.2);-fx-text-fill:#ffc107;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    <Label fx:id="approvalRateSmall" text="— % approved"
                                           style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Avg Users/Day -->
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                        <HBox alignment="CENTER_LEFT" spacing="14">
                            <StackPane style="-fx-background-color:linear-gradient(135deg,#43e97b,#38f9d7);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                <Label text="📈" style="-fx-font-size:32;"/>
                            </StackPane>
                            <VBox spacing="4">
                                <Label fx:id="avgUsersPerDayLabel" text="—"
                                       style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="New Users / Day"
                                       style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <Label fx:id="usersLast7Badge" text="— this week"
                                           style="-fx-background-color:rgba(67,233,123,0.2);-fx-text-fill:#43e97b;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ══ USER STATISTICS ══ -->
                <Label text="👥  User Statistics"
                       style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,255,255,0.04);-fx-border-color:rgba(255,255,255,0.08);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="totalUsersLabel2" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <Label text="Total" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(67,233,123,0.06);-fx-border-color:rgba(67,233,123,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="activeUsersLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                        <Label text="Active" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,193,7,0.06);-fx-border-color:rgba(255,193,7,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="suspendedUsersLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ffc107;"/>
                        <Label text="Suspended" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,60,100,0.06);-fx-border-color:rgba(255,60,100,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="bannedUsersLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff3c64;"/>
                        <Label text="Banned" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(90,103,216,0.06);-fx-border-color:rgba(90,103,216,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="userGrowthRateLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#818cf8;"/>
                        <Label text="Growth Rate" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ══ ADVANCED METRICS ══ -->
                <Label text="📊  Advanced Metrics"
                       style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                <HBox spacing="16">
                    <!-- Activation Rate -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="✔" style="-fx-font-size:20;-fx-text-fill:#43e97b;"/>
                            <Label text="Activation Rate"
                                   style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:14;"/>
                        </HBox>
                        <Label fx:id="activeUsersPercentageLabel" text="— %"
                               style="-fx-font-size:36;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <ProgressBar fx:id="activeUsersProgress" progress="0"
                                     maxWidth="Infinity"
                                     style="-fx-accent:#43e97b;-fx-background-color:rgba(255,255,255,0.1);-fx-background-radius:10;-fx-pref-height:6;"/>
                        <Label fx:id="activeUsersDetailLabel" text="— of — users"
                               style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.6);"/>
                    </VBox>

                    <!-- Members per Team -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="👤" style="-fx-font-size:20;"/>
                            <Label text="Members / Team"
                                   style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:14;"/>
                        </HBox>
                        <Label fx:id="avgMembersPerTeamLabel" text="—"
                               style="-fx-font-size:36;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <ProgressBar fx:id="membersProgress" progress="0"
                                     maxWidth="Infinity"
                                     style="-fx-accent:#4facfe;-fx-background-color:rgba(255,255,255,0.1);-fx-background-radius:10;-fx-pref-height:6;"/>
                        <Label fx:id="totalMembersLabel" text="— active members"
                               style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.6);"/>
                    </VBox>

                    <!-- Approval Rate -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="✅" style="-fx-font-size:20;"/>
                            <Label text="Approval Rate"
                                   style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:14;"/>
                        </HBox>
                        <Label fx:id="approvalRateLabel" text="— %"
                               style="-fx-font-size:36;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <ProgressBar fx:id="approvalProgress" progress="0"
                                     maxWidth="Infinity"
                                     style="-fx-accent:#818cf8;-fx-background-color:rgba(255,255,255,0.1);-fx-background-radius:10;-fx-pref-height:6;"/>
                        <Label fx:id="approvalDetailLabel" text="— / — applications"
                               style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.6);"/>
                    </VBox>

                    <!-- Active Teams % -->
                    <VBox spacing="10" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="🔲" style="-fx-font-size:20;"/>
                            <Label text="Active Teams"
                                   style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:14;"/>
                        </HBox>
                        <Label fx:id="activeTeamsPercentageLabel" text="— %"
                               style="-fx-font-size:36;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <ProgressBar fx:id="activeTeamsProgress" progress="0"
                                     maxWidth="Infinity"
                                     style="-fx-accent:#f093fb;-fx-background-color:rgba(255,255,255,0.1);-fx-background-radius:10;-fx-pref-height:6;"/>
                        <Label fx:id="activeTeamsDetailLabel" text="— of — teams"
                               style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.6);"/>
                    </VBox>
                </HBox>

                <!-- ══ TEAM STATISTICS ══ -->
                <Label text="🔲  Team Statistics"
                       style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,255,255,0.04);-fx-border-color:rgba(255,255,255,0.08);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="totalTeamsLabel2" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <Label text="Total Teams" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(67,233,123,0.06);-fx-border-color:rgba(67,233,123,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="activeTeamsLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                        <Label text="Active" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,60,100,0.06);-fx-border-color:rgba(255,60,100,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="inactiveTeamsLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff3c64;"/>
                        <Label text="Inactive" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(90,103,216,0.06);-fx-border-color:rgba(90,103,216,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="teamsLast7Label" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#818cf8;"/>
                        <Label text="Last 7 Days" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,193,7,0.06);-fx-border-color:rgba(255,193,7,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="teamGrowthRateLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ffc107;"/>
                        <Label text="Growth Rate" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ══ COACH APPLICATIONS ══ -->
                <Label text="✅  Coach Applications"
                       style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,255,255,0.04);-fx-border-color:rgba(255,255,255,0.08);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="totalApplicationsLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                        <Label text="Total" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,193,7,0.06);-fx-border-color:rgba(255,193,7,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="pendingApplicationsLabel2" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ffc107;"/>
                        <Label text="Pending" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(67,233,123,0.06);-fx-border-color:rgba(67,233,123,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="approvedApplicationsLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                        <Label text="Approved" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,60,100,0.06);-fx-border-color:rgba(255,60,100,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="rejectedApplicationsLabel" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff3c64;"/>
                        <Label text="Rejected" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(255,60,100,0.06);-fx-border-color:rgba(255,60,100,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="appsLast7Label" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff3c64;"/>
                        <Label text="Last 7 Days" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color:rgba(90,103,216,0.06);-fx-border-color:rgba(90,103,216,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                        <Label fx:id="approvalRateLabel2" text="—"
                               style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#818cf8;"/>
                        <Label text="Approval Rate" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ══ SUMMARY — Today / 7 days / 30 days ══ -->
                <Label text="📅  Activity Summary"
                       style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                <HBox spacing="16">
                    <VBox spacing="8" HBox.hgrow="ALWAYS"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <StackPane style="-fx-background-color:linear-gradient(135deg,#667eea,#764ba2);-fx-background-radius:12;-fx-min-width:60;-fx-min-height:60;-fx-max-width:60;-fx-max-height:60;">
                                <Label text="📆" style="-fx-font-size:28;"/>
                            </StackPane>
                            <VBox spacing="3">
                                <Label fx:id="usersTodayLabel" text="—"
                                       style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                <Label text="New Users Today"
                                       style="-fx-font-size:13;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                <Label fx:id="usersYesterdayLabel" text="— yesterday"
                                       style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                            </VBox>
                        </HBox>
