<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminDashboardController"
            style="-fx-background-color: #0d0618;"
            prefWidth="1280" prefHeight="800">

    <left><fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/></left>

    <center>
        <VBox style="-fx-background-color: #0d0618;">
            <fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:#0d0618;-fx-background:#0d0618;-fx-border-color:transparent;">
                <VBox spacing="20" style="-fx-padding:28 32 28 32;-fx-background-color:#0d0618;">

                    <!-- ══ KPI ROW ══ -->
                    <HBox spacing="16">
                        <!-- Total Users -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#667eea,#764ba2);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="👥" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="totalUsersLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Total Users" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="userGrowthBadge" text="—"
                                               style="-fx-background-color:rgba(67,233,123,0.2);-fx-text-fill:#43e97b;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                        <Label text="this month" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                        <!-- Total Teams -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#f093fb,#f5576c);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="🔲" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="totalTeamsLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Total Teams" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="teamGrowthBadge" text="—"
                                               style="-fx-background-color:rgba(240,147,251,0.2);-fx-text-fill:#f093fb;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                        <Label text="this month" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                        <!-- Pending Apps -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#4facfe,#00f2fe);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="✅" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="pendingApplicationsLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Pending Applications" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="appsTodayBadge" text="—"
                                               style="-fx-background-color:rgba(255,193,7,0.2);-fx-text-fill:#ffc107;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                        <Label fx:id="approvalRateSmall" text="—" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                        <!-- Avg/Day -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#43e97b,#38f9d7);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="📈" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="avgUsersPerDayLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="New Users / Day" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="usersLast7Badge" text="—"
                                               style="-fx-background-color:rgba(67,233,123,0.2);-fx-text-fill:#43e97b;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ══ CHANNEL KPI ROW ══ -->
                    <HBox spacing="16">
                        <!-- Total Channels -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,120,120,0.18);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#ff6a88,#ff8e53);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="💬" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="totalChannelsLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Total Channels" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="channelGrowthBadge" text="—"
                                               style="-fx-background-color:rgba(255,106,136,0.20);-fx-text-fill:#ff7f9f;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                        <Label text="this month" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Approved Channels -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(67,233,123,0.18);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#43e97b,#38f9d7);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="✔" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="approvedChannelsLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Approved Channels" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="approvedChannelsSmallLabel" text="—"
                                               style="-fx-background-color:rgba(67,233,123,0.20);-fx-text-fill:#43e97b;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- Pending Channels -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,193,7,0.18);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#f6d365,#fda085);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="⏳" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="pendingChannelsDashboardLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="Pending Channels" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="pendingChannelsSmallLabel" text="—"
                                               style="-fx-background-color:rgba(255,193,7,0.20);-fx-text-fill:#ffc107;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <!-- New Channels / 7 Days -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(79,172,254,0.18);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:25;">
                            <HBox alignment="CENTER_LEFT" spacing="14">
                                <StackPane style="-fx-background-color:linear-gradient(to bottom right,#4facfe,#00f2fe);-fx-background-radius:15;-fx-min-width:70;-fx-min-height:70;-fx-max-width:70;-fx-max-height:70;">
                                    <Label text="📣" style="-fx-font-size:30;"/>
                                </StackPane>
                                <VBox spacing="4">
                                    <Label fx:id="channelsLast7DaysLabel" text="—" style="-fx-font-size:32;-fx-font-weight:bold;-fx-text-fill:white;"/>
                                    <Label text="New Channels / 7 Days" style="-fx-font-size:14;-fx-text-fill:rgba(255,255,255,0.7);"/>
                                    <HBox spacing="6">
                                        <Label fx:id="channelsThisMonthBadge" text="—"
                                               style="-fx-background-color:rgba(79,172,254,0.20);-fx-text-fill:#4facfe;-fx-background-radius:6;-fx-padding:2 8 2 8;-fx-font-size:11;-fx-font-weight:bold;"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- ══ CHARTS ROW — LineChart + PieChart ══ -->
                    <HBox spacing="16">
                        <!-- LineChart — activité 7 jours -->
                        <VBox spacing="12" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                            <Label text="📊  Last 7 Days Activity"
                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14;"/>
                            <LineChart fx:id="activityLineChart"
                                       prefHeight="220" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                                       style="-fx-background-color:transparent;-fx-padding:0;">
                                <xAxis>
                                    <CategoryAxis fx:id="lineChartXAxis"
                                                  style="-fx-tick-label-fill:rgba(255,255,255,0.5);-fx-tick-mark-fill:transparent;"/>
                                </xAxis>
                                <yAxis>
                                    <NumberAxis fx:id="lineChartYAxis" minorTickVisible="false"
                                                style="-fx-tick-label-fill:rgba(255,255,255,0.5);"/>
                                </yAxis>
                            </LineChart>
                        </VBox>

                        <!-- PieChart — répartition users -->
                        <VBox spacing="12" prefWidth="320"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                            <Label text="🥧  User Distribution"
                                   style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14;"/>
                            <PieChart fx:id="userPieChart"
                                      prefHeight="200" labelsVisible="true"
                                      style="-fx-background-color:transparent;"/>
                            <VBox spacing="6" style="-fx-padding:8 0 0 0;">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane style="-fx-background-color:#667eea;-fx-background-radius:4;-fx-min-width:12;-fx-min-height:12;-fx-max-width:12;-fx-max-height:12;"/>
                                    <Label text="Regular Users" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="regularUsersLabel" text="—" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane style="-fx-background-color:#f093fb;-fx-background-radius:4;-fx-min-width:12;-fx-min-height:12;-fx-max-width:12;-fx-max-height:12;"/>
                                    <Label text="Coaches" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="coachesCountLabel" text="—" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <StackPane style="-fx-background-color:#4facfe;-fx-background-radius:4;-fx-min-width:12;-fx-min-height:12;-fx-max-width:12;-fx-max-height:12;"/>
                                    <Label text="Admins" style="-fx-text-fill:rgba(255,255,255,0.6);-fx-font-size:12;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="adminsCountLabel" text="—" style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:12;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>

                    <!-- ══ BarChart — comparaison mensuelle ══ -->
                    <VBox spacing="12"
                          style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                        <Label text="📅  Monthly Comparison (This Month vs Last Month)"
                               style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:14;"/>
                        <BarChart fx:id="monthlyBarChart" prefHeight="200"
                                  style="-fx-background-color:transparent;">
                            <xAxis><CategoryAxis style="-fx-tick-label-fill:rgba(255,255,255,0.5);"/></xAxis>
                            <yAxis><NumberAxis minorTickVisible="false" style="-fx-tick-label-fill:rgba(255,255,255,0.5);"/></yAxis>
                        </BarChart>
                    </VBox>

                    <!-- ══ USER STATISTICS ══ -->
                    <Label text="👥  User Statistics"
                           style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                    <HBox spacing="16">
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                              style="-fx-background-color:rgba(255,255,255,0.04);-fx-border-color:rgba(255,255,255,0.08);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                            <Label fx:id="totalUsersLabel2" text="—" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <Label text="Total" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                              style="-fx-background-color:rgba(67,233,123,0.06);-fx-border-color:rgba(67,233,123,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                            <Label fx:id="activeUsersLabel" text="—" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#43e97b;"/>
                            <Label text="Active" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                              style="-fx-background-color:rgba(255,193,7,0.06);-fx-border-color:rgba(255,193,7,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                            <Label fx:id="suspendedUsersLabel" text="—" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ffc107;"/>
                            <Label text="Suspended" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                              style="-fx-background-color:rgba(255,60,100,0.06);-fx-border-color:rgba(255,60,100,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                            <Label fx:id="bannedUsersLabel" text="—" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#ff3c64;"/>
                            <Label text="Banned" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                              style="-fx-background-color:rgba(90,103,216,0.06);-fx-border-color:rgba(90,103,216,0.2);-fx-border-radius:14;-fx-background-radius:14;-fx-border-width:1;-fx-padding:20;">
                            <Label fx:id="userGrowthRateLabel" text="—" style="-fx-font-size:28;-fx-font-weight:bold;-fx-text-fill:#818cf8;"/>
                            <Label text="Growth Rate" style="-fx-font-size:11;-fx-text-fill:rgba(255,255,255,0.45);"/>
                        </VBox>
                    </HBox>

                    <!-- ══ ADVANCED METRICS avec ProgressBar améliorées ══ -->
                    <Label text="📊  Advanced Metrics"
                           style="-fx-text-fill:white;-fx-font-weight:bold;-fx-font-size:15;"/>
                    <HBox spacing="16">
                        <!-- Activation Rate -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="✔" style="-fx-font-size:18;-fx-text-fill:#43e97b;"/>
                                <Label text="Activation Rate" style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:13;"/>
                            </HBox>
                            <Label fx:id="activeUsersPercentageLabel" text="—"
                                   style="-fx-font-size:34;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <ProgressBar fx:id="activeUsersProgress" progress="0" maxWidth="Infinity"
                                         style="-fx-accent:#43e97b;-fx-pref-height:8;-fx-background-radius:10;-fx-background-color:rgba(255,255,255,0.1);"/>
                            <Label fx:id="activeUsersDetailLabel" text="—"
                                   style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.55);"/>
                        </VBox>
                        <!-- Members/Team -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="👤" style="-fx-font-size:18;"/>
                                <Label text="Members / Team" style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:13;"/>
                            </HBox>
                            <Label fx:id="avgMembersPerTeamLabel" text="—"
                                   style="-fx-font-size:34;-fx-font-weight:bold;-fx-text-fill:white;"/>
                            <ProgressBar fx:id="membersProgress" progress="0" maxWidth="Infinity"
                                         style="-fx-accent:#4facfe;-fx-pref-height:8;-fx-background-radius:10;-fx-background-color:rgba(255,255,255,0.1);"/>
                            <Label fx:id="totalMembersLabel" text="—"
                                   style="-fx-font-size:12;-fx-text-fill:rgba(255,255,255,0.55);"/>
                        </VBox>
                        <!-- Approval Rate -->
                        <VBox spacing="10" HBox.hgrow="ALWAYS"
                              style="-fx-background-color:rgba(255,255,255,0.05);-fx-border-color:rgba(255,255,255,0.1);-fx-border-radius:15;-fx-background-radius:15;-fx-border-width:1;-fx-padding:20;">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label text="✅" style="-fx-font-size:18;"/>
                                <Label text="Approval Rate" style="-fx-text-fill:rgba(255,255,255,0.7);-fx-font-size:13;"/>
                            </HBox>
                            <Label fx:id="approvalRateLabel" text="—"
