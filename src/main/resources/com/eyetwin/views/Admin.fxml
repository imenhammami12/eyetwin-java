<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    Admin.fxml — Miroir de templates/admin/layout.html.twig + admin/dashboard.html.twig
    Routes Symfony : /admin → admin_index, /admin/dashboard → admin_dashboard
    Controller     : AdminDashboardController.java
-->
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminDashboardController"
            style="-fx-background-color: #0d0618;"
            prefWidth="1280" prefHeight="800">

    <left>
        <fx:include source="admin-sidebar.fxml" fx:id="adminSidebar"/>
    </left>

    <top>
        <fx:include source="admin-topbar.fxml" fx:id="adminTopbar"/>
    </top>



    <!-- ══════════════════════════════════════════════════
         MAIN CONTENT — miroir de <main class="main-content">
    ══════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #0d0618; -fx-background: #0d0618;
                           -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 24; -fx-background-color: #0d0618;">

                <!-- ── Stats Users — miroir des cards du dashboard Symfony ── -->
                <Label text="👥 User Statistics"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <!-- Total Users -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total Users"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Active Users -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="activeUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Active"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Suspended -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,193,7,0.06);
                                 -fx-border-color: rgba(255,193,7,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="suspendedUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ffc107;"/>
                        <Label text="Suspended"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Banned -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,60,100,0.06);
                                 -fx-border-color: rgba(255,60,100,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="bannedUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff3c64;"/>
                        <Label text="Banned"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Growth Rate -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(90,103,216,0.06);
                                 -fx-border-color: rgba(90,103,216,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="userGrowthRateLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #818cf8;"/>
                        <Label text="Growth Rate"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ── Stats Teams ── -->
                <Label text="🔲 Team Statistics"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalTeamsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total Teams"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="activeTeamsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Active Teams"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ── Stats Applications ── -->
                <Label text="✅ Coach Applications"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,193,7,0.06);
                                 -fx-border-color: rgba(255,193,7,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="pendingApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ffc107;"/>
                        <Label text="Pending"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="approvedApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Approved"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,60,100,0.06);
                                 -fx-border-color: rgba(255,60,100,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="rejectedApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff3c64;"/>
                        <Label text="Rejected"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(90,103,216,0.06);
                                 -fx-border-color: rgba(90,103,216,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="approvalRateLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #818cf8;"/>
                        <Label text="Approval Rate"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
