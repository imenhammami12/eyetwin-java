<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
    Admin.fxml — Miroir de templates/admin/layout.html.twig + admin/dashboard.html.twig
    Routes Symfony : /admin → admin_index, /admin/dashboard → admin_dashboard
    Controller     : AdminDashboardController.java
-->

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminDashboardController"
            style="-fx-background-color: #0d0618;"
            prefWidth="1280" prefHeight="800">

    <!-- ══════════════════════════════════════════════════
         SIDEBAR — miroir de <aside class="sidebar">
    ══════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #0d0618;
                     -fx-border-color: rgba(255,60,100,0.15);
                     -fx-border-width: 0 1 0 0;
                     -fx-pref-height: 800;">

            <!-- Header sidebar — miroir de .sidebar-header -->
            <VBox alignment="CENTER" style="-fx-padding: 20 20 16 20;
                                            -fx-border-color: transparent transparent rgba(255,60,100,0.12) transparent;
                                            -fx-border-width: 0 0 1 0;">
                <ImageView fitWidth="160" fitHeight="45" preserveRatio="true"
                           onMouseClicked="#goToDashboard" style="-fx-cursor: hand;">
                    <image><Image url="@../../assets/img/eyetwin-logo.png"/></image>
                </ImageView>
            </VBox>

            <!-- ── Navigation — miroir de <nav class="sidebar-menu"> ── -->
            <VBox fx:id="sidebarNav" spacing="2" style="-fx-padding: 12 10 12 10;"
                  VBox.vgrow="ALWAYS">

                <!-- Dashboard — active -->
                <Button fx:id="navDashboard" text="⚡  Dashboard"
                        onAction="#goToDashboard" maxWidth="Infinity"
                        style="-fx-background-color: rgba(255,60,100,0.12);
                               -fx-border-color: rgba(255,60,100,0.35);
                               -fx-border-radius: 10; -fx-background-radius: 10;
                               -fx-border-width: 1; -fx-text-fill: white;
                               -fx-font-size: 12; -fx-font-weight: bold;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand;"/>

                <!-- Users -->
                <Button text="👥  Users" onAction="#goToUsers"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent;
                               -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55);
                               -fx-font-size: 12; -fx-alignment: CENTER_LEFT;
                               -fx-padding: 11 14 11 14; -fx-cursor: hand;
                               -fx-background-radius: 10;"/>

                <!-- Planning -->
                <Button text="📅  Planning" onAction="#goToPlanning"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Tournaments -->
                <Button text="🏆  Tournaments" onAction="#goToTournaments"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Videos -->
                <Button text="🎬  Videos" onAction="#goToVideos"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Coach Applications — avec badge pending -->
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Button text="✅  Coach Applications" onAction="#goToCoachApplications"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                                   -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                                   -fx-cursor: hand; -fx-background-radius: 10;"/>
                    <Label fx:id="pendingApplicationsBadge" text="0"
                           visible="false" managed="false"
                           style="-fx-background-color: #e8372a; -fx-text-fill: white;
                                  -fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-background-radius: 10; -fx-padding: 2 7 2 7;"/>
                </HBox>

                <!-- Channels -->
                <Button text="💬  Channels" onAction="#goToChannels"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Complaints — avec badge pending -->
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Button text="🎧  Complaints" onAction="#goToComplaints"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-border-color: transparent;
                                   -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                                   -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                                   -fx-cursor: hand; -fx-background-radius: 10;"/>
                    <Label fx:id="pendingComplaintsBadge" text="0"
                           visible="false" managed="false"
                           style="-fx-background-color: #e8372a; -fx-text-fill: white;
                                  -fx-font-size: 10; -fx-font-weight: bold;
                                  -fx-background-radius: 10; -fx-padding: 2 7 2 7;"/>
                </HBox>

                <!-- Messages -->
                <Button text="📨  Messages" onAction="#goToMessages"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Teams -->
                <Button text="🔲  Teams" onAction="#goToTeams"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Audit Logs — miroir : {% if is_granted('ROLE_SUPER_ADMIN') %} -->
                <Button fx:id="navAuditLogs" text="📋  Audit Logs"
                        onAction="#goToAuditLogs"
                        maxWidth="Infinity" visible="false" managed="false"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.55); -fx-font-size: 12;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 11 14 11 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>

                <!-- Divider — miroir de .sidebar-divider -->
                <Region style="-fx-background-color: rgba(255,255,255,0.07);
                               -fx-pref-height: 1; -fx-max-height: 1;
                               -fx-margin: 6 0 6 0;"/>

                <!-- View Site — miroir du lien "View Site" → path('app_home') -->
                <Button text="🌐  View Site ↗" onAction="#goToSite"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;
                               -fx-text-fill: rgba(255,255,255,0.35); -fx-font-size: 11;
                               -fx-alignment: CENTER_LEFT; -fx-padding: 9 14 9 14;
                               -fx-cursor: hand; -fx-background-radius: 10;"/>
            </VBox>

            <!-- Logout button — miroir de <a class="logout-btn"> -->
            <Button text="🚪  Logout" onAction="#handleLogout"
                    maxWidth="Infinity"
                    style="-fx-background-color: rgba(255,60,100,0.08);
                           -fx-border-color: rgba(255,60,100,0.2);
                           -fx-border-width: 1 0 0 0; -fx-border-radius: 0;
                           -fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12;
                           -fx-alignment: CENTER_LEFT; -fx-padding: 16 20 16 20;
                           -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════════
         TOP BAR — miroir de <header class="top-bar">
    ══════════════════════════════════════════════════ -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" prefHeight="64"
              style="-fx-background-color: #0d0618;
                     -fx-border-color: rgba(255,60,100,0.25);
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 0 24 0 24;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.6),20,0,0,2);">

            <!-- Titre de page — miroir de h1.page-title -->
            <Label fx:id="pageTitle" text="Dashboard"
                   HBox.hgrow="ALWAYS"
                   style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 17;
                          -fx-padding: 0 0 0 14;"/>

            <!-- Actions header — miroir de .header-actions -->
            <HBox alignment="CENTER" spacing="12">

                <!-- Profile dropdown — miroir de .user-info.dropdown -->
                <MenuButton style="-fx-background-color: transparent;
                                   -fx-border-color: rgba(255,255,255,0.1);
                                   -fx-border-radius: 10; -fx-background-radius: 10;
                                   -fx-border-width: 1; -fx-padding: 6 12 6 8;
                                   -fx-mark-color: rgba(255,255,255,0.3); -fx-cursor: hand;">
                    <graphic>
                        <HBox alignment="CENTER" spacing="8">
                            <Label fx:id="usernameLabel" text="Admin"
                                   style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 12;"/>
                            <!-- Avatar circle — miroir de .user-avatar -->
                            <StackPane style="-fx-background-color: linear-gradient(135deg,#ff3c64,#ff1744);
                                              -fx-background-radius: 50;
                                              -fx-min-width: 34; -fx-min-height: 34;
                                              -fx-max-width: 34; -fx-max-height: 34;">
                                <Label fx:id="userAvatarInitial" text="A"
                                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 13;"/>
                            </StackPane>
                        </HBox>
                    </graphic>
                    <items>
                        <!-- My Profile — miroir path('app_profile') -->
                        <MenuItem text="👤  My Profile"     onAction="#goToProfile"/>
                        <!-- Face Recognition — miroir path('app_profile_face_register') -->
                        <MenuItem text="📷  Face Recognition" onAction="#goToFaceRegister"/>
                        <SeparatorMenuItem/>
                        <!-- Logout — miroir path('admin_logout') -->
                        <MenuItem text="🚪  Logout"         onAction="#handleLogout"
                                  style="-fx-text-fill: #ff3c64;"/>
                    </items>
                </MenuButton>
            </HBox>
        </HBox>
    </top>

    <!-- ══════════════════════════════════════════════════
         MAIN CONTENT — miroir de <main class="main-content">
    ══════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: #0d0618; -fx-background: #0d0618;
                           -fx-border-color: transparent;">
            <VBox spacing="24" style="-fx-padding: 24; -fx-background-color: #0d0618;">

                <!-- ── Stats Users — miroir des cards du dashboard Symfony ── -->
                <Label text="👥 User Statistics"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <!-- Total Users -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total Users"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Active Users -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="activeUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Active"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Suspended -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,193,7,0.06);
                                 -fx-border-color: rgba(255,193,7,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="suspendedUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ffc107;"/>
                        <Label text="Suspended"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Banned -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,60,100,0.06);
                                 -fx-border-color: rgba(255,60,100,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="bannedUsersLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff3c64;"/>
                        <Label text="Banned"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <!-- Growth Rate -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(90,103,216,0.06);
                                 -fx-border-color: rgba(90,103,216,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="userGrowthRateLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #818cf8;"/>
                        <Label text="Growth Rate"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ── Stats Teams ── -->
                <Label text="🔲 Team Statistics"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalTeamsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total Teams"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="activeTeamsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Active Teams"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

                <!-- ── Stats Applications ── -->
                <Label text="✅ Coach Applications"
                       style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15;"/>
                <HBox spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,255,255,0.04);
                                 -fx-border-color: rgba(255,255,255,0.08);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="totalApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: white;"/>
                        <Label text="Total"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,193,7,0.06);
                                 -fx-border-color: rgba(255,193,7,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="pendingApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ffc107;"/>
                        <Label text="Pending"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(67,233,123,0.06);
                                 -fx-border-color: rgba(67,233,123,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="approvedApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #43e97b;"/>
                        <Label text="Approved"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(255,60,100,0.06);
                                 -fx-border-color: rgba(255,60,100,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="rejectedApplicationsLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #ff3c64;"/>
                        <Label text="Rejected"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                    <VBox spacing="6" HBox.hgrow="ALWAYS" alignment="CENTER"
                          style="-fx-background-color: rgba(90,103,216,0.06);
                                 -fx-border-color: rgba(90,103,216,0.2);
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-border-width: 1; -fx-padding: 20;">
                        <Label fx:id="approvalRateLabel" text="—"
                               style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #818cf8;"/>
                        <Label text="Approval Rate"
                               style="-fx-font-size: 11; -fx-text-fill: rgba(255,255,255,0.45);"/>
                    </VBox>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
