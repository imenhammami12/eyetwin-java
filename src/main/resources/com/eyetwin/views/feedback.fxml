<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<StackPane fx:id="mainStack"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.eyetwin.controller.FeedbackController"
           style="-fx-background-color:#0a0514;">

    <!-- ══════════════════════════════════════════════════════
         VIEW : FORM
    ══════════════════════════════════════════════════════ -->
    <VBox fx:id="viewForm"
          alignment="TOP_CENTER"
          spacing="0"
          style="-fx-background-color:#0a0514;">

        <!-- Gradient top bar -->
        <Rectangle height="5" fill="transparent"
                   style="-fx-fill:linear-gradient(to right, #ff3c64, #a78bfa, #4facfe);"
                   maxWidth="Infinity"/>

        <!-- Scrollable content -->
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER"
                    style="-fx-background:transparent;-fx-background-color:transparent;
                           -fx-border-color:transparent;">
            <VBox spacing="24" alignment="TOP_CENTER"
                  style="-fx-padding:40 0 40 0;">

                <!-- ── HEADER ─────────────────────────────── -->
                <VBox alignment="CENTER" spacing="8"
                      style="-fx-padding:0 40 0 40;">

                    <!-- Icon circle -->
                    <StackPane maxWidth="64" maxHeight="64"
                               minWidth="64" minHeight="64">
                        <Circle radius="32"
                                style="-fx-fill:linear-gradient(to bottom right,#ff3c64,#764ba2);"/>
                        <Label text="📋"
                               style="-fx-font-size:24;"/>
                    </StackPane>

                    <Label text="Post-Stream Feedback"
                           style="-fx-text-fill:white;-fx-font-size:22;
                                  -fx-font-weight:bold;"/>

                    <Label fx:id="streamTitleLabel"
                           text="Stream : —"
                           style="-fx-text-fill:rgba(255,255,255,0.45);
                                  -fx-font-size:13;"/>

                    <!-- Gradient divider -->
                    <Rectangle height="1" maxWidth="Infinity"
                               style="-fx-fill:linear-gradient(to right,
                                      transparent,
                                      rgba(255,60,100,0.40),
                                      transparent);"/>
                </VBox>

                <!-- ── CARD ───────────────────────────────── -->
                <VBox spacing="22" maxWidth="540"
                      style="-fx-background-color:#0d0618;
                             -fx-border-color:rgba(255,60,100,0.22);
                             -fx-border-width:1;
                             -fx-border-radius:18;
                             -fx-background-radius:18;
                             -fx-padding:32 36;
                             -fx-effect:dropshadow(gaussian,rgba(255,60,100,0.10),24,0,0,6);">

                    <!-- ── RATING ─────────────────────────── -->
                    <VBox spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⭐"  style="-fx-font-size:14;"/>
                            <Label text="Your Rating"
                                   style="-fx-text-fill:white;-fx-font-size:14;
                                          -fx-font-weight:bold;"/>
                            <Label fx:id="ratingValueLabel" text="3 / 5"
                                   style="-fx-text-fill:#ff3c64;-fx-font-size:13;
                                          -fx-font-weight:bold;
                                          -fx-background-color:rgba(255,60,100,0.10);
                                          -fx-border-color:rgba(255,60,100,0.28);
                                          -fx-border-radius:20;-fx-background-radius:20;
                                          -fx-padding:2 12;"/>
                        </HBox>

                        <Slider fx:id="ratingSlider"
                                min="1" max="5" value="3"
                                majorTickUnit="1" minorTickCount="0"
                                snapToTicks="true" showTickLabels="true"
                                showTickMarks="true"
                                style="-fx-control-inner-background:rgba(255,255,255,0.06);
                                       -fx-accent:#ff3c64;"/>

                        <!-- Stars row -->
                        <HBox alignment="CENTER" spacing="6">
                            <Label text="😡" style="-fx-font-size:16;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="😐" style="-fx-font-size:16;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="😊" style="-fx-font-size:16;"/>
                        </HBox>

                        <!-- Rating hint -->
                        <Label text="1–2 → Complaint generated  |  3 → Both  |  4–5 → Review"
                               style="-fx-text-fill:rgba(255,255,255,0.28);
                                      -fx-font-size:10;-fx-font-style:italic;"/>
                    </VBox>

                    <!-- Separator -->
                    <Rectangle height="1" maxWidth="Infinity"
                               style="-fx-fill:rgba(255,255,255,0.06);"/>

                    <!-- ── COMMENT ─────────────────────────── -->
                    <VBox spacing="8">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="💬" style="-fx-font-size:14;"/>
                            <Label text="Your Comment"
                                   style="-fx-text-fill:white;-fx-font-size:14;
                                          -fx-font-weight:bold;"/>
                        </HBox>

                        <TextArea fx:id="commentArea"
                                  promptText="Share your experience about this stream…"
                                  prefRowCount="5" wrapText="true"
                                  style="-fx-background-color:rgba(255,255,255,0.04);
                                         -fx-border-color:rgba(255,255,255,0.09);
                                         -fx-border-radius:10;-fx-background-radius:10;
                                         -fx-text-fill:white;
                                         -fx-prompt-text-fill:rgba(255,255,255,0.28);
                                         -fx-font-size:13;-fx-padding:12 14;"/>

                        <Label fx:id="errComment" text=""
                               visible="false" managed="false"
                               style="-fx-text-fill:#ff6b7a;-fx-font-size:11;"/>
                    </VBox>

                    <!-- ── GENERAL ERROR ───────────────────── -->
                    <Label fx:id="errGeneral" text=""
                           visible="false" managed="false"
                           wrapText="true"
                           style="-fx-text-fill:#ff6b7a;-fx-font-size:12;
                                  -fx-background-color:rgba(255,60,100,0.08);
                                  -fx-border-color:rgba(255,60,100,0.25);
                                  -fx-border-radius:8;-fx-background-radius:8;
                                  -fx-padding:10 14;"/>

                    <!-- ── BUTTONS ─────────────────────────── -->
                    <HBox spacing="12" alignment="CENTER_RIGHT">

                        <Button fx:id="cancelBtn" text="Cancel"
                                onAction="#handleCancel"
                                style="-fx-background-color:rgba(255,255,255,0.04);
                                       -fx-border-color:rgba(255,255,255,0.10);
                                       -fx-border-radius:10;-fx-background-radius:10;
                                       -fx-text-fill:rgba(255,255,255,0.50);
                                       -fx-font-size:13;-fx-font-weight:bold;
                                       -fx-padding:12 28;-fx-cursor:hand;"/>

                        <Button fx:id="submitBtn" text="🚀  Submit Feedback"
                                onAction="#handleSubmit"
                                style="-fx-background-color:linear-gradient(to right,#ff3c64,#c0132f);
                                       -fx-border-color:transparent;
                                       -fx-border-radius:10;-fx-background-radius:10;
                                       -fx-text-fill:white;-fx-font-size:13;
                                       -fx-font-weight:bold;-fx-padding:12 28;
                                       -fx-cursor:hand;
                                       -fx-effect:dropshadow(gaussian,rgba(255,60,100,0.35),12,0,0,3);"/>
                    </HBox>

                </VBox>

                <!-- ── FOOTER ─────────────────────────────── -->
                <Label text="© 2025 EyeTwin E-Sport Platform"
                       style="-fx-text-fill:rgba(255,255,255,0.15);-fx-font-size:10;"/>
            </VBox>
        </ScrollPane>
    </VBox>

    <!-- ══════════════════════════════════════════════════════
         VIEW : SUCCESS
    ══════════════════════════════════════════════════════ -->
    <VBox fx:id="viewSuccess"
          visible="false" managed="false"
          alignment="CENTER" spacing="24"
          style="-fx-background-color:#0a0514;-fx-padding:60 40;">

        <!-- Success circle -->
        <StackPane maxWidth="90" maxHeight="90"
                   minWidth="90" minHeight="90">
            <Circle radius="45"
                    style="-fx-fill:rgba(61,214,140,0.12);
                           -fx-stroke:rgba(61,214,140,0.40);
                           -fx-stroke-width:2;"/>
            <Label text="✅" style="-fx-font-size:36;"/>
        </StackPane>

        <Label text="Feedback Submitted!"
               style="-fx-text-fill:white;-fx-font-size:22;-fx-font-weight:bold;"/>

        <Label fx:id="successMessage" text=""
               wrapText="true" textAlignment="CENTER"
               style="-fx-text-fill:rgba(255,255,255,0.55);
                      -fx-font-size:14;-fx-max-width:400;"/>

        <!-- Gradient divider -->
        <Rectangle height="1" maxWidth="300"
                   style="-fx-fill:linear-gradient(to right,
                          transparent,rgba(255,60,100,0.40),transparent);"/>

        <Button text="← Back to Streams"
                onAction="#handleCancel"
                style="-fx-background-color:linear-gradient(to right,#ff3c64,#c0132f);
                       -fx-border-color:transparent;
                       -fx-border-radius:10;-fx-background-radius:10;
                       -fx-text-fill:white;-fx-font-size:13;-fx-font-weight:bold;
                       -fx-padding:13 32;-fx-cursor:hand;
                       -fx-effect:dropshadow(gaussian,rgba(255,60,100,0.35),12,0,0,3);"/>

        <Label text="© 2025 EyeTwin E-Sport Platform"
               style="-fx-text-fill:rgba(255,255,255,0.15);-fx-font-size:10;"/>
    </VBox>

</StackPane>