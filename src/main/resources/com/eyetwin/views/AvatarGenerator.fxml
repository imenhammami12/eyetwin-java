<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.eyetwin.controller.AvatarGeneratorController"
      spacing="16" style="-fx-background-color: #0d0c1a; -fx-padding: 28;">

    <Label text="✦  AI Avatar Generator"
           style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: 900;"/>
    <Label text="Describe your appearance — FLUX.1 generates your avatar in ~15 seconds"
           style="-fx-text-fill: rgba(255,255,255,0.45); -fx-font-size: 12;" wrapText="true"/>

    <VBox spacing="6">
        <Label text="Description" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 700;"/>
        <TextField fx:id="descriptionField"
                   promptText="e.g. young woman with long black hair, glasses, smiling"
                   style="-fx-background-color: #13132a; -fx-text-fill: white;
                          -fx-border-color: rgba(102,126,234,0.4); -fx-border-radius: 8;
                          -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 13;"/>
    </VBox>

    <VBox spacing="6">
        <Label text="Style" style="-fx-text-fill: rgba(255,255,255,0.7); -fx-font-weight: 700;"/>
        <ComboBox fx:id="styleCombo" maxWidth="1.7976931348623157E308"
                  style="-fx-background-color: #13132a; -fx-text-fill: white;
                         -fx-border-color: rgba(102,126,234,0.4); -fx-border-radius: 8;
                         -fx-background-radius: 8;"/>
    </VBox>

    <Button fx:id="generateBtn" text="✦  Generate Avatar"
            maxWidth="1.7976931348623157E308"
            onAction="#handleGenerate"
            style="-fx-background-color: linear-gradient(90deg,#667eea,#764ba2);
                   -fx-text-fill: white; -fx-font-weight: 900; -fx-font-size: 14;
                   -fx-background-radius: 10; -fx-padding: 14; -fx-cursor: hand; -fx-border-width: 0;"/>

    <!-- Loading -->
    <VBox fx:id="loadingBox" alignment="CENTER" spacing="10"
          style="-fx-padding: 20;" visible="false" managed="false">
        <ProgressIndicator style="-fx-progress-color: #667eea;" prefWidth="50" prefHeight="50"/>
        <Label text="FLUX.1 is generating your avatar..."
               style="-fx-text-fill: rgba(255,255,255,0.6); -fx-font-size: 13;"/>
    </VBox>

    <!-- Result -->
    <VBox fx:id="resultBox" alignment="CENTER" spacing="12"
          visible="false" managed="false">
        <ImageView fx:id="resultImageView" fitWidth="200" fitHeight="200" preserveRatio="true"/>
        <Button fx:id="applyBtn" text="✔  Apply as Profile Picture"
                maxWidth="1.7976931348623157E308"
                onAction="#handleApply"
                style="-fx-background-color: #00e676; -fx-text-fill: #080810;
                       -fx-font-weight: 900; -fx-font-size: 13;
                       -fx-background-radius: 10; -fx-padding: 12; -fx-cursor: hand; -fx-border-width: 0;"/>
    </VBox>

    <Label fx:id="statusLabel" text="" wrapText="true"
           style="-fx-text-fill: rgba(255,255,255,0.5); -fx-font-size: 12;"/>

    <Button text="Close" onAction="#handleClose" maxWidth="1.7976931348623157E308"
            style="-fx-background-color: rgba(255,255,255,0.06); -fx-text-fill: rgba(255,255,255,0.5);
                   -fx-border-width: 0; -fx-background-radius: 8; -fx-padding: 10; -fx-cursor: hand;"/>
</VBox>