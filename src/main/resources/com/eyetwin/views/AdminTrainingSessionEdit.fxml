<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.eyetwin.controller.admin.AdminTrainingSessionEditController"
            styleClass="admin-planning-root"
            stylesheets="@../styles/admin-planning.css"
            prefWidth="1280" prefHeight="800">

    <left><fx:include source="AdminSidebar.fxml" fx:id="adminSidebar"/></left>
    <top><fx:include source="AdminTopbar.fxml" fx:id="adminTopbar"/></top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="page-scroll">
            <content>
                <VBox styleClass="page-content" spacing="14">

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Region prefWidth="3" prefHeight="18" style="-fx-background-color:#ff3c64; -fx-background-radius:2;"/>
                        <Label text="Edit Session" styleClass="card-title"/>
                    </HBox>

                    <HBox alignment="TOP_CENTER">
                        <VBox styleClass="form-card" maxWidth="860" prefWidth="860">
                            <HBox styleClass="form-header" alignment="CENTER_LEFT" spacing="10">
                                <Label text="✎" style="-fx-text-fill:white; -fx-font-size: 18; -fx-font-weight: 800;"/>
                                <Label text="Edit Session Status" styleClass="form-header-title"/>
                            </HBox>

                            <VBox styleClass="form-content" spacing="14">

                                <GridPane hgap="14" vgap="10">
                                    <columnConstraints>
                                        <ColumnConstraints percentWidth="50"/>
                                        <ColumnConstraints percentWidth="50"/>
                                    </columnConstraints>

                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                        <Label text="PARTICIPANT" styleClass="form-label"/>
                                        <VBox style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 12; -fx-padding: 14;" spacing="6">
                                            <HBox spacing="10" alignment="CENTER_LEFT">
                                                <Label fx:id="avatarLabel" text="U" style="-fx-background-color: rgba(99,102,241,0.25); -fx-text-fill:white; -fx-font-weight:900; -fx-alignment:center; -fx-min-width:42; -fx-min-height:42; -fx-background-radius: 999;"/>
                                                <VBox spacing="2">
                                                    <Label fx:id="usernameLabel" text="—" style="-fx-text-fill:#e2e8f0; -fx-font-weight:900;"/>
                                                    <Label fx:id="emailLabel" text="—" style="-fx-text-fill: rgba(226,232,240,0.7); -fx-font-weight:800;"/>
                                                </VBox>
                                            </HBox>
                                        </VBox>
                                    </VBox>

                                    <VBox spacing="6" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                        <Label text="REGISTRATION DATE" styleClass="form-label"/>
                                        <VBox style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 12; -fx-padding: 14;" spacing="6">
                                            <Label fx:id="regDateLabel" text="—" style="-fx-text-fill:#e2e8f0; -fx-font-weight:900;"/>
                                            <Label fx:id="regTimeLabel" text="—" style="-fx-text-fill: rgba(226,232,240,0.7); -fx-font-weight:800;"/>
                                        </VBox>
                                    </VBox>

                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="2">
                                        <Label text="PLANNING SESSION" styleClass="form-label"/>
                                        <VBox style="-fx-background-color: rgba(255,255,255,0.06); -fx-background-radius: 12; -fx-padding: 14;" spacing="6">
                                            <Label fx:id="planningDesc" text="—" style="-fx-text-fill:#e2e8f0; -fx-font-weight:900;"/>
                                            <HBox spacing="10">
                                                <Label fx:id="planningType" text="—" style="-fx-background-color: rgba(59,130,246,0.22); -fx-text-fill:#93c5fd; -fx-padding: 3 10; -fx-background-radius: 999; -fx-font-weight:900; -fx-font-size: 11;"/>
                                                <Label fx:id="planningLevel" text="—" style="-fx-background-color: rgba(99,102,241,0.22); -fx-text-fill:#a5b4fc; -fx-padding: 3 10; -fx-background-radius: 999; -fx-font-weight:900; -fx-font-size: 11;"/>
                                                <Region HBox.hgrow="ALWAYS"/>
                                                <Label fx:id="planningMeta" text="—" style="-fx-text-fill: rgba(226,232,240,0.7); -fx-font-weight:800;"/>
                                            </HBox>
                                            <Label fx:id="planningLocation" text="—" wrapText="true" style="-fx-text-fill: rgba(226,232,240,0.7); -fx-font-weight:800;"/>
                                        </VBox>
                                    </VBox>

                                    <VBox spacing="6" GridPane.columnIndex="0" GridPane.rowIndex="2" GridPane.columnSpan="2">
                                        <Label text="SESSION STATUS *" styleClass="form-label"/>
                                        <ComboBox fx:id="statusCombo"/>
                                    </VBox>
                                </GridPane>

                                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="form-actions">
                                    <Button text="Update Session" onAction="#handleUpdate" styleClass="success-btn" prefWidth="180"/>
                                    <Button text="Cancel" onAction="#handleCancel" styleClass="outline-btn" prefWidth="130"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="errorLabel" text="" style="-fx-text-fill:#fb7185; -fx-font-weight:700;"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>

