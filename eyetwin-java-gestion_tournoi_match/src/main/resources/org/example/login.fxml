<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<StackPane prefHeight="700.0" prefWidth="1050.0" styleClass="login-root"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controllers.LoginController">
    <stylesheets><URL value="@gaming-theme.css"/></stylesheets>

    <VBox alignment="CENTER" spacing="30" maxWidth="450" styleClass="login-card">
        <VBox alignment="CENTER" spacing="10">
            <Label text="⚔" style="-fx-font-size:48px;-fx-text-fill:#e63946;"/>
            <Label text="ARENA LOGIN" styleClass="login-title"/>
            <Label text="Sign in to your account to continue" styleClass="login-subtitle"/>
        </VBox>

        <VBox spacing="20">
            <VBox spacing="8">
                <Label text="Email Address" styleClass="field-label"/>
                <TextField fx:id="emailField" promptText="Enter your email" styleClass="login-field"/>
            </VBox>
            <VBox spacing="8">
                <Label text="Password" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password" styleClass="login-field"/>
            </VBox>
            <Label fx:id="errorLabel" styleClass="error-text" visible="false"/>
        </VBox>

        <Button text="LOGIN NOW" onAction="#handleLogin" styleClass="login-btn" maxWidth="Infinity" prefHeight="50"/>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Forgot password?" styleClass="login-footer-text"/>
            <Hyperlink text="Reset here" styleClass="login-link"/>
        </HBox>
    </VBox>
</StackPane>
