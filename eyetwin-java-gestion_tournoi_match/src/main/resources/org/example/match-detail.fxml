<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox styleClass="modal-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.controllers.MatchDetailController" minWidth="580">
    <stylesheets><URL value="@gaming-theme.css"/></stylesheets>

    <!-- Header -->
    <HBox styleClass="modal-header" alignment="CENTER_LEFT" spacing="12">
        <Label text="⚔" style="-fx-font-size:18px;-fx-text-fill:#e63946;"/>
        <VBox spacing="2">
            <Label text="Match Details" styleClass="modal-title"/>
            <Label text="Full match information" styleClass="modal-subtitle"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="idLabel" style="-fx-text-fill:#333344;-fx-font-size:12px;"/>
    </HBox>

    <!-- Body -->
    <VBox styleClass="modal-body" spacing="15" VBox.vgrow="ALWAYS">

        <!-- VS Banner -->
        <VBox styleClass="detail-section" spacing="10" alignment="CENTER">
            <Label fx:id="lblMode" styleClass="detail-badge" text="MODE"/>
            <HBox alignment="CENTER" spacing="20">
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="lblEquipe1" styleClass="detail-name" text="Team 1"/>
                </VBox>
                <Label text="VS" style="-fx-font-size:22px;-fx-font-weight:bold;-fx-text-fill:#e63946;"/>
                <VBox alignment="CENTER" spacing="4">
                    <Label fx:id="lblEquipe2" styleClass="detail-name" text="Team 2"/>
                </VBox>
            </HBox>
            <Label fx:id="lblScore" styleClass="detail-big" text="0"/>
            <Label text="SCORE" styleClass="detail-key"/>
        </VBox>

        <!-- Info -->
        <HBox spacing="15">
            <VBox styleClass="detail-section" spacing="12" HBox.hgrow="ALWAYS">
                <HBox spacing="8">
                    <Label text="📅" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="MATCH DATE" styleClass="detail-key"/>
                        <Label fx:id="lblDate" styleClass="detail-value" text="—"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Label text="📍" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="LOCATION" styleClass="detail-key"/>
                        <Label fx:id="lblLocalisation" styleClass="detail-value" text="—"/>
                    </VBox>
                </HBox>
                <HBox spacing="8">
                    <Label text="🏆" style="-fx-font-size:16px;"/>
                    <VBox spacing="2">
                        <Label text="TOURNAMENT" styleClass="detail-key"/>
                        <Label fx:id="lblTournoi" styleClass="detail-value" text="—"/>
                    </VBox>
                </HBox>
            </VBox>
            <VBox styleClass="detail-section" spacing="12" prefWidth="180" alignment="CENTER">
                <Label text="PRIZE" styleClass="detail-key"/>
                <Label fx:id="lblPrix" styleClass="detail-big" text="0 DT"/>
            </VBox>
        </HBox>

    </VBox>

    <!-- Footer -->
    <HBox styleClass="modal-footer" alignment="CENTER_RIGHT">
        <Button text="✕  Close" onAction="#onClose" styleClass="btn-close"/>
    </HBox>
</VBox>
